        "clause_hJPcNa": {
          "type": "clause",
          "settings": {
            "heading": "Before Wearing",
            "body": "<p>Gently brush the hair using a wide-tooth comb or paddle brush, starting from the ends and working upwards. Avoid pulling on the lace.</p>"
          }
        },
        "clause_Wjt8YM": {
          "type": "clause",
          "settings": {
            "heading": "Washing",
            "body": "<p>Wash your wig every 2 to 4 weeks or as needed using lukewarm water and a sulphate-free shampoo. Follow with a moisturising conditioner, avoiding excessive product on the knots and lace.</p>"
          }
        },
        "clause_G8CiWw": {
          "type": "clause",
          "settings": {
            "heading": "Drying",
            "body": "<p>Pat dry with a towel and allow the wig to air dry on a wig stand where possible. Avoid rubbing the hair vigorously.</p>"
          }
        },
        "clause_6Nfbgj": {
          "type": "clause",
          "settings": {
            "heading": "Heat Styling",
            "body": "<p>Human hair can be heat styled. Always apply a heat protectant first and use the lowest effective temperature to reduce damage.</p>"
          }
        },
        "clause_hi73C7": {
          "type": "clause",
          "settings": {
            "heading": "Storage",
            "body": "<p>Store your wig on a mannequin head, box or in a silk or satin bag, away from direct sunlight, humidity and excessive heat.</p>"
          }
        },
        "clause_VyVWww": {
          "type": "clause",
          "settings": {
            "heading": "Swimming & Holidays",
            "body": "<p>Avoid chlorine and salt water where possible. If exposed, rinse immediately with clean water and deep condition the hair afterwards.</p>"
          }
        },
        "clause_R7gWKi": {
          "type": "clause",
          "settings": {
            "heading": "Colouring & Chemical Treatments",
            "body": "<p>Colouring, bleaching or chemical processing should only be carried out by an experienced professional. These services are undertaken at the customer's own risk and may reduce the lifespan of the hair.</p>"
          }
        },
        "clause_btxwJi": {
          "type": "clause",
          "settings": {
            "heading": "Lace Care",
            "body": "<p>Handle the lace gently. Avoid excessive pulling, scratching or harsh adhesives. Remove adhesive carefully using suitable lace-safe products.</p>"
          }
        },
        "clause_4DqYXc": {
          "type": "clause",
          "settings": {
            "heading": "Product Recommendations",
            "body": "<p>Use sulphate-free shampoo, moisturising conditioner, leave-in conditioner, heat protectant and lightweight hair serum for best results.</p>"
          }
        },
        "clause_hCcTaz": {
          "type": "clause",
          "settings": {
            "heading": "Expected Longevity",
            "body": "<p>With proper care, premium human hair wigs can last 1 to 3 years or longer. Longevity depends on wear frequency, styling, maintenance and storage.</p>"
          }
        }
