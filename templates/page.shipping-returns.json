          "settings": {
            "heading": "Processing Time",
            "body": "<p>Please allow 7 to 15 working days for your order to be made and prepared for dispatch.</p><p>During busy periods, new launches or promotional sales, processing times may be slightly longer. If this happens, we'll keep you informed.</p>"
          }
        },
        "clause_frDznr": {
          "type": "clause",
          "settings": {
            "heading": "Order Amendments & Cancellations",
            "body": "<p>As each wig is custom-made, we allow 24 hours from the time your order is placed for any amendments or cancellations.</p><p>After 24 hours, your order enters production and cannot be changed or cancelled. This includes:</p><ul><li>Hair length</li><li>Lace option (Closure or Frontal)</li><li>Texture</li><li>Cap size</li><li>Colour</li><li>Order cancellations</li></ul>"
          }
        },
        "clause_YmyNHw": {
          "type": "clause",
          "settings": {
            "heading": "",
            "body": "<p>If you've entered the wrong delivery address, please contact us immediately. While we'll do our best to help before dispatch, we cannot guarantee changes once your order has been processed.</p>"
          }
        },
        "clause_6ByaEd": {
          "type": "clause",
