        "clause_9gFjM9": {
          "type": "clause",
          "settings": {
            "heading": "Introduction",
            "body": "<p>This Privacy Policy explains how TheLacedWay collects, uses, stores and protects your personal information when you visit our website, place an order or contact us. We are committed to protecting your privacy and handling your data in accordance with UK GDPR and the Data Protection Act 2018.</p>"
          }
        },
        "clause_ftxnBH": {
          "type": "clause",
          "settings": {
            "heading": "Information We Collect",
            "body": "<p>We may collect your name, billing and delivery address, email address, telephone number, order history, payment confirmations, communications with us, IP address, browser information and website usage data.</p>"
          }
        },
        "clause_UmYLC9": {
          "type": "clause",
          "settings": {
            "heading": "How We Use Your Information",
            "body": "<p>We use your information to process and fulfil orders, provide customer support, personalise your experience, improve our website, prevent fraud, comply with legal obligations and send marketing communications where you have consented.</p>"
          }
        },
        "clause_KgrCdj": {
          "type": "clause",
          "settings": {
            "heading": "Payment Information",
            "body": "<p>Payments are processed securely by trusted third-party providers. TheLacedWay does not store your full card details.</p>"
          }
        },
        "clause_xTtwqU": {
          "type": "clause",
          "settings": {
            "heading": "Marketing",
            "body": "<p>If you opt in, we may send you emails or SMS messages about new collections, launches, offers and updates. You can unsubscribe at any time using the unsubscribe link or by contacting us.</p>"
          }
        },
        "clause_dXGR7H": {
          "type": "clause",
          "settings": {
            "heading": "Cookies",
            "body": "<p>Our website uses cookies and similar technologies to operate the website, remember your preferences, analyse website traffic and improve your shopping experience.</p>"
          }
        },
        "clause_yAwkfB": {
          "type": "clause",
          "settings": {
            "heading": "Sharing Your Information",
            "body": "<p>We only share your information where necessary with trusted service providers such as payment processors, delivery couriers, website hosting providers and professional advisers, or where required by law.</p>"
          }
        },
        "clause_kaBGk7": {
          "type": "clause",
          "settings": {
            "heading": "Data Retention",
            "body": "<p>We keep your personal information only for as long as necessary to fulfil orders, meet legal and tax obligations, resolve disputes and enforce our agreements.</p>"
          }
        },
        "clause_XqjQRe": {
          "type": "clause",
          "settings": {
            "heading": "Your Rights",
            "body": "<p>Subject to applicable law, you may request access to your personal information, ask us to correct inaccurate information, request deletion, restrict processing, object to certain processing or request a copy of your data.</p>"
          }
        },
        "clause_bhwA9e": {
          "type": "clause",
          "settings": {
            "heading": "Security",
            "body": "<p>We take reasonable technical and organisational measures to protect your personal information. However, no method of electronic storage or internet transmission can be guaranteed to be completely secure.</p>"
          }
        },
        "clause_cdnJX8": {
          "type": "clause",
          "settings": {
            "heading": "Third-Party Links",
            "body": "<p>Our website may contain links to third-party websites. We are not responsible for their privacy practices or content.</p>"
          }
        },
        "clause_rkJnpW": {
