{% comment %}
  THELACEDWÁY hero
  Home of Amare Studio

  One full-bleed video. The three-panel look is in the footage itself, not the
  layout, so there is nothing to compose here.

  Separate desktop and mobile videos are supported because the crops differ.
  Only the one in view downloads, so a phone never pulls the wide file.

  Videos go in Content > Files first, then get picked here. mp4 only, since
  Chrome and Firefox will not play .mov.
{% endcomment %}

{%- liquid
  assign desktop = section.settings.video_desktop
  assign mobile = section.settings.video_mobile
  if mobile == blank
    assign mobile = desktop
  endif
-%}

<section class="tlw-hero" id="tlw-hero-{{ section.id }}">

  <div class="tlw-hero__media">

    {%- if desktop != blank -%}
      <video
        class="tlw-hero__video tlw-hero__video--desktop"
        data-hero-video
        muted
        loop
        playsinline
        preload="none"
        {% if section.settings.poster != blank %}
          poster="{{ section.settings.poster | image_url: width: 1600 }}"
        {% elsif desktop.preview_image %}
          poster="{{ desktop.preview_image | image_url: width: 1600 }}"
        {% endif %}
      >
        {%- for source in desktop.sources -%}
          {%- if source.format == 'mp4' -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>

      <video
        class="tlw-hero__video tlw-hero__video--mobile"
        data-hero-video
        muted
        loop
        playsinline
        preload="none"
        {% if section.settings.poster_mobile != blank %}
          poster="{{ section.settings.poster_mobile | image_url: width: 900 }}"
        {% elsif mobile.preview_image %}
          poster="{{ mobile.preview_image | image_url: width: 900 }}"
        {% endif %}
      >
        {%- for source in mobile.sources -%}
          {%- if source.format == 'mp4' -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>

    {%- elsif section.settings.poster != blank -%}
      {{ section.settings.poster
        | image_url: width: 1800
        | image_tag: loading: 'eager', alt: '', class: 'tlw-hero__video'
      }}

    {%- else -%}
      <div class="tlw-hero__video tlw-hero__video--empty"></div>
    {%- endif -%}

  </div>

  {%- if section.settings.overlay > 0 -%}
    <div class="tlw-hero__scrim"></div>
  {%- endif -%}

  <div class="tlw-hero__content">

    {%- if section.settings.logo != blank -%}
      <div class="tlw-hero__logo">
        {{ section.settings.logo
          | image_url: width: 700
          | image_tag: loading: 'eager', alt: shop.name
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="tlw-hero__cta"
        href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

    {%- if section.settings.scroll_label != blank -%}
      <button type="button" class="tlw-hero__scroll" data-hero-scroll>
        <span class="tlw-label-caps">{{ section.settings.scroll_label }}</span>
        <svg viewBox="0 0 24 14" width="30" height="17" aria-hidden="true">
          <path d="M1 1l11 11L23 1" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
    {%- endif -%}

  </div>
</section>

<style>
  #tlw-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: calc(100svh - var(--header-height, 96px));
    min-height: 520px;
    overflow: hidden;
    background: var(--tlw-primary);
  }

  #tlw-hero-{{ section.id }} .tlw-hero__media,
  #tlw-hero-{{ section.id }} .tlw-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__video {
    object-fit: cover;
    object-position: {{ section.settings.focal }};
    display: block;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__video--empty {
    background: var(--tlw-surface-variant);
  }

  #tlw-hero-{{ section.id }} .tlw-hero__video--desktop { display: none; }
  #tlw-hero-{{ section.id }} .tlw-hero__video--mobile  { display: block; }

  @media (min-width: 750px) {
    #tlw-hero-{{ section.id }} .tlw-hero__video--desktop { display: block; }
    #tlw-hero-{{ section.id }} .tlw-hero__video--mobile  { display: none; }
  }

  #tlw-hero-{{ section.id }} .tlw-hero__scrim {
    position: absolute;
    inset: 0;
    background: var(--tlw-scrim);
    opacity: {{ section.settings.overlay | divided_by: 100.0 }};
    pointer-events: none;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px var(--tlw-margin);
    color: #fff;
    pointer-events: none;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__logo {
    width: min(52vw, 340px);
    margin-top: 4vh;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__logo img {
    width: 100%;
    height: auto;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__cta {
    pointer-events: auto;
    margin-top: auto;
    margin-bottom: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 38px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: var(--tlw-radius);
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    transition: background-color 400ms ease, color 400ms ease;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__cta:hover {
    background: #fff;
    color: var(--tlw-primary);
  }

  @media (min-width: 900px) {
    #tlw-hero-{{ section.id }} .tlw-hero__content {
      align-items: {{ section.settings.cta_align }};
    }
    #tlw-hero-{{ section.id }} .tlw-hero__logo {
      align-self: center;
    }
  }

  #tlw-hero-{{ section.id }} .tlw-hero__scroll {
    pointer-events: auto;
    align-self: center;
    background: none;
    border: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.9);
  }

  #tlw-hero-{{ section.id }} .tlw-hero__scroll svg {
    animation: tlw-hero-nudge 2.4s ease-in-out infinite;
  }

  @keyframes tlw-hero-nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%      { transform: translateY(5px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #tlw-hero-{{ section.id }} .tlw-hero__scroll svg { animation: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-hero-{{ section.id }}');
    if (!root) return;

    /* Only play the video that is actually on screen, so a phone never
       downloads the wide desktop file. */
    function playVisible() {
      root.querySelectorAll('[data-hero-video]').forEach(function (v) {
        var shown = v.offsetParent !== null;
        if (shown) {
          v.preload = 'auto';
          v.muted = true;
          var go = v.play();
          if (go && go.catch) go.catch(function () {});
        } else {
          v.pause();
        }
      });
    }

    playVisible();
    window.addEventListener('resize', playVisible);

    var cue = root.querySelector('[data-hero-scroll]');
    if (cue) {
      cue.addEventListener('click', function () {
        var next = root.parentElement.nextElementSibling || root.nextElementSibling;
        if (next) {
          next.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          window.scrollBy({ top: window.innerHeight, behavior: 'smooth' });
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "TLW Hero",
  "tag": "section",
  "settings": [
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Video",
      "info": "Upload to Content > Files first. Must be mp4, not .mov."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video",
      "info": "Optional. The taller crop for phones. Falls back to the main video."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Still image",
      "info": "Shows while the video loads, and instead of it if no video is set"
    },
    {
      "type": "image_picker",
      "id": "poster_mobile",
      "label": "Mobile still image"
    },
    {
      "type": "select",
      "id": "focal",
      "label": "What to keep in frame",
      "info": "Which part of the footage stays visible when it gets cropped",
      "options": [
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Middle" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use the white version"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop the collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button goes to"
    },
    {
      "type": "select",
      "id": "cta_align",
      "label": "Button position on desktop",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Scroll cue text",
      "info": "The word above the arrow. Leave empty to hide it.",
      "default": "Welcome"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken the video",
      "info": "Helps the logo and button stay readable",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 25
    }
  ],
  "presets": [{ "name": "TLW Hero" }]
}
{% endschema %}
