{% comment %}
  THELACEDWÁY hero
  Home of Amare Studio

  Three media panels side by side on desktop, one on mobile. Each panel takes
  either a video or an image. Video wins if both are set.

  Videos need uploading to Shopify first: Content > Files, then pick them here.
  Anything still in .mov needs converting to mp4, since Chrome and Firefox
  will not play QuickTime.
{% endcomment %}

<section
  class="tlw-hero"
  id="tlw-hero-{{ section.id }}"
>
  <div class="tlw-hero__panels">
    {%- for block in section.blocks -%}
      {%- if block.type == 'panel' -%}
        <div
          class="tlw-hero__panel"
          {% if forloop.index > 1 %}data-desktop-only{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.video != blank -%}
            {{ block.settings.video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                image_size: '1200x',
                class: 'tlw-hero__media'
            }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                alt: '',
                class: 'tlw-hero__media'
            }}
          {%- else -%}
            <div class="tlw-hero__media tlw-hero__media--empty"></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.overlay > 0 -%}
    <div class="tlw-hero__scrim"></div>
  {%- endif -%}

  <div class="tlw-hero__content">

    {%- if section.settings.logo != blank -%}
      <div class="tlw-hero__logo">
        {{ section.settings.logo
          | image_url: width: 700
          | image_tag: loading: 'eager', alt: shop.name
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a
        class="tlw-hero__cta"
        href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}

    {%- if section.settings.scroll_label != blank -%}
      <button type="button" class="tlw-hero__scroll" data-hero-scroll>
        <span class="tlw-label-caps">{{ section.settings.scroll_label }}</span>
        <svg viewBox="0 0 24 14" width="30" height="17" aria-hidden="true">
          <path d="M1 1l11 11L23 1" fill="none" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>
    {%- endif -%}

  </div>
</section>

<style>
  #tlw-hero-{{ section.id }} {
    position: relative;
    width: 100%;
    height: calc(100svh - var(--header-height, 96px));
    min-height: 520px;
    overflow: hidden;
    background: var(--tlw-primary);
  }

  #tlw-hero-{{ section.id }} .tlw-hero__panels {
    display: grid;
    grid-template-columns: 1fr;
    height: 100%;
    gap: {{ section.settings.gap }}px;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__panel {
    position: relative;
    overflow: hidden;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__panel[data-desktop-only] {
    display: none;
  }

  @media (min-width: 900px) {
    #tlw-hero-{{ section.id }} .tlw-hero__panels {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    }
    #tlw-hero-{{ section.id }} .tlw-hero__panel[data-desktop-only] {
      display: block;
    }
  }

  #tlw-hero-{{ section.id }} .tlw-hero__media,
  #tlw-hero-{{ section.id }} .tlw-hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__media--empty {
    background: var(--tlw-surface-variant);
  }

  #tlw-hero-{{ section.id }} .tlw-hero__scrim {
    position: absolute;
    inset: 0;
    background: var(--tlw-scrim);
    opacity: {{ section.settings.overlay | divided_by: 100.0 }};
    pointer-events: none;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px var(--tlw-margin);
    color: #fff;
    pointer-events: none;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__logo {
    width: min(46vw, 320px);
    margin-top: 4vh;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__logo img {
    width: 100%;
    height: auto;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__cta {
    pointer-events: auto;
    margin-top: auto;
    margin-bottom: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 38px;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: var(--tlw-radius);
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    transition: background-color 400ms ease, color 400ms ease;
  }

  #tlw-hero-{{ section.id }} .tlw-hero__cta:hover {
    background: #fff;
    color: var(--tlw-primary);
  }

  @media (min-width: 900px) {
    #tlw-hero-{{ section.id }} .tlw-hero__content {
      align-items: flex-start;
    }
    #tlw-hero-{{ section.id }} .tlw-hero__logo {
      align-self: center;
    }
    #tlw-hero-{{ section.id }} .tlw-hero__cta {
      margin-left: 4vw;
    }
  }

  #tlw-hero-{{ section.id }} .tlw-hero__scroll {
    pointer-events: auto;
    align-self: center;
    background: none;
    border: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.9);
  }

  #tlw-hero-{{ section.id }} .tlw-hero__scroll svg {
    animation: tlw-hero-nudge 2.4s ease-in-out infinite;
  }

  @keyframes tlw-hero-nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50%      { transform: translateY(5px); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #tlw-hero-{{ section.id }} .tlw-hero__scroll svg { animation: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-hero-{{ section.id }}');
    if (!root) return;

    var cue = root.querySelector('[data-hero-scroll]');
    if (cue) {
      cue.addEventListener('click', function () {
        var next = root.parentElement.nextElementSibling || root.nextElementSibling;
        if (next) {
          next.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
          window.scrollBy({ top: window.innerHeight, behavior: 'smooth' });
        }
      });
    }

    /* Some browsers block autoplay until the video is in view. Nudge them. */
    root.querySelectorAll('video').forEach(function (v) {
      v.muted = true;
      v.setAttribute('playsinline', '');
      var attempt = v.play();
      if (attempt && attempt.catch) attempt.catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "TLW Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use the white version. Sits over the middle panel."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop the collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button goes to"
    },
    {
      "type": "text",
      "id": "scroll_label",
      "label": "Scroll cue text",
      "info": "The word above the arrow at the bottom. Leave empty to hide it.",
      "default": "Welcome"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken the panels",
      "info": "Helps the logo and button stay readable over busy footage",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between panels",
      "min": 0,
      "max": 12,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "limit": 4,
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload to Content > Files first. Must be mp4, not .mov."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image instead",
          "info": "Used only if no video is set"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TLW Hero",
      "blocks": [
        { "type": "panel" },
        { "type": "panel" },
        { "type": "panel" }
      ]
    }
  ]
}
{% endschema %}
