{% comment %}
  THELACEDWÁY product reviews
  Home of Amare Studio

  Shows the Judge.me reviews for the product being viewed, with Judge.me's own
  "Write a review" form, under a heading and gold rating line that match the site.

  Needs the Judge.me app installed, with its "Judge.me Core" app embed switched on
  (theme editor > App embeds). Reviews are matched to this product automatically.
{% endcomment %}

{%- liquid
  assign rating_obj = product.metafields.reviews.rating.value
  assign review_count = product.metafields.reviews.rating_count.value | default: 0
  assign rating_num = rating_obj.rating
  assign rating_max = rating_obj.scale_max | default: 5
  assign heading_text = section.settings.heading | default: 'What clients say' | replace: '{product}', product.title
-%}

<section class="tlw-prev" id="tlw-reviews-{{ section.id }}">
  <span id="tlw-reviews" class="tlw-prev__anchor"></span>
  <div class="tlw-prev__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tlw-prev__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h2 class="tlw-prev__title">{{ heading_text | escape }}</h2>

    {%- if section.settings.show_summary and rating_num != blank and review_count > 0 -%}
      <p class="tlw-prev__summary">
        {%- render 'tlw-stars', rating: rating_num, max: rating_max, size: 18 -%}
        <span>{{ rating_num | times: 1.0 | round: 1 }} average &middot; {{ review_count }} {% if review_count == 1 %}review{% else %}reviews{% endif %}</span>
      </p>
    {%- endif -%}

    {%- if section.settings.show_widget -%}
      <div class="tlw-prev__widget">
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}" data-handle="{{ product.handle }}"></div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="tlw-prev__app" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  #tlw-reviews-{{ section.id }} {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 96px var(--tlw-margin, 24px);
  }

  #tlw-reviews-{{ section.id }} .tlw-prev__anchor {
    display: block;
    position: relative;
    top: -96px;
    visibility: hidden;
  }

  #tlw-reviews-{{ section.id }} .tlw-prev__inner {
    max-width: 1024px;
  }

  #tlw-reviews-{{ section.id }} .tlw-prev__eyebrow {
    margin: 0 0 16px;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-reviews-{{ section.id }} .tlw-prev__title {
    margin: 0;
    font-family: var(--tlw-font-display);
    font-size: clamp(32px, 5.4vw, 64px);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--tlw-primary);
  }

  #tlw-reviews-{{ section.id }} .tlw-prev__summary {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 20px 0 0;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }

  #tlw-reviews-{{ section.id }} .tlw-prev__widget,
  #tlw-reviews-{{ section.id }} .tlw-prev__app {
    margin-top: 48px;
  }

  /* ---- skin Judge.me's widget so it matches the rest of the site ---- */
  #tlw-reviews-{{ section.id }} .tlw-prev__widget {
    --jdgm-primary-color: var(--tlw-accent);
    --jdgm-star-color: var(--tlw-accent);
    --jdgm-secondary-color: rgba(166, 139, 63, 0.1);
    --jdgm-write-review-text-color: var(--tlw-primary);
    --jdgm-write-review-bg-color: transparent;
    --jdgm-paginate-color: var(--tlw-accent);
    --jdgm-border-radius: 0;
    font-family: var(--tlw-font-body);
    color: var(--tlw-primary);
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev-widg__title {
    display: none;
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev-widg__reviews {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 768px) {
    #tlw-reviews-{{ section.id }} .jdgm-rev-widg__reviews {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev {
    margin: 0;
    padding: 28px;
    border: 1px solid var(--tlw-outline-variant);
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev__title {
    font-family: var(--tlw-font-display);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--tlw-primary);
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev__body {
    font-family: var(--tlw-font-body);
    font-weight: 300;
    line-height: 1.7;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev__author {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tlw-primary);
  }

  #tlw-reviews-{{ section.id }} .jdgm-rev__timestamp {
    font-size: 12px;
    font-weight: 300;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-reviews-{{ section.id }} .jdgm-write-rev-link,
  #tlw-reviews-{{ section.id }} .jdgm-btn {
    border: 1px solid var(--tlw-primary);
    border-radius: 0;
    background: transparent;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-reviews-{{ section.id }} .jdgm-write-rev-link:hover,
  #tlw-reviews-{{ section.id }} .jdgm-btn:hover {
    background: var(--tlw-primary);
    color: var(--tlw-on-primary, #fff);
  }
</style>

{% schema %}
{
  "name": "TLW Product reviews",
  "tag": "div",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above the heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Type {product} to include the product's name.",
      "default": "What clients say"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show the gold star rating line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_widget",
      "label": "Show the Judge.me reviews and Write a review button",
      "info": "Turn off only if you add Judge.me's own block below instead, to avoid showing reviews twice.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Reviews: Wigs",
      "settings": {
        "eyebrow": "Reviews",
        "heading": "What clients say about our wigs"
      }
    },
    {
      "name": "Reviews: Lace Systems",
      "settings": {
        "eyebrow": "Reviews",
        "heading": "What clients say about our lace systems"
      }
    },
    {
      "name": "Reviews: Bundles",
      "settings": {
        "eyebrow": "Reviews",
        "heading": "What clients say about our bundles"
      }
    }
  ]
}
{% endschema %}
