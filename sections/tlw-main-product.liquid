<script>
  (function () {
    var root = document.getElementById('tlw-product-{{ section.id }}');

    if (!root) return;

    var form = root.querySelector('[data-product-form]');
    var variants = JSON.parse(root.querySelector('[data-variant-json]').textContent);
    var variantInput = root.querySelector('[data-variant-id]');
    var priceEl = root.querySelector('[data-price]');
    var totalEl = root.querySelector('[data-running-total]');
    var button = root.querySelector('[data-add-to-cart]');
    var buttonText = root.querySelector('[data-button-text]');
    var errorEl = root.querySelector('[data-cart-error]');
    var moneyFormat = {{ shop.money_format | json }};

    function formatMoney(cents) {
      var amount = (cents / 100).toFixed(2);
      return moneyFormat.replace(/\{\{\s*amount\s*\}\}/, amount);
    }

    /* ---- work out which variant the chosen options map to ---- */
    function currentVariant() {
      var selects = root.querySelectorAll('[data-variant-option]');
      if (!selects.length) return variants[0];

      var chosen = [];
      selects.forEach(function (s) {
        chosen[parseInt(s.dataset.optionIndex, 10)] = s.value;
      });

      return variants.find(function (v) {
        return chosen.every(function (val, i) {
          return v.options[i] === val;
        });
      }) || null;
    }

    /* ---- add up base variant plus any triggered add-ons ---- */
    function runningTotal(variant) {
      var total = variant ? variant.price : 0;
      root.querySelectorAll('[data-service-option]').forEach(function (s) {
        var trigger = s.dataset.triggerValue;
        var price = s.dataset.addonPrice;
        if (trigger && price && s.value === trigger) {
          total += parseInt(price, 10);
        }
      });
      return total;
    }

    function refresh() {
      var variant = currentVariant();

      if (!variant) {
        button.disabled = true;
        buttonText.textContent = 'Unavailable';
        return;
      }

      variantInput.value = variant.id;
      priceEl.textContent = formatMoney(variant.price);
      totalEl.textContent = formatMoney(runningTotal(variant));

      button.disabled = !variant.available;
      buttonText.textContent = variant.available
        ? {{ section.settings.button_label | default: 'Add to bag' | json }}
        : 'Sold out';
    }

    root.addEventListener('change', function (e) {
      if (e.target.matches('[data-variant-option], [data-service-option]')) refresh();
    });

    /* ---- gallery ---- */
    var mainImg = root.querySelector('[data-main-image] img');
    root.querySelectorAll('[data-thumb]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (mainImg) mainImg.src = thumb.dataset.full;
        root.querySelectorAll('[data-thumb]').forEach(function (t) {
          t.classList.remove('is-active');
        });
        thumb.classList.add('is-active');
      });
    });

    /* ---- add to cart ---- */
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      var variant = currentVariant();
      if (!variant) return;

      var productTitle = form.dataset.productTitle;
      var properties = {};
      var addons = [];

      root.querySelectorAll('[data-service-option]').forEach(function (s) {
        /* every service choice is recorded on the main line so the order
           shows exactly what was picked, paid or not */
        properties[s.dataset.propertyName] = s.value;

        var trigger = s.dataset.triggerValue;
        var addonId = s.dataset.addonVariantId;
        if (trigger && addonId && s.value === trigger) {
          addons.push({
            id: parseInt(addonId, 10),
            quantity: 1,
            properties: { 'Add-on for': productTitle }
          });
        }
      });

      var items = [{ id: variant.id, quantity: 1, properties: properties }].concat(addons);

      buttonText.textContent = 'Adding...';
      button.disabled = true;

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) {
          if (!res.ok) return res.json().then(function (d) { throw new Error(d.description || 'Could not add to bag'); });
          return res.json();
        })
        .then(function () {
          /* let Horizon's cart drawer know something changed */
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          window.location.href = '{{ routes.cart_url }}';
        })
        .catch(function (err) {
          errorEl.textContent = err.message;
          errorEl.hidden = false;
        })
        .finally(function () {
          button.disabled = false;
          refresh();
        });
    });

    refresh();

    /* ---- accordions ---- */
    root.querySelectorAll('[data-accordion]').forEach(function (acc) {
      var trigger = acc.querySelector('[data-accordion-trigger]');
      trigger.addEventListener('click', function () {
        var isOpen = acc.classList.contains('is-open');
        acc.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    /* ---- custom dropdowns ----
       Each wraps a real (but hidden) <select> that stays the single source
       of truth: clicking a custom option updates the hidden select's value
       and dispatches a real 'change' event, so all the cart/price logic
       above keeps working exactly as it did against a native select. */
    var allDropdowns = Array.prototype.slice.call(root.querySelectorAll('[data-dropdown]'));

    function closeDropdown(dd) {
      dd.classList.remove('is-open');
      var trigger = dd.querySelector('[data-dropdown-trigger]');
      var panel = dd.querySelector('[data-dropdown-panel]');
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    }

    function openDropdown(dd) {
      allDropdowns.forEach(function (other) {
        if (other !== dd) closeDropdown(other);
      });
      dd.classList.add('is-open');
      var trigger = dd.querySelector('[data-dropdown-trigger]');
      var panel = dd.querySelector('[data-dropdown-panel]');
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    }

    function selectOption(dd, li) {
      if (li.classList.contains('is-disabled')) return;
      var value = li.dataset.value;
      var select = dd.querySelector('[data-dropdown-store]');
      var valueEl = dd.querySelector('[data-dropdown-value]');

      select.value = value;
      valueEl.textContent = value;
      valueEl.classList.remove('tlw-dropdown__placeholder');

      dd.querySelectorAll('[data-dropdown-option]').forEach(function (opt) {
        opt.classList.toggle('is-selected', opt === li);
      });

      dd.classList.remove('is-invalid');
      closeDropdown(dd);

      var event = document.createEvent('HTMLEvents');
      event.initEvent('change', true, true);
      select.dispatchEvent(event);
    }

    allDropdowns.forEach(function (dd) {
      var trigger = dd.querySelector('[data-dropdown-trigger]');
      var panel = dd.querySelector('[data-dropdown-panel]');
      var options = Array.prototype.slice.call(dd.querySelectorAll('[data-dropdown-option]'));

      trigger.addEventListener('click', function () {
        if (dd.classList.contains('is-open')) closeDropdown(dd);
        else openDropdown(dd);
      });

      options.forEach(function (li) {
        li.querySelector('.tlw-dropdown__option').addEventListener('click', function () {
          selectOption(dd, li);
        });
      });

      trigger.addEventListener('keydown', function (e) {
        var activeIndex = options.findIndex(function (o) { return o.classList.contains('is-active'); });
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!dd.classList.contains('is-open')) {
            openDropdown(dd);
            return;
          }
          var dir = e.key === 'ArrowDown' ? 1 : -1;
          var next = Math.min(options.length - 1, Math.max(0, activeIndex + dir));
          options.forEach(function (o, i) { o.classList.toggle('is-active', i === next); });
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (!dd.classList.contains('is-open')) {
            openDropdown(dd);
          } else if (activeIndex > -1) {
            selectOption(dd, options[activeIndex]);
          }
        } else if (e.key === 'Escape') {
          closeDropdown(dd);
        }
      });
    });

    document.addEventListener('click', function (e) {
      allDropdowns.forEach(function (dd) {
        if (!dd.contains(e.target)) closeDropdown(dd);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') allDropdowns.forEach(closeDropdown);
    });

    /* ---- keep variant dropdown options in sync with what's actually
       selected, and grey out combinations with no matching variant ---- */
    function syncVariantDropdowns() {
      var variantSelects = Array.prototype.slice.call(root.querySelectorAll('[data-variant-option]'));
      if (!variantSelects.length) return;

      var chosen = variantSelects.map(function (s) { return s.value; });

      variantSelects.forEach(function (select) {
        var index = parseInt(select.dataset.optionIndex, 10);
        var dd = select.closest('[data-dropdown]');

        dd.querySelectorAll('[data-dropdown-option]').forEach(function (li) {
          var testValues = chosen.slice();
          testValues[index] = li.dataset.value;

          var available = variants.some(function (v) {
            return testValues.every(function (val, i) { return v.options[i] === val; }) && v.available;
          });

          li.classList.toggle('is-disabled', !available);
          var note = li.querySelector('[data-sold-out-label]');
          if (note) note.hidden = available;
        });
      });
    }

    root.addEventListener('change', function (e) {
      if (e.target.matches('[data-variant-option]')) syncVariantDropdowns();
    });

    syncVariantDropdowns();
  })();
</script>

