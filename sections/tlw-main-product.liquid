{% comment %}
  THELACEDWÁY main product section
  Home of Amare Studio

  Handles two kinds of purchase:
  1. Real Shopify variants (Lace Size, Length, Lace type) which carry the price.
  2. Service options, which are either free line item properties, or paid
     add-ons that get added to the cart as their own separate line.

  Paid add-ons MUST be separate cart lines. Line item properties are display
  only and carry no price.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section
  class="tlw-product tlw-container"
  id="tlw-product-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="tlw-product__grid">

    {% comment %} ---------- GALLERY ---------- {% endcomment %}
    <div class="tlw-product__media">
      {%- if product.media.size > 0 -%}
        <div class="tlw-product__main-image" data-main-image>
          {{ product.featured_media
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              sizes: '(min-width: 900px) 50vw, 100vw',
              widths: '400, 600, 900, 1200, 1400',
              alt: product.title
          }}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="tlw-product__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="tlw-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-thumb
                data-full="{{ media | image_url: width: 1400 }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="tlw-product__placeholder">
          <span class="tlw-label-caps">Image coming soon</span>
        </div>
      {%- endif -%}
    </div>

    {% comment %} ---------- DETAILS ---------- {% endcomment %}
    <div class="tlw-product__info">

      {%- if section.settings.show_collection_label and product.collections.size > 0 -%}
        <p class="tlw-label-caps tlw-product__eyebrow">
          {{ product.collections.first.title }}
        </p>
      {%- endif -%}

      <h1 class="tlw-display-lg tlw-product__title">{{ product.title }}</h1>

      {%- if section.settings.detail_line != blank -%}
        <p class="tlw-body-md tlw-product__detail">{{ section.settings.detail_line }}</p>
      {%- endif -%}

      <p class="tlw-product__price" data-price>
        {{ current_variant.price | money }}
      </p>

      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        id="tlw-form-{{ section.id }}"
        data-product-form
        data-product-title="{{ product.title | escape }}"
      >

        {%- liquid
          assign hair_type_value = ''
          assign lifespan_value = ''
          assign chunks = ''
          if product.description != blank
            assign raw = product.description
            assign raw = raw | replace: '​', '' | replace: '‌', '' | replace: '‍', '' | replace: '⁠', '' | replace: '﻿', '' | replace: '­', '' | replace: '᠎', '' | replace: '⁡', '' | replace: '⁢', '' | replace: '⁣', '' | replace: '⁤', '' | replace: ' ', ' '
            assign raw = raw | replace: '</p>', '|||' | replace: '<br>', '|||' | replace: '<br />', '|||' | replace: '<br/>', '|||' | replace: '</li>', '|||'
            assign raw = raw | strip_html | strip_newlines
            assign raw = raw | replace: '•', '|||' | replace: '·', '|||' | replace: '‣', '|||' | replace: '▪', '|||'
            assign raw = raw | replace: '：', ':' | replace: '﹕', ':' | replace: '︰', ':'
            assign chunks = raw | split: '|||'
          endif
        -%}

        {%- if section.settings.unit_details_mode -%}

          {% comment %}
            ---------- READY TO SHIP: fixed unit details card ----------
            No selectable options at all — the unit is already made. Just
            the parsed spec list shown as plain read-only lines.
          {% endcomment %}
          {%- if chunks != '' -%}
            <div class="tlw-product__unit-card">
              <p class="tlw-label-caps tlw-product__unit-heading">Unit Details</p>
              {%- for chunk in chunks -%}
                {%- assign clean_chunk = chunk | strip -%}
                {%- if clean_chunk == blank -%}
                  {%- continue -%}
                {%- endif -%}

                {%- assign parts = clean_chunk | split: ':' -%}
                {%- assign label_candidate = parts[0] | strip -%}
                {%- assign value_candidate = clean_chunk | remove_first: label_candidate | remove_first: ':' | strip -%}

                {%- if parts.size > 1 and label_candidate.size <= 25 and value_candidate != blank -%}
                  {%- assign words = label_candidate | downcase | split: ' ' -%}
                  {%- assign title_label = '' -%}
                  {%- for word in words -%}
                    {%- assign capped_word = word | capitalize -%}
                    {%- assign title_label = title_label | append: capped_word | append: ' ' -%}
                  {%- endfor -%}
                  {%- assign title_label = title_label | strip -%}

                  {%- if title_label == 'Hair Type' -%}
                    {%- assign hair_type_value = value_candidate -%}
                  {%- endif -%}
                  {%- if title_label contains 'Lifespan' -%}
                    {%- assign lifespan_value = value_candidate -%}
                  {%- endif -%}

                  <p class="tlw-body-md tlw-product__unit-line">{{ title_label }}: {{ value_candidate }}</p>
                {%- else -%}
                  <p class="tlw-body-md tlw-product__unit-line">{{ clean_chunk }}</p>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        {%- else -%}

        {% comment %} ---------- REAL VARIANTS ---------- {% endcomment %}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="tlw-field">
              <label class="tlw-label-caps tlw-field__label" id="tlw-opt-label-{{ section.id }}-{{ forloop.index }}">
                {{ option.name }}
              </label>

              <div
                class="tlw-dropdown"
                data-dropdown
                data-dropdown-id="variant-{{ forloop.index }}"
              >
                <select
                  class="tlw-select tlw-visually-hidden"
                  id="tlw-opt-{{ section.id }}-{{ forloop.index }}"
                  data-option-index="{{ forloop.index0 }}"
                  data-variant-option
                  data-dropdown-store
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- for value in option.values -%}
                    <option
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}selected{% endif %}
                    >
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>

                <button
                  type="button"
                  class="tlw-dropdown__trigger"
                  data-dropdown-trigger
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="tlw-opt-label-{{ section.id }}-{{ forloop.index }} tlw-opt-{{ section.id }}-{{ forloop.index }}-value"
                >
                  <span data-dropdown-value id="tlw-opt-{{ section.id }}-{{ forloop.index }}-value" class="tlw-dropdown__placeholder">
                    Select {{ option.name | downcase }}...
                  </span>
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" class="tlw-dropdown__chevron">
                    <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <ul class="tlw-dropdown__panel" data-dropdown-panel role="listbox" aria-label="{{ option.name }}" hidden>
                  {%- for value in option.values -%}
                    <li role="option" data-dropdown-option data-value="{{ value | escape }}">
                      <button type="button" class="tlw-dropdown__option">
                        <span>{{ value }}</span>
                        <span class="tlw-dropdown__option-note" data-sold-out-label hidden>(Sold out)</span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              {%- assign option_downcase = option.name | downcase -%}
              {%- if option_downcase contains 'cap size' -%}
                {%- assign measure_guide_id = 'variant-' | append: forloop.index -%}
                <p class="tlw-field__help">
                  {%- render 'tlw-measure-guide', id: measure_guide_id -%}
                </p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {% comment %}
          ---------- SERVICE OPTIONS ----------
          Each block is one dropdown. Up to 3 of its choices can each carry
          their own add-on product and price — most options only use the
          first slot, but a few (like Layers) need two or three different
          prices for different choices.
        {% endcomment %}
        {%- for block in section.blocks -%}
          {%- if block.type == 'service_option' -%}
            {%- assign values = block.settings.values | split: ',' -%}

            {%- comment %} Build the list of paid choices for this option, skipping any slot that's incomplete. {%- endcomment %}
            {%- assign addon_pairs = '' -%}

            {%- assign addon_1 = block.settings.addon_product -%}
            {%- if block.settings.trigger_value != blank and addon_1 != blank -%}
              {%- assign pair = block.settings.trigger_value | strip | append: '::' | append: addon_1.selected_or_first_available_variant.id | append: '::' | append: addon_1.price -%}
              {%- assign addon_pairs = addon_pairs | append: pair | append: '||' -%}
            {%- endif -%}

            {%- assign addon_2 = block.settings.addon_product_2 -%}
            {%- if block.settings.trigger_value_2 != blank and addon_2 != blank -%}
              {%- assign pair = block.settings.trigger_value_2 | strip | append: '::' | append: addon_2.selected_or_first_available_variant.id | append: '::' | append: addon_2.price -%}
              {%- assign addon_pairs = addon_pairs | append: pair | append: '||' -%}
            {%- endif -%}

            {%- assign addon_3 = block.settings.addon_product_3 -%}
            {%- if block.settings.trigger_value_3 != blank and addon_3 != blank -%}
              {%- assign pair = block.settings.trigger_value_3 | strip | append: '::' | append: addon_3.selected_or_first_available_variant.id | append: '::' | append: addon_3.price -%}
              {%- assign addon_pairs = addon_pairs | append: pair | append: '||' -%}
            {%- endif -%}

            {%- assign addon_4 = block.settings.addon_product_4 -%}
            {%- if block.settings.trigger_value_4 != blank and addon_4 != blank -%}
              {%- assign pair = block.settings.trigger_value_4 | strip | append: '::' | append: addon_4.selected_or_first_available_variant.id | append: '::' | append: addon_4.price -%}
              {%- assign addon_pairs = addon_pairs | append: pair | append: '||' -%}
            {%- endif -%}

            {%- assign block_label_downcase = block.settings.label | downcase -%}
            {%- assign is_reveal_child = false -%}
            {%- if block_label_downcase == 'hairline' or block_label_downcase == 'styled' or block_label_downcase == 'layers' -%}
              {%- assign is_reveal_child = true -%}
            {%- endif -%}

            <div
              class="tlw-field{% if is_reveal_child %} tlw-field--reveal{% endif %}"
              {{ block.shopify_attributes }}
              data-field-label="{{ block_label_downcase }}"
              {% if is_reveal_child %}data-customisation-reveal hidden{% endif %}
            >
              <label class="tlw-label-caps tlw-field__label" id="tlw-svc-label-{{ block.id }}">
                <span>
                  {{ block.settings.label }}
                  {%- assign label_downcase = block.settings.label | downcase -%}
                  {%- if label_downcase contains 'hairline' -%}
                    {%- render 'tlw-hairline-guide', id: block.id -%}
                  {%- endif -%}
                  {%- assign tip_text = block.settings.tooltip -%}
                  {%- if tip_text == blank and label_downcase contains 'jet black' -%}
                    {%- assign tip_text = 'Dyed from natural black to a custom-dyed deep black finish for a bolder look.' -%}
                  {%- endif -%}
                  {%- if tip_text != blank -%}
                    <span class="tlw-tip" tabindex="0" role="button" aria-label="{{ tip_text | escape }}">
                      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
                      <span class="tlw-tip__bubble" role="tooltip">{{ tip_text | escape }}</span>
                    </span>
                  {%- endif -%}
                </span>
              </label>

              <div class="tlw-dropdown" data-dropdown data-dropdown-id="svc-{{ block.id }}">
                <select
                  class="tlw-select tlw-visually-hidden"
                  id="tlw-svc-{{ block.id }}"
                  data-service-option
                  data-property-name="{{ block.settings.label | escape }}"
                  data-addon-pairs="{{ addon_pairs | escape }}"
                  data-dropdown-store
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- for value in values -%}
                    {%- assign clean = value | strip -%}
                    <option value="{{ clean | escape }}">{{ clean }}</option>
                  {%- endfor -%}
                </select>


                <button
                  type="button"
                  class="tlw-dropdown__trigger"
                  data-dropdown-trigger
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="tlw-svc-label-{{ block.id }} tlw-svc-{{ block.id }}-value"
                >
                  <span data-dropdown-value id="tlw-svc-{{ block.id }}-value" class="tlw-dropdown__placeholder">
                    Select {{ block.settings.label | downcase }}...
                  </span>
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" class="tlw-dropdown__chevron">
                    <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <ul class="tlw-dropdown__panel" data-dropdown-panel role="listbox" aria-label="{{ block.settings.label }}" hidden>
                  {%- for value in values -%}
                    {%- assign clean = value | strip -%}
                    {%- assign option_price = blank -%}
                    {%- if clean == block.settings.trigger_value and addon_1 != blank -%}
                      {%- assign option_price = addon_1.price -%}
                    {%- elsif clean == block.settings.trigger_value_2 and addon_2 != blank -%}
                      {%- assign option_price = addon_2.price -%}
                    {%- elsif clean == block.settings.trigger_value_3 and addon_3 != blank -%}
                      {%- assign option_price = addon_3.price -%}
                    {%- elsif clean == block.settings.trigger_value_4 and addon_4 != blank -%}
                      {%- assign option_price = addon_4.price -%}
                    {%- endif -%}
                    <li role="option" data-dropdown-option data-value="{{ clean | escape }}">
                      <button type="button" class="tlw-dropdown__option">
                        <span>
                          {{ clean }}
                          {%- if option_price != blank %} (+{{ option_price | money }}){% endif -%}
                        </span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              {%- if block.settings.help_text != blank -%}
                <p class="tlw-field__help">{{ block.settings.help_text }}</p>
              {%- endif -%}

              {%- assign block_label_downcase = block.settings.label | downcase -%}
              {%- if block_label_downcase contains 'cap size' -%}
                <p class="tlw-field__help">
                  {%- render 'tlw-measure-guide', id: block.id -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- endif -%}

        {% comment %} ---------- TOTAL (kept for the add-on pricing script, hidden by CSS) ---------- {% endcomment %}
        <div class="tlw-product__total">
          <span class="tlw-label-caps">Total</span>
          <span class="tlw-headline-sm" data-running-total>
            {{ current_variant.price | money }}
          </span>
        </div>

        {% comment %}
          ---------- CUSTOMS ACKNOWLEDGEMENT ----------
          Fixed, always on every product using this section — not a block,
          so there's nothing to accidentally remove. Required: the form
          won't submit until this is checked.
        {% endcomment %}
        <label class="tlw-product__ack" data-customs-ack>
          <input type="checkbox" data-customs-checkbox>
          <span class="tlw-product__ack-box">
            <svg viewBox="0 0 12 10" width="10" height="8" aria-hidden="true">
              <path d="M1 5l3.2 3.2L11 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="tlw-product__ack-text">
            I understand I may be responsible for any customs duties, taxes, or import fees on international orders.
          </span>
        </label>
        <p class="tlw-product__ack-error" data-customs-error hidden>
          Please confirm you understand the customs note above before adding to bag.
        </p>

        <input type="hidden" name="id" data-variant-id value="{{ current_variant.id }}">

        <button
          type="submit"
          class="tlw-btn tlw-product__submit"
          data-add-to-cart
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span data-button-text>
            {%- if current_variant.available -%}
              {{ section.settings.button_label | default: 'Add to bag' }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
        </button>

        <p class="tlw-product__error" data-cart-error hidden></p>
      </form>

    </div>
  </div>

  {% comment %}
    ---------- ACCORDIONS ----------
    Every accordion is an "Accordion" block, editable in the theme editor.
    Placeholders inside the text are swapped in automatically:
      {hair_type}        -> Raw or Virgin (from the description's Hair Type line)
      {lifespan}         -> from the description's Lifespan line, else "1 to 3 years"
      {product_details}  -> the bulleted spec list built from the description
  {% endcomment %}
  {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
  {%- if accordion_blocks.size > 0 -%}
  <div class="tlw-product__accordions">

    {%- liquid
      assign hair_type_value = ''
      assign lifespan_value = ''
    -%}

    {%- capture specs_html -%}
      {%- unless chunks == '' -%}
        <ul class="tlw-product__specs">
          {%- for chunk in chunks -%}
            {%- assign clean_chunk = chunk | strip -%}
            {%- if clean_chunk == blank -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign parts = clean_chunk | split: ':' -%}
            {%- assign label_candidate = parts[0] | strip -%}
            {%- assign value_candidate = clean_chunk | remove_first: label_candidate | remove_first: ':' | strip -%}

            {%- if parts.size > 1 and label_candidate.size <= 25 and value_candidate != blank -%}
              {%- assign words = label_candidate | downcase | split: ' ' -%}
              {%- assign title_label = '' -%}
              {%- for word in words -%}
                {%- assign capped_word = word | capitalize -%}
                {%- assign title_label = title_label | append: capped_word | append: ' ' -%}
              {%- endfor -%}
              {%- assign title_label = title_label | strip -%}

              {%- if title_label == 'Hair Type' -%}
                {%- assign hair_type_value = value_candidate -%}
              {%- endif -%}
              {%- if title_label contains 'Lifespan' -%}
                {%- assign lifespan_value = value_candidate -%}
              {%- endif -%}

              <li class="tlw-product__spec-item tlw-body-md">{{ title_label }}: {{ value_candidate }}</li>
            {%- else -%}
              <li class="tlw-product__spec-item tlw-body-md">{{ clean_chunk }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endunless -%}
    {%- endcapture -%}

    {%- assign hair_word = 'Virgin' -%}
    {%- if hair_type_value contains 'Raw' -%}
      {%- assign hair_word = 'Raw' -%}
    {%- endif -%}
    {%- assign lifespan_word = '1 to 3 years' -%}
    {%- if lifespan_value != blank -%}
      {%- assign lifespan_word = lifespan_value -%}
    {%- endif -%}

    {% comment %}
      Per-product overrides. Reads the product metafield custom.accordion_overrides
      (multi-line text), one instruction per line:
        Title: hide                    hides the accordion with that title on this product
        Title: replacement text        replaces that accordion's text on this product
        + Title: text                  adds an extra accordion to this product only
      Use || inside a line to start a new paragraph.
    {% endcomment %}
    {%- assign overrides_raw = product.metafields.custom.accordion_overrides.value | default: '' -%}
    {%- assign override_lines = overrides_raw | newline_to_br | split: '<br />' -%}

    {%- for block in accordion_blocks -%}
      {%- assign block_title = block.settings.title | default: 'Accordion' -%}
      {%- assign block_key = block_title | strip | downcase -%}
      {%- assign body = block.settings.content -%}
      {%- assign hide_block = false -%}

      {%- for ol in override_lines -%}
        {%- assign ol_clean = ol | strip -%}
        {%- unless ol_clean contains ':' -%}
          {%- continue -%}
        {%- endunless -%}
        {%- assign ol_parts = ol_clean | split: ':' -%}
        {%- assign ol_key = ol_parts[0] | strip | downcase -%}
        {%- if ol_key == block_key -%}
          {%- assign ol_val = ol_clean | remove_first: ol_parts[0] | remove_first: ':' | strip -%}
          {%- assign ol_val_key = ol_val | downcase -%}
          {%- if ol_val_key == 'hide' -%}
            {%- assign hide_block = true -%}
          {%- elsif ol_val != blank -%}
            {%- assign body = ol_val | replace: '||', '</p><p>' | prepend: '<p>' | append: '</p>' -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if hide_block -%}
        {%- continue -%}
      {%- endif -%}

      {%- comment %} A Product Details accordion is skipped when the product has no description. {%- endcomment %}
      {%- if body contains '{product_details}' and specs_html == blank -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign body = body | replace: '<p>{product_details}</p>', specs_html | replace: '{product_details}', specs_html | replace: '{hair_type}', hair_word | replace: '{lifespan}', lifespan_word | replace: '<p><strong>', '<p class="tlw-label-caps tlw-product__disclaimer-heading"><strong>' | replace: '<p>', '<p class="tlw-body-md">' | replace: '<ul>', '<ul class="tlw-product__list">' -%}

      <div class="tlw-accordion" data-accordion {{ block.shopify_attributes }}>
        <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span class="tlw-label-caps">{{ block_title }}</span>
          <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <div class="tlw-accordion__panel" data-accordion-panel>
          <div class="tlw-accordion__inner">
            {{ body }}
          </div>
        </div>
      </div>
    {%- endfor -%}

    {%- comment %} Extra accordions added for this product only ("+ Title: text"). {%- endcomment %}
    {%- for ol in override_lines -%}
      {%- assign ol_clean = ol | strip -%}
      {%- unless ol_clean contains ':' -%}
        {%- continue -%}
      {%- endunless -%}
      {%- assign first_char = ol_clean | slice: 0 -%}
      {%- unless first_char == '+' -%}
        {%- continue -%}
      {%- endunless -%}
      {%- assign ol_parts = ol_clean | split: ':' -%}
      {%- assign extra_title = ol_parts[0] | remove_first: '+' | strip -%}
      {%- assign extra_body = ol_clean | remove_first: ol_parts[0] | remove_first: ':' | strip -%}
      {%- if extra_title == blank or extra_body == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign extra_body = extra_body | replace: '||', '</p><p>' | prepend: '<p>' | append: '</p>' -%}
