{% comment %}
  THELACEDWÁY main product section
  Home of Amare Studio

  Handles two kinds of purchase:
  1. Real Shopify variants (Lace Size, Length, Lace type) which carry the price.
  2. Service options, which are either free line item properties, or paid
     add-ons that get added to the cart as their own separate line.

  Paid add-ons MUST be separate cart lines. Line item properties are display
  only and carry no price.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<section
  class="tlw-product tlw-container"
  id="tlw-product-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="tlw-product__grid">

    {% comment %} ---------- GALLERY ---------- {% endcomment %}
    <div class="tlw-product__media">
      {%- if product.media.size > 0 -%}
        <div class="tlw-product__main-image" data-main-image>
          {{ product.featured_media
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              sizes: '(min-width: 900px) 50vw, 100vw',
              widths: '400, 600, 900, 1200, 1400',
              alt: product.title
          }}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="tlw-product__thumbs">
            {%- for media in product.media -%}
              <button
                type="button"
                class="tlw-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-thumb
                data-full="{{ media | image_url: width: 1400 }}"
                aria-label="View image {{ forloop.index }}"
              >
                {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="tlw-product__placeholder">
          <span class="tlw-label-caps">Image coming soon</span>
        </div>
      {%- endif -%}
    </div>

    {% comment %} ---------- DETAILS ---------- {% endcomment %}
    <div class="tlw-product__info">

      {%- if section.settings.show_collection_label and product.collections.size > 0 -%}
        <p class="tlw-label-caps tlw-product__eyebrow">
          {{ product.collections.first.title }}
        </p>
      {%- endif -%}

      <h1 class="tlw-display-lg tlw-product__title">{{ product.title }}</h1>

      {%- if section.settings.detail_line != blank -%}
        <p class="tlw-body-md tlw-product__detail">{{ section.settings.detail_line }}</p>
      {%- endif -%}

      <p class="tlw-headline-sm tlw-product__price" data-price>
        {{ current_variant.price | money }}
      </p>

      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        id="tlw-form-{{ section.id }}"
        data-product-form
        data-product-title="{{ product.title | escape }}"
      >

        {% comment %} ---------- REAL VARIANTS ---------- {% endcomment %}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="tlw-field">
              <label class="tlw-label-caps tlw-field__label" id="tlw-opt-label-{{ section.id }}-{{ forloop.index }}">
                {{ option.name }}
              </label>

              <div
                class="tlw-dropdown"
                data-dropdown
                data-dropdown-id="variant-{{ forloop.index }}"
              >
                <select
                  class="tlw-select tlw-visually-hidden"
                  id="tlw-opt-{{ section.id }}-{{ forloop.index }}"
                  data-option-index="{{ forloop.index0 }}"
                  data-variant-option
                  data-dropdown-store
                  tabindex="-1"
                  aria-hidden="true"
                >
                  {%- for value in option.values -%}
                    <option
                      value="{{ value | escape }}"
                      {% if option.selected_value == value %}selected{% endif %}
                    >
                      {{ value }}
                    </option>
                  {%- endfor -%}
                </select>

                <button
                  type="button"
                  class="tlw-dropdown__trigger"
                  data-dropdown-trigger
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="tlw-opt-label-{{ section.id }}-{{ forloop.index }} tlw-opt-{{ section.id }}-{{ forloop.index }}-value"
                >
                  {%- if option.selected_value != blank -%}
                    <span data-dropdown-value id="tlw-opt-{{ section.id }}-{{ forloop.index }}-value">{{ option.selected_value }}</span>
                  {%- else -%}
                    <span data-dropdown-value id="tlw-opt-{{ section.id }}-{{ forloop.index }}-value" class="tlw-dropdown__placeholder">
                      Select {{ option.name | downcase }}...
                    </span>
                  {%- endif -%}
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" class="tlw-dropdown__chevron">
                    <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <ul class="tlw-dropdown__panel" data-dropdown-panel role="listbox" aria-label="{{ option.name }}" hidden>
                  {%- for value in option.values -%}
                    <li role="option" data-dropdown-option data-value="{{ value | escape }}"{% if option.selected_value == value %} class="is-selected"{% endif %}>
                      <button type="button" class="tlw-dropdown__option">
                        <span>{{ value }}</span>
                        <span class="tlw-dropdown__option-note" data-sold-out-label hidden>(Sold out)</span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              {%- assign option_downcase = option.name | downcase -%}
              {%- if option_downcase contains 'cap size' -%}
                {%- assign measure_guide_id = 'variant-' | append: forloop.index -%}
                <p class="tlw-field__help">
                  {%- render 'tlw-measure-guide', id: measure_guide_id -%}
                </p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        {% comment %}
          ---------- SERVICE OPTIONS ----------
          Each block is one dropdown. If the chosen value matches the block's
          trigger value AND the block has an add-on product set, that add-on
          is added to the cart as its own line at its own price.
        {% endcomment %}
        {%- for block in section.blocks -%}
          {%- if block.type == 'service_option' -%}
            {%- assign values = block.settings.values | split: ',' -%}
            {%- assign addon = block.settings.addon_product -%}

            <div class="tlw-field" {{ block.shopify_attributes }}>
              <label class="tlw-label-caps tlw-field__label" id="tlw-svc-label-{{ block.id }}">
                <span>
                  {{ block.settings.label }}
                  {%- assign label_downcase = block.settings.label | downcase -%}
                  {%- if label_downcase contains 'hairline' -%}
                    {%- render 'tlw-hairline-guide', id: block.id -%}
                  {%- endif -%}
                </span>
                {%- if addon != blank and block.settings.trigger_value != blank -%}
                  <span class="tlw-field__price">
                    +{{ addon.price | money }} if {{ block.settings.trigger_value | strip }}
                  </span>
                {%- endif -%}
              </label>

              <div class="tlw-dropdown" data-dropdown data-dropdown-id="svc-{{ block.id }}">
                <select
                  class="tlw-select tlw-visually-hidden"
                  id="tlw-svc-{{ block.id }}"
                  data-service-option
                  data-property-name="{{ block.settings.label | escape }}"
                  data-trigger-value="{{ block.settings.trigger_value | strip | escape }}"
                  data-dropdown-store
                  tabindex="-1"
                  aria-hidden="true"
                  {% if addon != blank %}
                    data-addon-variant-id="{{ addon.selected_or_first_available_variant.id }}"
                    data-addon-price="{{ addon.price }}"
                    data-addon-title="{{ addon.title | escape }}"
                  {% endif %}
                >
                  {%- for value in values -%}
                    {%- assign clean = value | strip -%}
                    <option value="{{ clean | escape }}">{{ clean }}</option>
                  {%- endfor -%}
                </select>

                <button
                  type="button"
                  class="tlw-dropdown__trigger"
                  data-dropdown-trigger
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="tlw-svc-label-{{ block.id }} tlw-svc-{{ block.id }}-value"
                >
                  {%- assign first_value = values.first | strip -%}
                  <span data-dropdown-value id="tlw-svc-{{ block.id }}-value">{{ first_value }}</span>
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" class="tlw-dropdown__chevron">
                    <path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>

                <ul class="tlw-dropdown__panel" data-dropdown-panel role="listbox" aria-label="{{ block.settings.label }}" hidden>
                  {%- for value in values -%}
                    {%- assign clean = value | strip -%}
                    <li role="option" data-dropdown-option data-value="{{ clean | escape }}"{% if forloop.first %} class="is-selected"{% endif %}>
                      <button type="button" class="tlw-dropdown__option">
                        <span>{{ clean }}</span>
                      </button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              {%- if block.settings.help_text != blank -%}
                <p class="tlw-field__help">{{ block.settings.help_text }}</p>
              {%- endif -%}

              {%- assign block_label_downcase = block.settings.label | downcase -%}
              {%- if block_label_downcase contains 'cap size' -%}
                <p class="tlw-field__help">
                  {%- render 'tlw-measure-guide', id: block.id -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {% comment %} ---------- TOTAL ---------- {% endcomment %}
        <div class="tlw-product__total">
          <span class="tlw-label-caps">Total</span>
          <span class="tlw-headline-sm" data-running-total>
            {{ current_variant.price | money }}
          </span>
        </div>

        <input type="hidden" name="id" data-variant-id value="{{ current_variant.id }}">

        <button
          type="submit"
          class="tlw-btn tlw-product__submit"
          data-add-to-cart
          {% unless current_variant.available %}disabled{% endunless %}
        >
          <span data-button-text>
            {%- if current_variant.available -%}
              {{ section.settings.button_label | default: 'Add to bag' }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
        </button>

        <p class="tlw-product__error" data-cart-error hidden></p>
      </form>

    </div>
  </div>

  {% comment %} ---------- ACCORDIONS ---------- {% endcomment %}
  <div class="tlw-product__accordions">

    {%- liquid
      assign hair_type_value = ''
      assign lifespan_value = ''
    -%}

    {%- if product.description != blank -%}
      {%- liquid
        assign raw = product.description
        assign raw = raw | replace: '</p>', '|||' | replace: '<br>', '|||' | replace: '<br />', '|||' | replace: '<br/>', '|||' | replace: '</li>', '|||'
        assign raw = raw | strip_html | strip_newlines
        assign raw = raw | replace: '•', '|||' | replace: '·', '|||' | replace: '‣', '|||' | replace: '▪', '|||'
        assign chunks = raw | split: '|||'
      -%}

      <div class="tlw-accordion" data-accordion>
        <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span class="tlw-label-caps">Product Details</span>
          <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <div class="tlw-accordion__panel" data-accordion-panel>
          <div class="tlw-accordion__inner">
            <div class="tlw-product__specs">
              {%- for chunk in chunks -%}
                {%- assign clean_chunk = chunk | strip -%}
                {%- if clean_chunk == blank -%}
                  {%- continue -%}
                {%- endif -%}

                {%- assign parts = clean_chunk | split: ':' -%}
                {%- assign label_candidate = parts[0] | strip -%}
                {%- assign value_candidate = clean_chunk | remove_first: label_candidate | remove_first: ':' | strip -%}

                {%- if parts.size > 1 and label_candidate.size <= 25 and value_candidate != blank -%}
                  {%- assign words = label_candidate | downcase | split: ' ' -%}
                  {%- assign title_label = '' -%}
                  {%- for word in words -%}
                    {%- assign title_label = title_label | append: word | capitalize | append: ' ' -%}
                  {%- endfor -%}
                  {%- assign title_label = title_label | strip -%}

                  {%- if title_label == 'Hair Type' -%}
                    {%- assign hair_type_value = value_candidate -%}
                  {%- endif -%}
                  {%- if title_label contains 'Lifespan' -%}
                    {%- assign lifespan_value = value_candidate -%}
                  {%- endif -%}

                  <div class="tlw-product__spec-row">
                    <span class="tlw-label-caps tlw-product__spec-label">{{ title_label }}</span>
                    <span class="tlw-product__spec-value">{{ value_candidate }}</span>
                  </div>
                {%- else -%}
                  <p class="tlw-product__spec-note tlw-body-md">{{ clean_chunk }}</p>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- unless product.type contains 'Accessor' -%}
      <div class="tlw-accordion" data-accordion>
        <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span class="tlw-label-caps">Hair Care</span>
          <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <div class="tlw-accordion__panel" data-accordion-panel>
          <div class="tlw-accordion__inner">
            <p class="tlw-body-md">
              Our {% if hair_type_value contains 'Raw' %}Raw{% else %}Virgin{% endif %} Hair can be washed and conditioned just like your natural hair. For the best results, we recommend using sulphate-free or organic hair care products to maintain the softness and longevity of the hair.
            </p>
            <p class="tlw-body-md">
              For best results, we recommend air drying your hair after washing. This helps retain moisture, reduces unnecessary heat exposure, and prolongs the life and quality of your hair.
            </p>
          </div>
        </div>
      </div>

      <div class="tlw-accordion" data-accordion>
        <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span class="tlw-label-caps">Longevity</span>
          <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <div class="tlw-accordion__panel" data-accordion-panel>
          <div class="tlw-accordion__inner">
            <p class="tlw-body-md">
              With the correct maintenance and aftercare, our hair can last
              {% if lifespan_value != blank %}{{ lifespan_value }}{% else %}1 to 3 years{% endif %},
              making it a worthwhile investment.
            </p>
          </div>
        </div>
      </div>
    {%- endunless -%}

    <div class="tlw-accordion" data-accordion>
      <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
        <span class="tlw-label-caps">Shipping and Returns</span>
        <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <div class="tlw-accordion__panel" data-accordion-panel>
        <div class="tlw-accordion__inner">
          <p class="tlw-body-md">
            Once your order has been placed, you have 24 hours to contact us if you wish to make any amendments. After this period, your order will be processed and no further changes can be made.
          </p>
          {%- if collection.handle == 'ready-to-ship' -%}
            <p class="tlw-body-md">This unit is Ready to Ship. It is already finished and dispatched within 1 to 2 working days of your order.</p>
          {%- else -%}
            <p class="tlw-body-md">Each unit is custom made to order. Please allow 7-15 working days for your unit to be made before dispatch.</p>
          {%- endif -%}
          <p class="tlw-body-md">Once your order has been shipped, delivery typically takes:</p>
          <ul class="tlw-product__list">
            <li>Royal Mail Tracked 24 (Tracked and Signed)</li>
            <li>Royal Mail Special Delivery (Covers parcel if lost): Next working day before 1pm.</li>
          </ul>
          <p class="tlw-body-md">For full details, please refer to our <a href="/pages/shipping-returns" class="tlw-product__link">Shipping &amp; Returns Policy</a>.</p>
        </div>
      </div>
    </div>

    {%- unless product.type contains 'Accessor' -%}
      <div class="tlw-accordion" data-accordion>
        <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
          <span class="tlw-label-caps">How to Measure Your Head</span>
          <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        </button>
        <div class="tlw-accordion__panel" data-accordion-panel>
          <div class="tlw-accordion__inner">
            <p class="tlw-body-md">To ensure the best fit, we recommend measuring your head before selecting your wig size.</p>
            <p class="tlw-body-md">Using a soft measuring tape, start at the centre of your hairline and wrap the tape around your head, passing just above your ears and around the nape of your neck before bringing it back to the starting point.</p>
            <p class="tlw-body-md">This measurement is your head circumference and will help you choose the correct cap size for the most secure and comfortable fit.</p>
            <p class="tlw-body-md">Please note: We strongly recommend measuring your head accurately before placing your order. As all units are custom-made, we cannot accept responsibility for incorrect measurements provided by the customer and cap sizes cannot be changed once production has begun.</p>
          </div>
        </div>
      </div>
    {%- endunless -%}

    <div class="tlw-accordion" data-accordion>
      <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
        <span class="tlw-label-caps">International Orders</span>
        <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <div class="tlw-accordion__panel" data-accordion-panel>
        <div class="tlw-accordion__inner">
          <p class="tlw-body-md">{{ section.settings.international_orders_text }}</p>
        </div>
      </div>
    </div>

    <div class="tlw-accordion" data-accordion>
      <button type="button" class="tlw-accordion__trigger" data-accordion-trigger aria-expanded="false">
        <span class="tlw-label-caps">Disclaimer (Please Read)</span>
        <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
      <div class="tlw-accordion__panel" data-accordion-panel>
        <div class="tlw-accordion__inner">
          <div class="tlw-product__disclaimer-block">
            <p class="tlw-label-caps tlw-product__disclaimer-heading">Colour Disclaimer</p>
            <p class="tlw-body-md">Every unit is unique. Slight variations in colour may occur. Please note that colours may appear differently depending on your device screen and lighting.</p>
          </div>
          <div class="tlw-product__disclaimer-block">
            <p class="tlw-label-caps tlw-product__disclaimer-heading">Hair Length Disclaimer</p>
            <p class="tlw-body-md">When selecting your desired hair length, please keep in mind that the final appearance will vary depending on how the hair is styled.</p>
            <p class="tlw-body-md">Curls may reduce the visible length by approximately 2-4 inches.</p>
            <p class="tlw-body-md">For example: If you would like your curled hair to appear approximately 22 inches long, we recommend selecting a straight hair length of 24-26 inches.</p>
            <p class="tlw-body-md">Please note that all hair lengths are measured when the hair is straight and fully stretched.</p>
          </div>
          <div class="tlw-product__disclaimer-block">
            <p class="tlw-label-caps tlw-product__disclaimer-heading">Texture Disclaimer</p>
            <p class="tlw-body-md">Please note that any unit displayed with a curled, loose wave or similar styled appearance has been heat styled. These looks are achieved by curling our straight hair and are intended to showcase the hair's versatility. This style is temporary and will gradually loosen over time, particularly after brushing or washing.</p>
            <p class="tlw-body-md">Once washed, the hair will return to its natural texture. The hair can be restyled using heat whenever desired.</p>
          </div>
        </div>
      </div>
    </div>

  </div>

  {% comment %} ---------- FITTED ON REAL CLIENTS ---------- {% endcomment %}
  {%- if section.blocks.size > 0 -%}
    {%- assign client_blocks = section.blocks | where: 'type', 'client' -%}
    {%- if client_blocks.size > 0 -%}
      <div class="tlw-product__clients">
        <div class="tlw-product__clients-head">
          <span class="tlw-label-caps tlw-product__clients-eyebrow">Before You Take Our Word For It.</span>
          <h2 class="tlw-headline-md">Fitted On Real Clients.</h2>
        </div>
        <div class="tlw-product__clients-grid">
          {%- for block in client_blocks -%}
            <div class="tlw-product__client" {{ block.shopify_attributes }}>
              <div class="tlw-product__client-media">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.name }}
                {%- endif -%}
                <div class="tlw-product__client-overlay">
                  <p class="tlw-product__client-quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
                  <p class="tlw-label-caps tlw-product__client-caption">{{ block.settings.name }} / {{ block.settings.length }} / {{ block.settings.lace_size }} lace</p>
                </div>
              </div>
              <p class="tlw-label-caps tlw-product__client-caption tlw-product__client-caption--mobile">{{ block.settings.name }} / {{ block.settings.length }} / {{ block.settings.lace_size }} lace</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {% comment %} ---------- EXPLORE ---------- {% endcomment %}
  {%- if product.collections.size > 0 -%}
    {%- assign explore_collection = product.collections.first -%}
    <div class="tlw-product__explore">
      <h2 class="tlw-headline-md">Explore the rest of {{ explore_collection.title }}</h2>
      <p class="tlw-body-md">Every piece is hand-tied and finished to your measurements. See the full collection.</p>
      <a href="{{ explore_collection.url }}" class="tlw-product__explore-btn">Back to {{ explore_collection.title }}</a>
    </div>
  {%- endif -%}

  {% comment %}
    Variant data for the price and availability updates. Written as JSON so the
    script never has to guess which variant a set of options maps to.
  {% endcomment %}
  <script type="application/json" data-variant-json>
    {{ product.variants | json }}
  </script>
</section>

<style>
  #tlw-product-{{ section.id }} {
    padding-block: 48px;
  }

  #tlw-product-{{ section.id }} .tlw-product__grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 900px) {
    #tlw-product-{{ section.id }} {
      padding-block: 80px;
    }
    #tlw-product-{{ section.id }} .tlw-product__grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
    #tlw-product-{{ section.id }} .tlw-product__info {
      position: sticky;
      top: calc(var(--tlw-nav-h) + 24px);
    }
  }

  #tlw-product-{{ section.id }} .tlw-product__main-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  #tlw-product-{{ section.id }} .tlw-product__placeholder {
    aspect-ratio: 4 / 5;
    background: var(--tlw-surface-container);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tlw-outline);
  }

  #tlw-product-{{ section.id }} .tlw-product__thumbs {
    display: flex;
    gap: 8px;
    margin-top: 8px;
    overflow-x: auto;
  }

  #tlw-product-{{ section.id }} .tlw-product__thumb {
    flex: 0 0 72px;
    padding: 0;
