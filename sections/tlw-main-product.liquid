  #tlw-product-{{ section.id }} .tlw-product__explore p {
    color: var(--tlw-on-surface-variant);
    margin: 0 0 32px;
  }

  #tlw-product-{{ section.id }} .tlw-product__explore-btn {
    display: inline-block;
    border: 1px solid var(--tlw-accent);
    padding: 16px 40px;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-product-{{ section.id }} .tlw-product__explore-btn:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-product-{{ section.id }}');

    if (!root) return;

    var form = root.querySelector('[data-product-form]');
    var variants = JSON.parse(root.querySelector('[data-variant-json]').textContent);
    var variantInput = root.querySelector('[data-variant-id]');
    var priceEl = root.querySelector('[data-price]');
    var totalEl = root.querySelector('[data-running-total]');
    var button = root.querySelector('[data-add-to-cart]');
    var buttonText = root.querySelector('[data-button-text]');
    var errorEl = root.querySelector('[data-cart-error]');
    var moneyFormat = {{ shop.money_format | json }};

    function formatMoney(cents) {
      var amount = (cents / 100).toFixed(2);
      return moneyFormat.replace(/\{\{\s*amount\s*\}\}/, amount);
    }

    /* ---- work out which variant the chosen options map to ---- */
    function currentVariant() {
      var selects = root.querySelectorAll('[data-variant-option]');
      if (!selects.length) return variants[0];

      var chosen = [];
      selects.forEach(function (s) {
        chosen[parseInt(s.dataset.optionIndex, 10)] = s.value;
      });

      return variants.find(function (v) {
        return chosen.every(function (val, i) {
          return v.options[i] === val;
        });
      }) || null;
    }

    /* ---- read a service option's data-addon-pairs into a plain array ----
       Format: "value::variantId::price||value::variantId::price" — kept as
       a simple delimited string rather than JSON so it drops straight into
       an HTML attribute with no escaping headaches. */
    function addonPairsFor(select) {
      var raw = select.dataset.addonPairs;
      console.log('[TLW DEBUG] field:', select.dataset.propertyName, '| raw data-addon-pairs attribute:', JSON.stringify(raw));
      if (!raw) return [];
      return raw.split('||').filter(Boolean).map(function (pair) {
        var parts = pair.split('::');
        return { value: parts[0], variantId: parseInt(parts[1], 10), price: parseInt(parts[2], 10) };
      });
    }

    function matchedAddon(select) {
      var pairs = addonPairsFor(select);
      console.log('[TLW DEBUG] field:', select.dataset.propertyName, '| current select.value:', JSON.stringify(select.value), '| parsed pairs:', JSON.stringify(pairs));
      for (var i = 0; i < pairs.length; i++) {
        if (pairs[i].value === select.value) {
          console.log('[TLW DEBUG] MATCHED! price:', pairs[i].price);
          return pairs[i];
        }
      }
      console.log('[TLW DEBUG] no match found for this value');
      return null;
    }

    /* ---- add up base variant plus any triggered add-ons ---- */
    function runningTotal(variant) {
      var total = variant ? variant.price : 0;
      root.querySelectorAll('[data-service-option]').forEach(function (s) {
        var match = matchedAddon(s);
        if (match) total += match.price;
      });
      return total;
    }

    function refresh() {
      var variant = currentVariant();

      if (!variant) {
        button.disabled = true;
        buttonText.textContent = 'Unavailable';
        return;
      }

      variantInput.value = variant.id;
      priceEl.textContent = formatMoney(runningTotal(variant));
      totalEl.textContent = formatMoney(runningTotal(variant));

      button.disabled = !variant.available;
      buttonText.textContent = variant.available
        ? {{ section.settings.button_label | default: 'Add to bag' | json }}
        : 'Sold out';
    }

    root.addEventListener('change', function (e) {
      if (e.target.matches('[data-variant-option], [data-service-option]')) refresh();
    });

    /* ---- gallery ---- */
    var mainImg = root.querySelector('[data-main-image] img');
    root.querySelectorAll('[data-thumb]').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        if (mainImg) mainImg.src = thumb.dataset.full;
        root.querySelectorAll('[data-thumb]').forEach(function (t) {
          t.classList.remove('is-active');
        });
        thumb.classList.add('is-active');
      });
    });

    /* ---- customs acknowledgement: required before adding to cart ---- */
    var customsAck = root.querySelector('[data-customs-ack]');
    var customsCheckbox = root.querySelector('[data-customs-checkbox]');
    var customsError = root.querySelector('[data-customs-error]');

    if (customsCheckbox) {
      customsCheckbox.addEventListener('change', function () {
        if (customsCheckbox.checked) {
          customsAck.classList.remove('is-error');
          customsError.hidden = true;
        }
      });
    }

    /* ---- add to cart ---- */
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      errorEl.hidden = true;

      if (customsCheckbox && !customsCheckbox.checked) {
        customsAck.classList.add('is-error');
        customsError.hidden = false;
        customsAck.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      var variant = currentVariant();
      if (!variant) return;

      var productTitle = form.dataset.productTitle;
      var properties = {};
      var addons = [];

      root.querySelectorAll('[data-service-option]').forEach(function (s) {
        /* every service choice is recorded on the main line so the order
           shows exactly what was picked, paid or not */
        properties[s.dataset.propertyName] = s.value;

        var match = matchedAddon(s);
        if (match) {
          addons.push({
            id: match.variantId,
            quantity: 1,
            properties: { 'Add-on for': productTitle }
          });
        }
      });

      var items = [{ id: variant.id, quantity: 1, properties: properties }].concat(addons);

      buttonText.textContent = 'Adding...';
      button.disabled = true;

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) {
          if (!res.ok) return res.json().then(function (d) { throw new Error(d.description || 'Could not add to bag'); });
          return res.json();
        })
        .then(function () {
          /* let Horizon's cart drawer know something changed */
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          window.location.href = '{{ routes.cart_url }}';
        })
        .catch(function (err) {
          errorEl.textContent = err.message;
          errorEl.hidden = false;
        })
        .finally(function () {
          button.disabled = false;
          refresh();
        });
    });

    refresh();

    /* ---- accordions ----
       Measuring the real pixel height and animating max-height to that,
       rather than a CSS fraction trick, since that proved unreliable in
       some environments. This is the older but bulletproof pattern. */
    root.querySelectorAll('[data-accordion]').forEach(function (acc) {
      var trigger = acc.querySelector('[data-accordion-trigger]');
      var panel = acc.querySelector('[data-accordion-panel]');
      trigger.addEventListener('click', function () {
        var isOpen = acc.classList.contains('is-open');
        if (isOpen) {
          panel.style.maxHeight = '0px';
        } else {
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }
        acc.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    /* ---- custom dropdowns ----
       Each wraps a real (but hidden) <select> that stays the single source
       of truth: clicking a custom option updates the hidden select's value
       and dispatches a real 'change' event, so all the cart/price logic
       above keeps working exactly as it did against a native select. */
    var allDropdowns = Array.prototype.slice.call(root.querySelectorAll('[data-dropdown]'));

    function closeDropdown(dd) {
      dd.classList.remove('is-open');
      var trigger = dd.querySelector('[data-dropdown-trigger]');
      var panel = dd.querySelector('[data-dropdown-panel]');
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
    }

    function openDropdown(dd) {
      allDropdowns.forEach(function (other) {
        if (other !== dd) closeDropdown(other);
      });
      dd.classList.add('is-open');
      var trigger = dd.querySelector('[data-dropdown-trigger]');
      var panel = dd.querySelector('[data-dropdown-panel]');
      trigger.setAttribute('aria-expanded', 'true');
      panel.hidden = false;
    }

    function selectOption(dd, li) {
      if (li.classList.contains('is-disabled')) return;
      var value = li.dataset.value;
      var select = dd.querySelector('[data-dropdown-store]');
      var valueEl = dd.querySelector('[data-dropdown-value]');

      select.value = value;
      valueEl.textContent = value;
      valueEl.classList.remove('tlw-dropdown__placeholder');

      dd.querySelectorAll('[data-dropdown-option]').forEach(function (opt) {
        opt.classList.toggle('is-selected', opt === li);
      });

      dd.classList.remove('is-invalid');
      closeDropdown(dd);

      var event = document.createEvent('HTMLEvents');
      event.initEvent('change', true, true);
      select.dispatchEvent(event);
    }

    allDropdowns.forEach(function (dd) {
      var trigger = dd.querySelector('[data-dropdown-trigger]');
      var panel = dd.querySelector('[data-dropdown-panel]');
      var options = Array.prototype.slice.call(dd.querySelectorAll('[data-dropdown-option]'));

      trigger.addEventListener('click', function () {
        if (dd.classList.contains('is-open')) closeDropdown(dd);
        else openDropdown(dd);
      });

      options.forEach(function (li) {
        li.querySelector('.tlw-dropdown__option').addEventListener('click', function () {
          selectOption(dd, li);
        });
      });

      trigger.addEventListener('keydown', function (e) {
        var activeIndex = options.findIndex(function (o) { return o.classList.contains('is-active'); });
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!dd.classList.contains('is-open')) {
            openDropdown(dd);
            return;
          }
          var dir = e.key === 'ArrowDown' ? 1 : -1;
          var next = Math.min(options.length - 1, Math.max(0, activeIndex + dir));
          options.forEach(function (o, i) { o.classList.toggle('is-active', i === next); });
        } else if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (!dd.classList.contains('is-open')) {
            openDropdown(dd);
          } else if (activeIndex > -1) {
            selectOption(dd, options[activeIndex]);
          }
        } else if (e.key === 'Escape') {
          closeDropdown(dd);
        }
      });
    });

    document.addEventListener('click', function (e) {
      allDropdowns.forEach(function (dd) {
        if (!dd.contains(e.target)) closeDropdown(dd);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') allDropdowns.forEach(closeDropdown);
    });

    /* ---- keep variant dropdown options in sync with what's actually
       selected, and grey out combinations with no matching variant ---- */
    function syncVariantDropdowns() {
      var variantSelects = Array.prototype.slice.call(root.querySelectorAll('[data-variant-option]'));
      if (!variantSelects.length) return;

      var chosen = variantSelects.map(function (s) { return s.value; });

      variantSelects.forEach(function (select) {
        var index = parseInt(select.dataset.optionIndex, 10);
        var dd = select.closest('[data-dropdown]');

        dd.querySelectorAll('[data-dropdown-option]').forEach(function (li) {
          var testValues = chosen.slice();
          testValues[index] = li.dataset.value;

          var available = variants.some(function (v) {
            return testValues.every(function (val, i) { return v.options[i] === val; }) && v.available;
          });

          li.classList.toggle('is-disabled', !available);
          var note = li.querySelector('[data-sold-out-label]');
          if (note) note.hidden = available;
        });
      });
    }

    root.addEventListener('change', function (e) {
      if (e.target.matches('[data-variant-option]')) syncVariantDropdowns();
    });

    syncVariantDropdowns();

    /* ---- Customisation reveal: Hairline, Styled and Layers only show
       once Customisation is set to "Yes". Matched by field label, same
       pattern as the Hairline "?" icon and Cap Size measure-guide link. */
    var customisationField = root.querySelector('[data-field-label="customisation"]');
    var revealFields = Array.prototype.slice.call(root.querySelectorAll('[data-customisation-reveal]'));

    function syncCustomisationReveal() {
      if (!customisationField || !revealFields.length) return;
      var select = customisationField.querySelector('[data-service-option]');
      var show = !!select && select.value.trim().toLowerCase() === 'yes';
      revealFields.forEach(function (field) {
        field.hidden = !show;
      });
    }

    if (customisationField) {
      var customisationSelect = customisationField.querySelector('[data-service-option]');
      if (customisationSelect) {
        customisationSelect.addEventListener('change', syncCustomisationReveal);
      }
      syncCustomisationReveal();
    }
  })();
</script>

{% schema %}
{
  "name": "TLW Product",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "detail_line",
      "label": "Detail line",
      "info": "Shown under the product name, e.g. HD lace / Machine made unit. Leave blank for none."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Add to bag"
    },
    {
      "type": "checkbox",
      "id": "show_collection_label",
      "label": "Show collection name above the title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "unit_details_mode",
      "label": "Ready to Ship: show fixed Unit Details card",
      "info": "Use on Ready to Ship templates \u2014 the unit is already made, so there's nothing to customise. Turns off every dropdown and just lists the specs from the description.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "service_option",
      "name": "Service option",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Option name",
          "info": "Shown to the customer and recorded on the order, e.g. Customisation"
        },
        {
          "type": "text",
          "id": "values",
          "label": "Choices",
          "info": "Separate with commas. The first one is selected by default.",
          "default": "No, Yes"
        },
        {
          "type": "text",
          "id": "trigger_value",
          "label": "Charge when the customer picks (1)",
          "info": "Must match one of the choices exactly. Leave empty for a free option."
        },
        {
          "type": "product",
          "id": "addon_product",
          "label": "Add-on product to charge for (1)",
          "info": "The hidden product holding the price."
        },
        {
          "type": "header",
          "content": "A second paid choice (optional)"
        },
        {
          "type": "text",
          "id": "trigger_value_2",
          "label": "Charge when the customer picks (2)",
          "info": "Leave both (2) fields empty if this option only has one paid choice."
        },
        {
          "type": "product",
          "id": "addon_product_2",
          "label": "Add-on product to charge for (2)"
        },
        {
          "type": "header",
          "content": "A third paid choice (optional)"
        },
        {
          "type": "text",
          "id": "trigger_value_3",
          "label": "Charge when the customer picks (3)"
        },
        {
          "type": "product",
          "id": "addon_product_3",
          "label": "Add-on product to charge for (3)"
        },
        {
          "type": "header",
          "content": "A fourth paid choice (optional)"
        },
        {
          "type": "text",
          "id": "trigger_value_4",
          "label": "Charge when the customer picks (4)"
        },
        {
          "type": "product",
          "id": "addon_product_4",
          "label": "Add-on product to charge for (4)"
        },
        {
          "type": "text",
          "id": "help_text",
          "label": "Helper text",
          "info": "Optional line under the dropdown"
        },
        {
          "type": "text",
          "id": "tooltip",
          "label": "Help pop-up text",
          "info": "Optional. Adds a ? icon beside the option name; hovering or tapping it shows this text. Jet Black already has one built in."
        },
        {
          "type": "header",
          "content": "Visibility"
        },
        {
          "type": "checkbox",
          "id": "reveal_on_customisation",
          "label": "Only show once Customisation is set to Yes",
          "info": "Turn this on for options that should stay hidden until the customer opts into customisation \u2014 e.g. Hairline, Styled, Layers. Needs a field labelled \u2018Customisation\u2019 elsewhere on this product.",
          "default": false
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New accordion"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "info": "Placeholders filled in automatically: {hair_type}, {lifespan}, {product_details}. Bold a line on its own to make it a gold heading.",
          "default": "<p>Add your text here.</p>"
        }
      ]
    },
    {
      "type": "client",
      "name": "Client photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Client first name"
        },
        {
          "type": "text",
          "id": "length",
          "label": "Length",
          "info": "e.g. 18\u2033"
        },
        {
          "type": "text",
          "id": "lace_size",
          "label": "Lace size",
          "info": "e.g. 5x5"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "info": "Shown on hover (desktop). Don't include quotation marks, they're added automatically."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TLW Product",
      "blocks": [
        {
          "type": "service_option",
          "settings": {
            "label": "Customisation",
            "values": "No, Yes",
            "trigger_value": "Yes"
          }
        },
        {
          "type": "service_option",
          "settings": {
            "label": "Parting Preference",
            "values": "Left side part, Middle part, Right side part",
            "help_text": "Please note: If you select a side part for a 5x5, 6x6 or 7x7 closure, the closure itself will be constructed and positioned towards your preferred side rather than in the centre."
          }
        },
        {
          "type": "service_option",
          "settings": {
            "label": "Jet Black",
            "values": "No, Yes",
            "trigger_value": "Yes"
          }
        },
        {
          "type": "service_option",
          "settings": {
            "label": "Hairline",
            "values": "Natural Hairline, Light Lagos Hairline"
          }
        },
        {
          "type": "service_option",
          "settings": {
            "label": "Styled",
            "values": "Straight, Curled, Curled (Pin Intact)",
            "trigger_value": "Curled (Pin Intact)"
          }
        },
        {
          "type": "service_option",
          "settings": {
            "label": "Layers",
            "values": "No, Face framing, Heavy Layers (Curls Only), Blunt Cut",
            "trigger_value": "Face framing",
            "trigger_value_2": "Heavy Layers (Curls Only)"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Product Details",
            "content": "<p>{product_details}</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Hair Care",
            "content": "<p>Our {hair_type} Hair can be washed and conditioned just like your natural hair. For the best results, we recommend using sulphate-free or organic hair care products to maintain the softness and longevity of the hair.</p><p>For best results, we recommend air drying your hair after washing. This helps retain moisture, reduces unnecessary heat exposure, and prolongs the life and quality of your hair.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Longevity",
            "content": "<p>With the correct maintenance and aftercare, our hair can last {lifespan}, making it a worthwhile investment.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Closure Placement Notice",
            "content": "<p>Please note that if you select Side Part for a 5x5, 6x6, or 7x7 closure unit the closure itself will be constructed and positioned on the side rather than in the centre. Please ensure you are happy with this before placing your order.</p><p>If you would like your closure to remain positioned in the centre but simply styled with a side part, please select Middle Part and at checkout leave a note requesting a side part. This will allow the closure to be installed centrally while still achieving your desired look.</p><p>Please note that 9x6 closure units are always constructed with the closure positioned in the centre due to the larger closure size.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Shipping and Returns",
            "content": "<p>Once your order has been placed, you have 24 hours to contact us if you wish to make any amendments. After this period, your order will be processed and no further changes can be made.</p><p>Each unit is custom made to order. Please allow 7-15 working days for your unit to be made before dispatch.</p><p>Once your order has been shipped, delivery typically takes:</p><ul><li>Royal Mail Tracked 24 (Tracked and Signed)</li><li>Royal Mail Special Delivery (Covers parcel if lost): Next working day before 1pm.</li></ul><p>For full details, please refer to our <a href=\"/pages/shipping-returns\">Shipping &amp; Returns Policy</a>.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "How to Measure Your Head",
            "content": "<p>To ensure the best fit, we recommend measuring your head before selecting your wig size.</p><p>Using a soft measuring tape, start at the centre of your hairline and wrap the tape around your head, passing just above your ears and around the nape of your neck before bringing it back to the starting point.</p><p>This measurement is your head circumference and will help you choose the correct cap size for the most secure and comfortable fit.</p><p>Please note: We strongly recommend measuring your head accurately before placing your order. As all units are custom-made, we cannot accept responsibility for incorrect measurements provided by the customer and cap sizes cannot be changed once production has begun.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "International Orders",
            "content": "<p>For orders shipped outside of the United Kingdom, import duties, taxes and customs fees may apply once your parcel reaches its destination country. These charges are determined by your local customs authorities and are the responsibility of the customer.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "Disclaimer (Please Read)",
            "content": "<p><strong>Colour Disclaimer</strong></p><p>Every unit is unique. Slight variations in colour may occur. Please note that colours may appear differently depending on your device screen and lighting.</p><p><strong>Hair Length Disclaimer</strong></p><p>When selecting your desired hair length, please keep in mind that the final appearance will vary depending on how the hair is styled.</p><p>Curls may reduce the visible length by approximately 2-4 inches.</p><p>For example: If you would like your curled hair to appear approximately 22 inches long, we recommend selecting a straight hair length of 24-26 inches.</p><p>Please note that all hair lengths are measured when the hair is straight and fully stretched.</p><p><strong>Texture Disclaimer</strong></p><p>Please note that any unit displayed with a curled, loose wave or similar styled appearance has been heat styled. These looks are achieved by curling our straight hair and are intended to showcase the hair's versatility. This style is temporary and will gradually loosen over time, particularly after brushing or washing.</p><p>Once washed, the hair will return to its natural texture. The hair can be restyled using heat whenever desired.</p>"
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Maria",
            "length": "18\u2033",
            "lace_size": "5x5",
            "quote": "The lace melted so seamlessly I forgot it was a unit."
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Ava",
            "length": "14\u2033",
            "lace_size": "13x6",
            "quote": "Finally a wig that feels like it was made just for me."
          }
        },
        {
          "type": "client",
          "settings": {
            "name": "Beverley",
