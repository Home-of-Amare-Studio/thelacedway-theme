{% comment %}
  THELACEDWÁY client reviews
  Home of Amare Studio

  The live site pulls these from Judge.me's API. A theme cannot do that without
  putting an API token into public code, so each review is a block here instead.
  That also means you curate which ones show rather than taking whatever came in
  last, which is arguably better for a homepage.

  The row scrolls itself at a slow constant speed and pauses when you hover or
  touch it. The list is doubled so the loop has no visible seam.
{% endcomment %}

{%- liquid
  assign avg = section.settings.average
  assign whole = avg | divided_by: 10
  assign rem = avg | modulo: 10
-%}

<section class="tlw-reviews" id="tlw-reviews-{{ section.id }}">

  <header class="tlw-reviews__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tlw-label-caps tlw-reviews__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="tlw-reviews__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_summary -%}
      <div class="tlw-reviews__summary">
        <span class="tlw-stars" aria-label="{{ avg | divided_by: 10.0 }} out of 5">
          {%- assign half_index = whole | plus: 1 -%}
          {%- for i in (1..5) -%}
            {%- assign filled = false -%}
            {%- if i <= whole -%}
              {%- assign filled = true -%}
            {%- elsif i == half_index and rem >= 5 -%}
              {%- assign filled = true -%}
            {%- endif -%}
            <svg viewBox="0 0 24 24" width="16" height="16" class="tlw-star{% if filled %} is-on{% endif %}" aria-hidden="true">
              <path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.7 1.2 6.7L12 17.8 6.1 20.9l1.2-6.7L2.5 9.5l6.6-.9z"/>
            </svg>
          {%- endfor -%}
        </span>

        <span class="tlw-reviews__stat">
          {{ avg | divided_by: 10.0 }} {{ section.settings.average_word }}
          {%- if section.settings.count != blank -%}
            <span class="tlw-reviews__dot">·</span>{{ section.settings.count }} {{ section.settings.count_word }}
          {%- endif -%}
        </span>
      </div>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <div
      class="tlw-reviews__track"
      data-reviews-track
      data-speed="{{ section.settings.speed }}"
    >
      <div class="tlw-reviews__row" data-reviews-row>
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <figure class="tlw-review" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>

                {%- if block.settings.image != blank -%}
                  <div class="tlw-review__media">
                    {{ block.settings.image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        alt: '',
                        class: 'tlw-review__img',
                        draggable: 'false'
                    }}
                  </div>
                {%- endif -%}

                <div class="tlw-review__body">
                  <span class="tlw-stars" aria-label="{{ block.settings.rating }} out of 5">
                    {%- for i in (1..5) -%}
                      <svg viewBox="0 0 24 24" width="14" height="14" class="tlw-star{% if i <= block.settings.rating %} is-on{% endif %}" aria-hidden="true">
                        <path d="M12 2.5l2.9 6.1 6.6.9-4.8 4.7 1.2 6.7L12 17.8 6.1 20.9l1.2-6.7L2.5 9.5l6.6-.9z"/>
                      </svg>
                    {%- endfor -%}
                  </span>

                  {%- if block.settings.title != blank -%}
                    <p class="tlw-review__title">{{ block.settings.title }}</p>
                  {%- endif -%}

                  {%- if block.settings.quote != blank -%}
                    <blockquote class="tlw-review__quote">{{ block.settings.quote }}</blockquote>
                  {%- endif -%}

                  <figcaption class="tlw-review__foot">
                    {%- if block.settings.name != blank -%}
                      <span class="tlw-review__name">{{ block.settings.name }}</span>
                    {%- endif -%}

                    {%- if block.settings.meta != blank -%}
                      <span class="tlw-review__meta">{{ block.settings.meta }}</span>
                    {%- endif -%}

                    {%- if block.settings.verified -%}
                      <span class="tlw-review__verified">{{ section.settings.verified_text }}</span>
                    {%- endif -%}
                  </figcaption>
                </div>

              </figure>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>

<style>
  #tlw-reviews-{{ section.id }} {
    padding-block: 72px;
    background: var(--tlw-background);
    color: var(--tlw-primary);
  }

  @media (min-width: 900px) {
    #tlw-reviews-{{ section.id }} { padding-block: 110px; }
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__head {
    max-width: 900px;
    margin: 0 auto 44px;
    padding-inline: var(--tlw-margin);
    text-align: center;
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__eyebrow {
    color: var(--tlw-on-surface-variant);
    margin: 0 0 18px;
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__title {
    font-family: var(--tlw-font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.2;
    margin: 0 auto;
    max-width: 24ch;
  }

  @media (min-width: 768px) {
    #tlw-reviews-{{ section.id }} .tlw-reviews__title {
      font-size: 64px;
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1.1;
      max-width: none;
    }
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 22px;
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__stat {
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__dot { margin-inline: 8px; }

  #tlw-reviews-{{ section.id }} .tlw-stars {
    display: inline-flex;
    gap: 3px;
    line-height: 0;
  }

  #tlw-reviews-{{ section.id }} .tlw-star {
    fill: var(--tlw-outline-variant);
  }

  #tlw-reviews-{{ section.id }} .tlw-star.is-on {
    fill: var(--tlw-accent);
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__track {
    overflow-x: auto;
    padding-inline: var(--tlw-margin);
    padding-bottom: 8px;
    scrollbar-width: none;
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__track::-webkit-scrollbar { display: none; }

  @media (min-width: 768px) {
    #tlw-reviews-{{ section.id }} .tlw-reviews__track { padding-inline: 0; }
  }

  #tlw-reviews-{{ section.id }} .tlw-reviews__row {
    display: flex;
    gap: 24px;
    width: max-content;
  }

  #tlw-reviews-{{ section.id }} .tlw-review {
    display: flex;
    flex-direction: column;
    flex: 0 0 290px;
    margin: 0;
    border: 1px solid var(--tlw-outline-variant);
    background: var(--tlw-surface-lowest);
  }

  @media (min-width: 640px) {
    #tlw-reviews-{{ section.id }} .tlw-review { flex-basis: 340px; }
  }

  #tlw-reviews-{{ section.id }} .tlw-review__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-bottom: 1px solid var(--tlw-outline-variant);
    background: var(--tlw-surface-container);
  }

  #tlw-reviews-{{ section.id }} .tlw-review__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 28px;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__title {
    margin: 16px 0 0;
    font-family: var(--tlw-font-display);
    font-size: 22px;
    line-height: 1.2;
    text-transform: uppercase;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__quote {
    margin: 12px 0 0;
    font-size: 16px;
    font-weight: 300;
    line-height: 1.65;
    color: var(--tlw-on-surface-variant);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__foot {
    margin-top: auto;
    padding-top: 16px;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__name {
    display: block;
    padding-top: 16px;
    border-top: 1px solid var(--tlw-outline-variant);
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__meta {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--tlw-on-surface-variant);
    opacity: 0.75;
  }

  #tlw-reviews-{{ section.id }} .tlw-review__verified {
    display: inline-block;
    margin-top: 10px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-reviews-{{ section.id }}');
    if (!root) return;

    var track = root.querySelector('[data-reviews-track]');
    var row = root.querySelector('[data-reviews-row]');
    if (!track || !row) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var speed = parseFloat(track.dataset.speed) || 28;
    var paused = false;
    var last = performance.now();

    function step(now) {
      var dt = now - last;
      last = now;

      if (!paused) {
        track.scrollLeft += (dt / 1000) * speed;
        /* The list is rendered twice, so jumping back by half is invisible. */
        var half = row.scrollWidth / 2;
        if (half > 0 && track.scrollLeft >= half) track.scrollLeft -= half;
      }

      window.requestAnimationFrame(step);
    }

    window.requestAnimationFrame(step);

    function hold() { paused = true; }
    function release() { paused = false; last = performance.now(); }

    track.addEventListener('mouseenter', hold);
    track.addEventListener('mouseleave', release);
    track.addEventListener('touchstart', hold, { passive: true });
    track.addEventListener('touchend', release, { passive: true });
    track.addEventListener('focusin', hold);
    track.addEventListener('focusout', release);
  })();
</script>

{% schema %}
{
  "name": "TLW Reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Client reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn, loved, reviewed"
    },
    {
      "type": "header",
      "content": "Summary line"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show the stars and totals",
      "default": true
    },
    {
      "type": "range",
      "id": "average",
      "label": "Average rating",
      "info": "In tenths, so 50 means 5.0 and 48 means 4.8. Check the real figure in Judge.me.",
      "min": 10,
      "max": 50,
      "step": 1,
      "default": 50
    },
    {
      "type": "text",
      "id": "average_word",
      "label": "Word after the average",
      "default": "average"
    },
    {
      "type": "text",
      "id": "count",
      "label": "How many reviews",
      "info": "Check the real figure in Judge.me and update it now and then. Leave empty to hide it.",
      "default": "41"
    },
    {
      "type": "text",
      "id": "count_word",
      "label": "Word after the count",
      "default": "reviews"
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "info": "Pixels per second. It pauses while you hover or touch it.",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 28
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified buyer wording",
      "default": "Verified buyer"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo",
          "info": "Optional. Cards without one start at the stars."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Headline",
          "info": "Shown in caps. Two lines at most."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "info": "Five lines at most before it trims"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Product and date",
          "info": "For example: Monroe · December 2023"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TLW Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}