{% comment %}
  THELACEDWÁY scroll target
  Home of Amare Studio

  An invisible marker. Place it above the collections section on the
  homepage (it also finds that section by its heading). Clicking a link with the matching text (default "Shop all collections")
  then glides down to this spot instead of opening another page. A link whose
  address is #tlw-collections does the same. Several phrases can be listed, separated by commas.
{% endcomment %}

<div
  class="tlw-scroll-target"
  id="tlw-collections"
  data-tlw-scroll-target
  data-label="{{ section.settings.link_text | escape }}"
  data-heading="{{ section.settings.heading_text | escape }}"
  data-offset="{{ section.settings.top_space }}"
  aria-hidden="true"
></div>

<style>
  .tlw-scroll-target {
    display: block;
    height: 0;
    margin: 0;
    padding: 0;
  }
</style>

<script>
  (function () {
    /* the theme editor re-runs this script when the section is edited: remove the old listener first */
    if (window.tlwScrollTarget && window.tlwScrollTarget.destroy) window.tlwScrollTarget.destroy();

    var target = document.querySelector('[data-tlw-scroll-target]');
    if (!target) return;

    function norm(text) {
      return String(text || '').replace(/\s+/g, ' ').trim().toLowerCase();
    }

    /* one or more phrases, separated by commas, e.g. "Shop all collections, Shop the collections" */
    var labels = String(target.getAttribute('data-label') || '')
      .split(',')
      .map(norm)
      .filter(Boolean);
    var offset = parseInt(target.getAttribute('data-offset'), 10) || 0;
    var headingText = norm(target.getAttribute('data-heading'));

    /* The section to land on: the one whose heading matches (wherever this marker sits),
       otherwise the marker itself. Headings inside the header, footer or menus are ignored. */
    function findDestination() {
      if (headingText) {
        var nodes = document.querySelectorAll('h1, h2, h3, h4, h5, h6, p, span, div');
        for (var i = 0; i < nodes.length; i++) {
          var node = nodes[i];
          if (norm(node.textContent) !== headingText) continue;
          if (node.closest('header, footer, nav, [role="navigation"], a, button')) continue;
          return node.closest('.shopify-section') || node;
        }
      }
      return target;
    }

    function scrollToTarget() {
      var destination = findDestination();
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      destination.style.scrollMarginTop = offset + 'px';
      destination.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }

    function onClick(e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var link = e.target.closest ? e.target.closest('a[href]') : null;
      if (!link || link.hasAttribute('data-tlw-no-scroll')) return;

      var href = link.getAttribute('href') || '';
      var text = norm(link.textContent);
      var isAnchor = href === '#tlw-collections' || href === '#collections';
      var isLabel = text.length < 80 && labels.some(function (phrase) { return text.indexOf(phrase) !== -1; });
      if (!isAnchor && !isLabel) return;

      e.preventDefault();
      e.stopImmediatePropagation();
      scrollToTarget();
    }

    document.addEventListener('click', onClick, true);

    window.tlwScrollTarget = {
      scroll: scrollToTarget,
      destroy: function () {
        document.removeEventListener('click', onClick, true);
        window.tlwScrollTarget = null;
      }
    };
  })();
</script>

{% schema %}
{
  "name": "TLW Scroll target",
  "tag": "div",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Scroll here when a link with this text is clicked",
      "info": "Any link whose text contains this glides to this spot instead of opening a page. Separate several phrases with commas.",
      "default": "Shop all collections, Shop the collections"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Glide down to the section headed",
      "info": "The heading of the collections section. It is found by this wording wherever this marker sits. Leave empty to glide to this marker instead.",
      "default": "The Collections"
    },
    {
      "type": "range",
      "id": "top_space",
      "label": "Space kept above (for the sticky header)",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "TLW Scroll target"
    }
  ]
}
{% endschema %}
