{% comment %}
  THELACEDWÁY header
  Home of Amare Studio

  Split navigation with the logo in the middle. Two Shopify menus feed it, one
  for the left side and one for the right, so Destinee edits them under
  Content > Menus like any other navigation.

  Any menu item with children becomes a dropdown automatically.
{% endcomment %}

{%- liquid
  assign left = section.settings.menu_left
  assign right = section.settings.menu_right
-%}

<header
  class="tlw-header{% if section.settings.overlay_first %} tlw-header--overlay{% endif %}"
  id="tlw-header-{{ section.id }}"
  data-tlw-header
  {% if section.settings.overlay_first %}data-overlay{% endif %}
>
  <div class="tlw-header__inner">

    {% comment %} Mobile: hamburger {% endcomment %}
    <button
      type="button"
      class="tlw-header__burger"
      data-menu-toggle
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

    {% comment %} Desktop: left menu {% endcomment %}
    <nav class="tlw-header__nav tlw-header__nav--left" aria-label="Main">
      {%- for link in left.links -%}
        <div class="tlw-nav__item{% if link.links.size > 0 %} has-children{% endif %}">
          <a
            class="tlw-nav__link"
            href="{{ link.url }}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
            {%- if link.links.size > 0 -%}
              <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            {%- endif -%}
          </a>

          {%- if link.links.size > 0 -%}
            <div class="tlw-nav__drop">
              {%- for child in link.links -%}
                <a class="tlw-nav__droplink" href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    {% comment %} Logo {% endcomment %}
    <div class="tlw-header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo_light != blank -%}
          {{ section.settings.logo_light
            | image_url: width: 600
            | image_tag: loading: 'eager', alt: shop.name, class: 'tlw-header__logo--light'
          }}
        {%- endif -%}
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo
            | image_url: width: 600
            | image_tag: loading: 'eager', alt: shop.name, class: 'tlw-header__logo--dark'
          }}
        {%- else -%}
          <span class="tlw-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {% comment %} Desktop: right menu {% endcomment %}
    <nav class="tlw-header__nav tlw-header__nav--right" aria-label="Secondary">
      {%- for link in right.links -%}
        <div class="tlw-nav__item{% if link.links.size > 0 %} has-children{% endif %}">
          <a
            class="tlw-nav__link"
            href="{{ link.url }}"
            {% if link.active %}aria-current="page"{% endif %}
          >
            {{ link.title }}
            {%- if link.links.size > 0 -%}
              <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            {%- endif -%}
          </a>

          {%- if link.links.size > 0 -%}
            <div class="tlw-nav__drop">
              {%- for child in link.links -%}
                <a class="tlw-nav__droplink" href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    {% comment %} Cart {% endcomment %}
    <a class="tlw-header__cart" href="{{ routes.cart_url }}" aria-label="Bag">
      <svg viewBox="0 0 22 24" width="22" height="24" aria-hidden="true">
        <path d="M2 7h18v15a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7z" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M7 8V5.5a4 4 0 0 1 8 0V8" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="tlw-header__count" data-cart-count>{{ cart.item_count }}</span>
    </a>

  </div>
</header>

{% comment %} Mobile drawer {% endcomment %}
<div class="tlw-drawer" data-menu-drawer hidden>
  <div class="tlw-drawer__panel">
    <button type="button" class="tlw-drawer__close" data-menu-close aria-label="Close menu">&times;</button>

    <nav class="tlw-drawer__nav">
      {%- for list in left.links -%}
        <a class="tlw-drawer__link" href="{{ list.url }}">{{ list.title }}</a>
        {%- for child in list.links -%}
          <a class="tlw-drawer__sublink" href="{{ child.url }}">{{ child.title }}</a>
        {%- endfor -%}
      {%- endfor -%}

      {%- for list in right.links -%}
        <a class="tlw-drawer__link" href="{{ list.url }}">{{ list.title }}</a>
        {%- for child in list.links -%}
          <a class="tlw-drawer__sublink" href="{{ child.url }}">{{ child.title }}</a>
        {%- endfor -%}
      {%- endfor -%}
    </nav>
  </div>
</div>

<style>
  #tlw-header-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 255, 255, {{ section.settings.opacity | divided_by: 100.0 }});
    {% if section.settings.blur %}backdrop-filter: blur(14px);{% endif %}
    {% if section.settings.show_border %}border-bottom: 1px solid var(--tlw-outline-variant);{% endif %}
    transition: background-color 350ms ease, border-color 350ms ease;
  }

  /* Horizon wraps the header group in #header-group, and that wrapper keeps
     its height even when the header inside it floats. Collapse it so the hero
     starts at the very top of the page. */
  #header-group:has(#tlw-header-{{ section.id }}.tlw-header--overlay) {
    height: 0;
    overflow: visible;
  }

  /* Sits over the hero: no bar, white content, nothing behind it. */
  #tlw-header-{{ section.id }}.tlw-header--overlay {
    top: 0;
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-nav__link,
  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__cart,
  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__wordmark {
    color: #fff;
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__burger span {
    background: #fff;
  }

  {% if section.settings.logo_light != blank %}
    #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__logo--dark { display: none; }
    #tlw-header-{{ section.id }} .tlw-header__logo--light { display: none; }
    #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__logo--light { display: block; }
  {% endif %}

  /* Scrolled past the hero: solid bar again. */
  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid {
    background: rgba(255, 255, 255, {{ section.settings.opacity | divided_by: 100.0 }});
    {% if section.settings.blur %}backdrop-filter: blur(14px);{% endif %}
    {% if section.settings.show_border %}border-bottom-color: var(--tlw-outline-variant);{% endif %}
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-nav__link,
  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__cart,
  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__wordmark {
    color: var(--tlw-primary);
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__burger span {
    background: var(--tlw-primary);
  }

  {% if section.settings.logo_light != blank %}
    #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__logo--light { display: none; }
    #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__logo--dark { display: block; }
  {% endif %}

  #tlw-header-{{ section.id }} .tlw-header__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px var(--tlw-margin);
    min-height: {{ section.settings.height }}px;
  }

  #tlw-header-{{ section.id }} .tlw-header__nav {
    display: none;
    flex: 1;
    align-items: center;
    gap: {{ section.settings.link_gap }}px;
  }

  #tlw-header-{{ section.id }} .tlw-header__nav--right {
    justify-content: flex-end;
  }

  #tlw-header-{{ section.id }} .tlw-header__logo {
    flex: 0 0 auto;
    margin-inline: auto;
  }

  #tlw-header-{{ section.id }} .tlw-header__logo img {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 46vw;
    height: auto;
  }

  #tlw-header-{{ section.id }} .tlw-header__wordmark {
    font-family: var(--tlw-font-display);
    font-size: 22px;
    letter-spacing: 0.02em;
    color: var(--tlw-accent);
  }

  #tlw-header-{{ section.id }} .tlw-nav__item {
    position: relative;
  }

  #tlw-header-{{ section.id }} .tlw-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 0;
    font-size: {{ section.settings.link_size }}px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--tlw-primary);
    white-space: nowrap;
    transition: color 250ms ease;
  }

  #tlw-header-{{ section.id }} .tlw-nav__link:hover {
    color: var(--tlw-accent);
  }

  #tlw-header-{{ section.id }} .tlw-nav__drop {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: 10px 0;
    background: var(--tlw-surface-lowest);
    border: 1px solid var(--tlw-outline-variant);
    border-radius: var(--tlw-radius);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms;
    z-index: 5;
  }

  #tlw-header-{{ section.id }} .tlw-header__nav--right .tlw-nav__drop {
    left: auto;
    right: 0;
  }

  @media (hover: hover) {
    #tlw-header-{{ section.id }} .tlw-nav__item:hover .tlw-nav__drop {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  #tlw-header-{{ section.id }} .tlw-nav__item.is-open .tlw-nav__drop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #tlw-header-{{ section.id }} .tlw-nav__droplink {
    display: block;
    padding: 10px 20px;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    white-space: nowrap;
  }

  #tlw-header-{{ section.id }} .tlw-nav__droplink:hover {
    background: var(--tlw-surface-container-low);
    color: var(--tlw-accent);
  }

  #tlw-header-{{ section.id }} .tlw-header__cart {
    position: relative;
    flex: 0 0 auto;
    color: var(--tlw-primary);
    display: inline-flex;
  }

  #tlw-header-{{ section.id }} .tlw-header__count {
    position: absolute;
    top: -4px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: var(--tlw-accent);
    color: #fff;
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    border-radius: var(--tlw-radius);
  }

  #tlw-header-{{ section.id }} .tlw-header__burger {
    flex: 0 0 auto;
    width: 26px;
    height: 20px;
    padding: 0;
    background: none;
    border: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #tlw-header-{{ section.id }} .tlw-header__burger span {
    display: block;
    height: 1.5px;
    background: var(--tlw-primary);
  }

  /* Mobile: logo left, burger and bag together on the right */
  #tlw-header-{{ section.id }} .tlw-header__logo { order: 1; margin-inline: 0 auto; }
  #tlw-header-{{ section.id }} .tlw-header__burger { order: 2; }
  #tlw-header-{{ section.id }} .tlw-header__cart { order: 3; }

  @media (min-width: 1100px) {
    #tlw-header-{{ section.id }} .tlw-header__burger { display: none; }
    #tlw-header-{{ section.id }} .tlw-header__nav { display: flex; }
    #tlw-header-{{ section.id }} .tlw-header__inner { position: relative; }
    #tlw-header-{{ section.id }} .tlw-header__logo {
      order: 0;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      margin-inline: 0;
    }
    #tlw-header-{{ section.id }} .tlw-header__cart { order: 0; }
  }

  /* Mobile drawer */
  .tlw-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.4);
  }

  .tlw-drawer[hidden] { display: none; }

  .tlw-drawer__panel {
    width: min(88vw, 380px);
    height: 100%;
    background: var(--tlw-surface-lowest);
    padding: 28px 26px;
    overflow-y: auto;
  }

  .tlw-drawer__close {
    background: none;
    border: 0;
    font-size: 30px;
    line-height: 1;
    color: var(--tlw-primary);
    padding: 0;
    margin-bottom: 24px;
  }

  .tlw-drawer__nav { display: flex; flex-direction: column; }

  .tlw-drawer__link {
    padding: 14px 0;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
    border-bottom: 1px solid var(--tlw-outline-variant);
    color: var(--tlw-primary);
  }

  .tlw-drawer__sublink {
    padding: 11px 0 11px 18px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--tlw-on-surface-variant);
    border-bottom: 1px solid var(--tlw-outline-variant);
  }
</style>

<script>
  (function () {
    var header = document.getElementById('tlw-header-{{ section.id }}');
    if (!header) return;

    var drawer = document.querySelector('[data-menu-drawer]');
    var toggle = header.querySelector('[data-menu-toggle]');
    var close = drawer && drawer.querySelector('[data-menu-close]');

    function open() {
      if (!drawer) return;
      drawer.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function shut() {
      if (!drawer) return;
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    if (toggle) toggle.addEventListener('click', open);
    if (close) close.addEventListener('click', shut);
    if (drawer) {
      drawer.addEventListener('click', function (e) {
        if (e.target === drawer) shut();
      });
    }
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') shut();
    });

    /* Touch devices have no hover, so tapping a parent opens its dropdown
       once rather than following the link straight away. */
    header.querySelectorAll('.tlw-nav__item.has-children > .tlw-nav__link').forEach(function (link) {
      link.addEventListener('click', function (e) {
        if (window.matchMedia('(hover: hover)').matches) return;
        var item = link.parentElement;
        if (!item.classList.contains('is-open')) {
          e.preventDefault();
          header.querySelectorAll('.tlw-nav__item.is-open').forEach(function (o) {
            o.classList.remove('is-open');
          });
          item.classList.add('is-open');
        }
      });
    });

    /* Overlay mode: swap to a solid bar once the hero is behind us */
    if (header.hasAttribute('data-overlay')) {
      var trigger = function () {
        var first = header.parentElement.nextElementSibling;
        return first ? Math.max(first.offsetHeight - header.offsetHeight, 60) : 60;
      };

      var onScroll = function () {
        header.classList.toggle('is-solid', window.scrollY > trigger());
      };

      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    }

    /* Tell the rest of the theme how tall the bar is, and whether it
       reserves space or floats over the first section. */
    function publishHeight() {
      var overlaid = header.hasAttribute('data-overlay');
      document.documentElement.style.setProperty(
        '--tlw-header-h',
        (overlaid ? 0 : header.offsetHeight) + 'px'
      );
    }
    publishHeight();
    window.addEventListener('resize', publishHeight);

    /* Keep the bag count fresh after an add to cart */
    document.addEventListener('cart:refresh', function () {
      fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          var el = header.querySelector('[data-cart-count]');
          if (el) el.textContent = c.item_count;
        })
        .catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "TLW Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Left menu",
      "info": "Edit under Content > Menus. Items with sub-items become dropdowns.",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Right menu"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use the gold version for the header"
    },
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "White logo",
      "info": "Used while the header sits over the hero. Falls back to the main logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "overlay_first",
      "label": "Sit over the hero",
      "info": "No bar at the top of the page, white text over the video. Turns into a solid bar once you scroll past.",
      "default": true
    },
    {
      "type": "range",
      "id": "height",
      "label": "Bar height",
      "min": 64,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Background opacity",
      "info": "Lower it to let the hero show through",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "blur",
      "label": "Blur what is behind the bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Line under the bar",
      "default": true
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Menu text size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Space between menu items",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [{ "name": "TLW Header" }]
}
{% endschema %}