{% comment %}
  THELACEDWÁY header
  Home of Amare Studio

  Split navigation with the logo in the middle. Two Shopify menus feed it, one
  for the left side and one for the right, so Destinee edits them under
  Content > Menus like any other navigation.

  The transparent, hide-until-scroll "over the hero" treatment is homepage
  only, matching src/components/HomePage.tsx passing <SiteNav overlay /> —
  every other page used plain <SiteNav />, a normal solid sticky bar that's
  visible immediately. That's driven automatically by the template here
  (template.name == 'index'), not a setting, since no other page should ever
  want the hero treatment.

  Any menu item with children becomes a dropdown automatically.

  Phone menu: the hamburger turns into an X and the menu drops down under the
  header. Items with sub-items show a chevron and open with a tap, one at a
  time, so the list stays short.
{% endcomment %}

{%- liquid
  assign left = section.settings.menu_left
  assign right = section.settings.menu_right
  assign is_home = false
  if template.name == 'index'
    assign is_home = true
  endif
-%}

<header
  class="tlw-header{% if is_home %} tlw-header--overlay{% endif %}"
  id="tlw-header-{{ section.id }}"
  data-tlw-header
  {% if is_home %}data-overlay{% endif %}
>
  <div class="tlw-header__inner">

    {% comment %} Mobile: hamburger {% endcomment %}
    <button
      type="button"
      class="tlw-header__burger"
      data-menu-toggle
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>

    {% comment %} Desktop: left menu {% endcomment %}
    <nav class="tlw-header__nav tlw-header__nav--left" aria-label="Main">
      {%- for link in left.links -%}
        <div class="tlw-nav__item{% if link.links.size > 0 %} has-children{% endif %}">
          {%- if link.links.size > 0 -%}
            <button type="button" class="tlw-nav__link" aria-expanded="false" aria-haspopup="true">
              {{ link.title }}
              <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </button>
      {%- else -%}
            <a class="tlw-nav__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}

          {%- if link.links.size > 0 -%}
            <div class="tlw-nav__drop">
              {%- for child in link.links -%}
                <a class="tlw-nav__droplink" href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    {% comment %} Logo {% endcomment %}
    <div class="tlw-header__logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo_light != blank -%}
          {{ section.settings.logo_light
            | image_url: width: 600
            | image_tag: loading: 'eager', alt: shop.name, class: 'tlw-header__logo--light'
          }}
        {%- endif -%}
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo
            | image_url: width: 600
            | image_tag: loading: 'eager', alt: shop.name, class: 'tlw-header__logo--dark'
          }}
        {%- else -%}
          <span class="tlw-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {% comment %} Desktop: right menu {% endcomment %}
    <nav class="tlw-header__nav tlw-header__nav--right" aria-label="Secondary">
      {%- for link in right.links -%}
        <div class="tlw-nav__item{% if link.links.size > 0 %} has-children{% endif %}">
          {%- if link.links.size > 0 -%}
            <button type="button" class="tlw-nav__link" aria-expanded="false" aria-haspopup="true">
              {{ link.title }}
              <svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </button>
    {%- else -%}
            <a class="tlw-nav__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          {%- endif -%}

          {%- if link.links.size > 0 -%}
            <div class="tlw-nav__drop">
              {%- for child in link.links -%}
                <a class="tlw-nav__droplink" href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    {% comment %} Cart {% endcomment %}
    <a class="tlw-header__cart" href="{{ routes.cart_url }}" aria-label="Bag">
      <svg viewBox="0 0 22 24" width="22" height="24" aria-hidden="true">
        <path d="M2 7h18v15a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7z" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M7 8V5.5a4 4 0 0 1 8 0V8" fill="none" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="tlw-header__count" data-cart-count>{{ cart.item_count }}</span>
    </a>

  </div>
</header>

{% comment %}
  Phone menu. Drops down under the header. A row that has sub-items is a button
  with a chevron; tapping it opens its list. Rows without sub-items are plain links.
{% endcomment %}
<div class="tlw-drawer" data-menu-drawer hidden>
  <div class="tlw-drawer__panel">
    <nav class="tlw-drawer__nav" aria-label="Menu">

      {%- for list in left.links -%}
        {%- if list.links.size > 0 -%}
          <div class="tlw-drawer__group">
            <button type="button" class="tlw-drawer__link tlw-drawer__link--parent" data-drawer-toggle aria-expanded="false" aria-controls="tlw-sub-{{ section.id }}-l{{ forloop.index }}">
              <span>{{ list.title }}</span>
              <svg class="tlw-drawer__chev" viewBox="0 0 8 12" width="8" height="12" aria-hidden="true"><path d="M1 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            </button>
            <div class="tlw-drawer__sub" id="tlw-sub-{{ section.id }}-l{{ forloop.index }}">
              {%- if section.settings.drawer_view_all and list.url != blank and list.url != '#' -%}
                <a class="tlw-drawer__sublink" href="{{ list.url }}">All {{ list.title }}</a>
              {%- endif -%}
              {%- for child in list.links -%}
                <a class="tlw-drawer__sublink" href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a class="tlw-drawer__link" href="{{ list.url }}">{{ list.title }}</a>
        {%- endif -%}
      {%- endfor -%}

      {%- for list in right.links -%}
        {%- if list.links.size > 0 -%}
          <div class="tlw-drawer__group">
            <button type="button" class="tlw-drawer__link tlw-drawer__link--parent" data-drawer-toggle aria-expanded="false" aria-controls="tlw-sub-{{ section.id }}-r{{ forloop.index }}">
              <span>{{ list.title }}</span>
              <svg class="tlw-drawer__chev" viewBox="0 0 8 12" width="8" height="12" aria-hidden="true"><path d="M1 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            </button>
            <div class="tlw-drawer__sub" id="tlw-sub-{{ section.id }}-r{{ forloop.index }}">
              {%- if section.settings.drawer_view_all and list.url != blank and list.url != '#' -%}
                <a class="tlw-drawer__sublink" href="{{ list.url }}">All {{ list.title }}</a>
              {%- endif -%}
              {%- for child in list.links -%}
                <a class="tlw-drawer__sublink" href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a class="tlw-drawer__link" href="{{ list.url }}">{{ list.title }}</a>
        {%- endif -%}
      {%- endfor -%}

    </nav>
  </div>
</div>

<style>
  #tlw-header-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(255, 255, 255, {{ section.settings.opacity | divided_by: 100.0 }});
    {% if section.settings.blur %}backdrop-filter: blur(14px);{% endif %}
    {% if section.settings.show_border %}border-bottom: 1px solid var(--tlw-outline-variant);{% endif %}
    transition: background-color 350ms ease, border-color 350ms ease;
  }

  /* Horizon's own #header-group wrapper can clip a position:sticky header if
     it sets any overflow other than visible — sticky silently stops working
     the moment an ancestor clips overflow. This must apply on every page,
     not just the homepage, or the header scrolls away instead of sticking. */
  #header-group {
    overflow: visible;
  }

  /* Homepage only: the header floats fully over the hero, so the group's
     own height needs collapsing too, or it leaves a gap where the header
     would otherwise have reserved space. */
  #header-group:has(#tlw-header-{{ section.id }}.tlw-header--overlay) {
    height: 0;
  }

  /* Sits over the hero: no bar, white content, nothing behind it. */
  #tlw-header-{{ section.id }}.tlw-header--overlay {
    top: 0;
    transition: background-color 350ms ease, border-color 350ms ease,
                opacity 350ms ease, transform 350ms ease;
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-nav__link,
  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__cart,
  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__wordmark {
    color: #fff;
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__burger span {
    background: #fff;
  }

  {% if section.settings.logo_light != blank %}
    #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__logo--dark { display: none; }
    #tlw-header-{{ section.id }} .tlw-header__logo--light { display: none !important; }
    #tlw-header-{{ section.id }}.tlw-header--overlay .tlw-header__logo--light { display: block !important; }
  {% endif %}

  {% if section.settings.hide_until_scroll %}
  /* Hidden entirely at the top of the page, slides in once you scroll. */
  #tlw-header-{{ section.id }}.tlw-header--overlay {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
    transition: transform 400ms ease, opacity 300ms ease, background-color 350ms ease;
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  {% endif %}

  {% if section.settings.top_behaviour == 'hide' %}
    /* Reveal position is driven by scroll in JS (see script below), but a
       short transition here smooths the gap between scroll-event frames so
       it reads as fluid motion rather than a series of small steps. Keep
       this well under the JS reveal_distance duration, or it'll visibly lag
       behind the scroll instead of following it. */
    #tlw-header-{{ section.id }}.tlw-header--overlay {
      opacity: 0;
      transform: translateY(-100%);
      pointer-events: none;
      transition: background-color 350ms ease, border-color 350ms ease,
                  opacity 160ms ease-out, transform 160ms ease-out;
    }

    #tlw-header-{{ section.id }}.tlw-header--overlay.is-visible {
      pointer-events: auto;
    }
  {% endif %}

  /* Scrolled past the hero: solid bar again. */
  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid {
    background: rgba(255, 255, 255, {{ section.settings.opacity | divided_by: 100.0 }});
    {% if section.settings.blur %}backdrop-filter: blur(14px);{% endif %}
    {% if section.settings.show_border %}border-bottom-color: var(--tlw-outline-variant);{% endif %}
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-nav__link,
  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__cart,
  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__wordmark {
    color: var(--tlw-primary);
  }

  #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__burger span {
    background: var(--tlw-primary);
  }

  {% if section.settings.logo_light != blank %}
    #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__logo--light { display: none !important; }
    #tlw-header-{{ section.id }}.tlw-header--overlay.is-solid .tlw-header__logo--dark { display: block; }
  {% endif %}

  /* Phone menu open: the bar is always solid and fully visible, even over the hero */
  #tlw-header-{{ section.id }}.is-menu-open {
    opacity: 1 !important;
    transform: none !important;
    pointer-events: auto !important;
    background: #fff !important;
    backdrop-filter: none !important;
    {% if section.settings.show_border %}border-bottom-color: var(--tlw-outline-variant) !important;{% endif %}
  }

  #tlw-header-{{ section.id }}.is-menu-open .tlw-nav__link,
  #tlw-header-{{ section.id }}.is-menu-open .tlw-header__cart,
  #tlw-header-{{ section.id }}.is-menu-open .tlw-header__wordmark {
    color: var(--tlw-primary) !important;
  }

  #tlw-header-{{ section.id }}.is-menu-open .tlw-header__burger span {
    background: var(--tlw-primary) !important;
  }

  {% if section.settings.logo_light != blank %}
    #tlw-header-{{ section.id }}.is-menu-open .tlw-header__logo--light { display: none !important; }
    #tlw-header-{{ section.id }}.is-menu-open .tlw-header__logo--dark { display: block !important; }
  {% endif %}

  #tlw-header-{{ section.id }} .tlw-header__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px var(--tlw-margin);
    min-height: {{ section.settings.height }}px;
  }

  #tlw-header-{{ section.id }} .tlw-header__nav {
    display: none;
    flex: 1;
    align-items: center;
    gap: {{ section.settings.link_gap }}px;
  }

  #tlw-header-{{ section.id }} .tlw-header__nav--right {
    justify-content: flex-end;
  }

  #tlw-header-{{ section.id }} .tlw-header__logo {
    flex: 0 0 auto;
    margin-inline: auto;
  }

  #tlw-header-{{ section.id }} .tlw-header__logo img {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 46vw;
    height: auto;
  }

  #tlw-header-{{ section.id }} .tlw-header__wordmark {
    font-family: var(--tlw-font-display);
    font-size: 22px;
    letter-spacing: 0.02em;
    color: var(--tlw-accent);
  }

  #tlw-header-{{ section.id }} .tlw-nav__item {
    position: relative;
  }

  #tlw-header-{{ section.id }} .tlw-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 0;
    font-family: inherit;
    font-size: {{ section.settings.link_size }}px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: {{ section.settings.link_weight }};
    color: var(--tlw-primary);
    white-space: nowrap;
    background: none;
    border: none;
    margin: 0;
    cursor: pointer;
    transition: color 250ms ease;
  }

  #tlw-header-{{ section.id }} .tlw-nav__link:hover {
    color: var(--tlw-accent);
  }

  #tlw-header-{{ section.id }} .tlw-nav__link::after {
    content: "";
    position: absolute;
    width: 0;
    height: 1px;
    bottom: 7px;
    left: 0;
    background-color: currentColor;
    transition: width 0.3s ease;
  }

  #tlw-header-{{ section.id }} .tlw-nav__link:hover::after {
    width: 100%;
  }

  #tlw-header-{{ section.id }} .tlw-nav__drop {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    padding: 10px 0;
    background: var(--tlw-surface-lowest);
    border: 1px solid var(--tlw-outline-variant);
    border-radius: var(--tlw-radius);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms;
    z-index: 5;
  }

  #tlw-header-{{ section.id }} .tlw-header__nav--right .tlw-nav__drop {
    left: auto;
    right: 0;
  }

  @media (hover: hover) {
    #tlw-header-{{ section.id }} .tlw-nav__item:hover .tlw-nav__drop {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  #tlw-header-{{ section.id }} .tlw-nav__item.is-open .tlw-nav__drop {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #tlw-header-{{ section.id }} .tlw-nav__droplink {
    display: block;
    padding: 10px 20px;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    white-space: nowrap;
  }

  #tlw-header-{{ section.id }} .tlw-nav__droplink:hover {
    color: var(--tlw-accent);
  }

  #tlw-header-{{ section.id }} .tlw-header__cart {
    position: relative;
    flex: 0 0 auto;
    color: var(--tlw-primary);
    display: inline-flex;
  }

  #tlw-header-{{ section.id }} .tlw-header__count {
    position: absolute;
    top: -4px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    background: var(--tlw-accent);
    color: #fff;
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    border-radius: var(--tlw-radius);
  }

  #tlw-header-{{ section.id }} .tlw-header__burger {
    flex: 0 0 auto;
    width: 26px;
    height: 20px;
    padding: 0;
    background: none;
    border: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #tlw-header-{{ section.id }} .tlw-header__burger span {
    display: block;
    height: 1.5px;
    background: var(--tlw-primary);
    transition: transform 250ms ease, opacity 200ms ease;
  }

  /* The hamburger turns into an X while the phone menu is open */
  #tlw-header-{{ section.id }} .tlw-header__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(9.25px) rotate(45deg);
  }

  #tlw-header-{{ section.id }} .tlw-header__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  #tlw-header-{{ section.id }} .tlw-header__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-9.25px) rotate(-45deg);
  }

  /* Mobile: logo left, burger and bag together on the right */
  #tlw-header-{{ section.id }} .tlw-header__logo { order: 1; margin-inline: 0 auto; }
  #tlw-header-{{ section.id }} .tlw-header__burger { order: 2; }
  #tlw-header-{{ section.id }} .tlw-header__cart { order: 3; }

   @media (min-width: 1600px) {
    #tlw-header-{{ section.id }} .tlw-header__burger { display: none; }
    #tlw-header-{{ section.id }} .tlw-header__nav { display: flex; }
    #tlw-header-{{ section.id }} .tlw-header__inner { position: relative; }
    #tlw-header-{{ section.id }} .tlw-header__logo {
      order: 0;
      position: absolute;
      left: 50%;
      transform: translateX(calc(-50% + {{ section.settings.logo_nudge }}px));
      margin-inline: 0;
    }
    #tlw-header-{{ section.id }} .tlw-header__cart { order: 0; }
    .tlw-drawer { display: none !important; }
  }

  /* Phone menu: drops down under the header (its top edge is set by the script) */
  .tlw-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 58;
    background: rgba(0, 0, 0, 0.35);
  }

  .tlw-drawer[hidden] { display: none; }

  .tlw-drawer__panel {
    max-height: 100%;
    overflow-y: auto;
    padding: 6px 18px 28px;
    background: var(--tlw-surface-lowest, #fff);
    border-bottom: 1px solid var(--tlw-outline-variant);
    -webkit-overflow-scrolling: touch;
  }

  .tlw-drawer__nav { display: flex; flex-direction: column; }

  .tlw-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 16px 0;
    border: 0;
    border-bottom: 1px solid var(--tlw-outline-variant);
    border-radius: 0;
    background: none;
    font-family: inherit;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: left;
    font-weight: 400;
    color: var(--tlw-primary);
    text-decoration: none;
    cursor: pointer;
  }

  .tlw-drawer__chev {
    flex: 0 0 auto;
    color: var(--tlw-primary);
    transition: transform 250ms ease;
  }

  .tlw-drawer__group.is-open > .tlw-drawer__link .tlw-drawer__chev {
    transform: rotate(90deg);
  }

  /* Sub-items: closed until their row is tapped. The script sets the open height. */
  .tlw-drawer__sub {
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: max-height 320ms ease, visibility 0s linear 320ms;
  }

  .tlw-drawer__group.is-open > .tlw-drawer__sub {
    visibility: visible;
    transition: max-height 320ms ease;
  }

  .tlw-drawer__sublink {
    display: block;
    padding: 13px 0 13px 18px;
    font-size: 13px;
    letter-spacing: 0.08em;
    color: var(--tlw-on-surface-variant);
    text-decoration: none;
    border-bottom: 1px solid var(--tlw-outline-variant);
  }
</style>

<script>
  (function () {
    var header = document.getElementById('tlw-header-{{ section.id }}');
    if (!header) return;

    var drawer = document.querySelector('[data-menu-drawer]');
    var toggle = header.querySelector('[data-menu-toggle]');

    /* ---- phone menu: drops down under the header; rows with sub-items open with a tap ---- */
    function placeDrawer() {
      if (!drawer) return;
      drawer.style.top = Math.round(header.getBoundingClientRect().bottom) + 'px';
    }

    function closeGroups() {
      if (!drawer) return;
      drawer.querySelectorAll('.tlw-drawer__group.is-open').forEach(function (group) {
        group.classList.remove('is-open');
        var btn = group.querySelector('[data-drawer-toggle]');
        var sub = group.querySelector('.tlw-drawer__sub');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (sub) sub.style.maxHeight = '0px';
      });
    }

    function openGroup(group) {
      var btn = group.querySelector('[data-drawer-toggle]');
      var sub = group.querySelector('.tlw-drawer__sub');
      group.classList.add('is-open');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      if (sub) sub.style.maxHeight = sub.scrollHeight + 'px';
    }

    function menuIsOpen() {
      return !!drawer && !drawer.hidden;
    }

    function open() {
      if (!drawer) return;
      placeDrawer();
      drawer.hidden = false;
      header.classList.add('is-menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
    }

    function shut() {
      if (!drawer) return;
      drawer.hidden = true;
      header.classList.remove('is-menu-open');
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open menu');
      }
      document.body.style.overflow = '';
      closeGroups();
    }

    if (toggle) {
      toggle.addEventListener('click', function () {
        if (menuIsOpen()) shut(); else open();
      });
    }

    if (drawer) {
      drawer.querySelectorAll('[data-drawer-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var group = btn.closest('.tlw-drawer__group');
          var willOpen = !group.classList.contains('is-open');
          closeGroups(); /* one at a time keeps the menu short */
          if (willOpen) openGroup(group);
        });
      });

      drawer.addEventListener('click', function (e) {
        /* tapping the dimmed area, or any link, closes the menu */
        if (e.target === drawer || (e.target.closest && e.target.closest('a'))) shut();
      });
    }

    var bagLink = header.querySelector('.tlw-header__cart');
    if (bagLink) bagLink.addEventListener('click', shut);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') shut();
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth >= 1600) shut();
            else if (menuIsOpen()) placeDrawer();
    });

    /* Dropdown triggers are buttons now (see markup), so a click never
       navigates — it only opens/closes the dropdown. Needed on touch
       devices (no hover), and doesn't hurt on desktop where hover already
       reveals the dropdown, since a click there just confirms the state. */
    header.querySelectorAll('.tlw-nav__item.has-children > .tlw-nav__link').forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var item = trigger.parentElement;
        var isOpen = item.classList.contains('is-open');
        header.querySelectorAll('.tlw-nav__item.is-open').forEach(function (o) {
          o.classList.remove('is-open');
          var t = o.querySelector('.tlw-nav__link');
          if (t) t.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });

    /* Overlay mode. Two behaviours, set in the section settings.

       "hide": the bar is invisible at the very top and fades and slides in as
       you scroll, driven frame by frame off the scroll position rather than
       flipped on at a threshold.

       "white": the bar shows in white over the hero and turns solid once the
       hero is behind you. */
    if (header.hasAttribute('data-overlay')) {

      function scrolledBy() {
        var y = window.scrollY || document.documentElement.scrollTop || 0;
        if (y === 0) {
          var wrap = document.querySelector('.page-wrapper');
          if (wrap) y = wrap.scrollTop || 0;
        }
        return y;
      }

      {% if section.settings.top_behaviour == 'hide' %}

        var reveal = {{ section.settings.reveal_distance }};
        var ticking = false;

        function paint() {
          var p = Math.min(Math.max(scrolledBy() / reveal, 0), 1);
          /* Quartic ease-out — gentler tail than cubic, so the last bit of
             the reveal settles softly instead of stopping abruptly. */
          var eased = 1 - Math.pow(1 - p, 4);

          header.style.opacity = eased;
          header.style.transform = 'translateY(' + ((eased - 1) * 100) + '%)';
          header.classList.toggle('is-visible', p > 0.02);
          header.classList.toggle('is-solid', p > 0.02);
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(paint);
          }
        }

        paint();
        window.addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('scroll', onScroll, { passive: true, capture: true });
        window.addEventListener('resize', onScroll);

      {% else %}

        function threshold() {
          var host = document.querySelector('#MainContent') || document.body;
          var firstSection = host.firstElementChild;
          var h = firstSection ? firstSection.offsetHeight : window.innerHeight;
          return Math.max(h - header.offsetHeight, 60);
        }

        function onScroll() {
          header.classList.toggle('is-solid', scrolledBy() > threshold());
        }

        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
        document.addEventListener('scroll', onScroll, { passive: true, capture: true });
        window.addEventListener('resize', onScroll);

      {% endif %}
    }

    /* Tell the rest of the theme how tall the bar is, and whether it
       reserves space or floats over the first section. */
    function publishHeight() {
      var overlaid = header.hasAttribute('data-overlay');
      document.documentElement.style.setProperty(
        '--tlw-header-h',
        (overlaid ? 0 : header.offsetHeight) + 'px'
      );
    }
    publishHeight();
    window.addEventListener('resize', publishHeight);

    /* Keep the bag count fresh after an add to cart */
    document.addEventListener('cart:refresh', function () {
      fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          var el = header.querySelector('[data-cart-count]');
          if (el) el.textContent = c.item_count;
        })
        .catch(function () {});
    });
  })();
</script>

{% schema %}
{
  "name": "TLW Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu_left",
      "label": "Left menu",
      "info": "Edit under Content > Menus. Items with sub-items become dropdowns.",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Right menu"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use the gold version for the header"
    },
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "White logo",
      "info": "Used while the header sits over the hero. Falls back to the main logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "paragraph",
      "content": "The transparent \"over the hero\" bar only ever shows on the homepage \u2014 this happens automatically, not via a setting, since no other page has a hero for it to sit over."
    },
    {
      "type": "checkbox",
      "id": "hide_until_scroll",
      "label": "Hide the bar until you scroll",
      "info": "Homepage only. Nothing at all over the hero. The bar slides in once the hero is behind you.",
      "default": true
    },
    {
      "type": "select",
      "id": "top_behaviour",
      "label": "At the very top of the page",
      "info": "Only applies when the header sits over the hero",
      "options": [
        { "value": "hide", "label": "Hide it until you scroll" },
        { "value": "white", "label": "Show it in white over the video" }
      ],
      "default": "hide"
    },
    {
      "type": "range",
      "id": "reveal_distance",
      "label": "How far to scroll before it is fully in",
      "info": "Only used when the bar is hidden at the top. Higher is slower and gentler.",
      "min": 60,
      "max": 400,
      "step": 20,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "height",
      "label": "Bar height",
      "min": 64,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Background opacity",
      "info": "Lower it to let the hero show through",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "blur",
      "label": "Blur what is behind the bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Line under the bar",
      "default": true
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Menu text size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "link_weight",
      "label": "Menu text weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "logo_nudge",
      "label": "Nudge the logo sideways",
      "info": "For when the logo image has uneven space around it",
      "min": -40,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "link_gap",
      "label": "Space between menu items",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Phone menu"
    },
    {
      "type": "checkbox",
      "id": "drawer_view_all",
      "label": "Add an \"All ...\" link at the top of each dropdown",
      "info": "Tapping a row that has sub-items only opens it. Turn this on to also link to the row's own page, e.g. All Collections.",
      "default": false
    }
  ],
  "presets": [{ "name": "TLW Header" }]
}
{% endschema %}