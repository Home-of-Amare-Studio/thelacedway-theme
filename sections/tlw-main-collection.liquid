{% comment %}
  THELACEDWÁY collection section
  Home of Amare Studio

  One file serves every collection. The hero copy (eyebrow, italic lead line,
  body, note badge) is hardcoded per collection handle below, matching how
  the React export did it (src/routes/collections.*.tsx, bespoke.tsx,
  hair.*.tsx) — each collection had its own literal marketing copy, not a
  Shopify field. Any collection handle not listed falls back to Shopify's
  own collection title/description.

  This is the same kind of hardcoded content the eventual metafields pass
  (Phase 5) will move into Shopify admin fields, so it's an interim step,
  not a dead end.

  Add-on products are tagged 'addon' in Shopify. They are published so they
  can be added to the cart, but customers should never browse them, so they
  are skipped here.
{% endcomment %}

{%- liquid
  assign eyebrow = ''
  assign lead = ''
  assign note = ''
  assign display_name = collection.title
  assign body_text = collection.description
  assign cta_heading = 'Not sure which wig?'
  assign cta_body = "Every piece is built to your measurements. Tell us how you wear your hair and we'll guide the fit."
  assign cta_style = 'contact'

  case collection.handle
    when 'essentials'
      assign display_name = 'The Essentials'
      assign lead = 'Every wardrobe starts with a staple.'
      assign body_text = 'A curated edit of timeless virgin hair wigs, crafted for effortless everyday looks.'
    when 'signature'
      assign display_name = 'The Signature'
      assign lead = 'The styles that define TheLacedWay.'
      assign body_text = 'A curated edit of luxury raw hair wigs, featuring our most iconic colours and signature looks, crafted to make a statement.'
    when 'ready-to-ship'
      assign display_name = 'Ready to Ship'
      assign eyebrow = 'Available now'
      assign lead = 'Luxury, without the wait.'
      assign body_text = 'A curated edit of premium wigs, ready to ship within 1 to 2 working days.'
      assign note = 'Dispatched within 1-2 working days'
    when 'accessories'
      assign display_name = 'Accessories'
      assign lead = 'Style. Maintain. Perfect.'
      assign body_text = ''
      assign cta_heading = 'Not sure what you need?'
      assign cta_body = "Tell us how you wear your pieces and we'll point you to the right care and styling essentials."
      assign cta_style = 'enquire'
    when 'bespoq'
      assign display_name = 'The Bespoq'
      assign lead = 'Created without limits.'
      assign body_text = 'Bespoke creations, crafted exclusively for each seasonal drop.'
    when 'bundles'
      assign display_name = 'Bundles'
      assign eyebrow = 'Hair'
      assign lead = 'Virgin and raw hair, by the bundle.'
      assign body_text = 'Choose your lengths and quantity, and build the look your way. Our bundles arrive soft, full and ready to install.'
      assign cta_heading = 'Not sure how many bundles?'
      assign cta_body = "Tell us the length and fullness you have in mind and we'll advise on the right quantity."
      assign cta_style = 'enquire'
    when 'lace-systems'
      assign display_name = 'Premium Lace Systems'
      assign eyebrow = 'Hair'
      assign lead = 'Closures and frontals, finished by hand.'
      assign body_text = 'Choose your lace size and length. Every system is prepared to sit flat and blend seamlessly.'
      assign cta_heading = 'Not sure which lace size?'
      assign cta_body = "Tell us how you part and style your hair and we'll point you to the right closure or frontal."
      # cta_style stays 'contact' here — the React source's Enquire check compared against the literal name "Lace Systems", but this collection's real name is "Premium Lace Systems", so it never actually matched. Matching that real behaviour rather than the probably-intended one.
  endcase
-%}

<section
  class="tlw-collection tlw-container"
  id="tlw-collection-{{ section.id }}"
>

  {%- if section.settings.show_header -%}
    <header class="tlw-collection__header">
      {%- if eyebrow != blank -%}
        <span class="tlw-label-caps tlw-collection__eyebrow">{{ eyebrow }}</span>
      {%- endif -%}

      <h1 class="tlw-display-lg">{{ display_name }}</h1>
      <div class="tlw-collection__rule"></div>

      {%- if lead != blank -%}
        <p class="tlw-collection__lead">{{ lead }}</p>
      {%- endif -%}

      {%- if section.settings.show_description and body_text != blank -%}
        <div class="tlw-collection__intro tlw-body-md">
          {{ body_text }}
        </div>
      {%- endif -%}

      {%- if note != blank -%}
        <span class="tlw-label-caps tlw-collection__note">{{ note }}</span>
      {%- endif -%}

      {%- if section.settings.show_count -%}
        <p class="tlw-label-caps tlw-collection__count">
          {%- assign visible = 0 -%}
          {%- for product in collection.products -%}
            {%- unless product.tags contains 'addon' -%}
              {%- assign visible = visible | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
          {{ visible }} {% if visible == 1 %}piece{% else %}pieces{% endif %}
        </p>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if section.settings.show_breadcrumb -%}
    <p class="tlw-label-caps tlw-collection__breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="tlw-collection__breadcrumb-sep">/</span>
      <span>{{ display_name }}</span>
    </p>
  {%- endif -%}

  {%- paginate collection.products by section.settings.per_page -%}

    {%- if collection.products.size == 0 -%}
      <p class="tlw-body-lg tlw-collection__empty">
        {{ section.settings.empty_text }}
      </p>
    {%- else -%}

      <div class="tlw-collection__grid">
        {%- for product in collection.products -%}
          {%- if product.tags contains 'addon' -%}
            {%- continue -%}
          {%- endif -%}

          <a class="tlw-card" href="{{ product.url }}">
            <div class="tlw-card__media">
              {%- if product.featured_media -%}
                {{ product.featured_media
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 900px) 30vw, 45vw',
                    widths: '300, 450, 600, 900',
                    alt: product.title,
                    class: 'tlw-card__img'
                }}

                {%- if product.media[1] and section.settings.hover_second_image -%}
                  {{ product.media[1]
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      alt: '',
                      class: 'tlw-card__img tlw-card__img--hover'
                  }}
                {%- endif -%}
              {%- else -%}
                <div class="tlw-card__placeholder">
                  <span class="tlw-label-caps">{{ product.title }}</span>
                </div>
              {%- endif -%}

              {%- if collection.handle == 'ready-to-ship' -%}
                <span class="tlw-card__collection-badge">Ready to Ship</span>
              {%- endif -%}

              {%- unless product.available -%}
                <span class="tlw-card__badge tlw-label-caps">Sold out</span>
              {%- endunless -%}
            </div>

            <div class="tlw-card__body">
              <h2 class="tlw-card__title tlw-headline-sm">{{ product.title }}</h2>

              <p class="tlw-card__price tlw-body-md">
                {%- if product.price_varies -%}
                  From {{ product.price_min | money }}
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </p>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="tlw-pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a class="tlw-label-caps" href="{{ paginate.previous.url }}">Previous</a>
          {%- endif -%}

          <span class="tlw-label-caps tlw-pagination__count">
            Page {{ paginate.current_page }} of {{ paginate.pages }}
          </span>

          {%- if paginate.next -%}
            <a class="tlw-label-caps" href="{{ paginate.next.url }}">Next</a>
          {%- endif -%}
        </nav>
      {%- endif -%}

    {%- endif -%}
  {%- endpaginate -%}

  {%- if section.settings.show_cta -%}
    <section class="tlw-collection__cta">
      <h2 class="tlw-headline-md">{{ cta_heading }}</h2>
      <p class="tlw-body-md">{{ cta_body }}</p>
      <a href="{{ section.settings.contact_page_url }}" class="tlw-collection__cta-btn">
        {%- if cta_style == 'enquire' -%}
          {{ section.settings.enquire_label }}
        {%- else -%}
          {{ section.settings.contact_label }}
        {%- endif -%}
      </a>
    </section>
  {%- endif -%}
</section>

<style>
  #tlw-collection-{{ section.id }} {
    padding-block: 48px 80px;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__header {
    max-width: 640px;
    margin: 0 auto 32px;
    text-align: center;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__eyebrow {
    display: block;
    margin-bottom: 16px;
    color: var(--tlw-accent);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__rule {
    margin: 24px auto;
    height: 1px;
    width: 80px;
    background: var(--tlw-accent);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__lead {
    font-family: var(--tlw-font-display);
    font-style: italic;
    font-size: 20px;
    color: var(--tlw-primary);
    margin: 0 auto;
    max-width: 42rem;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__intro {
    margin-top: 16px;
    max-width: 34rem;
    margin-inline: auto;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__note {
    display: block;
    margin-top: 32px;
    white-space: nowrap;
    color: var(--tlw-accent);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__count {
    margin-top: 20px;
    color: var(--tlw-outline);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__breadcrumb {
    margin: 0 0 48px;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 250ms ease;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__breadcrumb a:hover {
    color: var(--tlw-primary);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__breadcrumb-sep {
    margin: 0 8px;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__breadcrumb span:last-child {
    color: var(--tlw-primary);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 12px;
  }

  @media (min-width: 700px) {
    #tlw-collection-{{ section.id }} .tlw-collection__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      gap: 40px 24px;
    }
  }

  @media (min-width: 900px) {
    #tlw-collection-{{ section.id }} {
      padding-block: 72px 120px;
    }
  }

  #tlw-collection-{{ section.id }} .tlw-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #tlw-collection-{{ section.id }} .tlw-card__media {
    position: relative;
    overflow: hidden;
    background: var(--tlw-surface-container);
    aspect-ratio: 4 / 5;
  }

  #tlw-collection-{{ section.id }} .tlw-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 600ms ease, transform 1100ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  #tlw-collection-{{ section.id }} .tlw-card__img--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  @media (hover: hover) {
    #tlw-collection-{{ section.id }} .tlw-card:hover .tlw-card__img--hover {
      opacity: 1;
    }
    #tlw-collection-{{ section.id }} .tlw-card:hover .tlw-card__img {
      transform: scale(1.03);
    }
  }

  #tlw-collection-{{ section.id }} .tlw-card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    color: var(--tlw-outline);
  }

  #tlw-collection-{{ section.id }} .tlw-card__collection-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--tlw-accent);
    color: #fff;
    padding: 6px 10px;
    font-family: var(--tlw-font-body);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #tlw-collection-{{ section.id }} .tlw-card__badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--tlw-primary);
    color: var(--tlw-on-primary);
    padding: 6px 10px;
  }

  #tlw-collection-{{ section.id }} .tlw-card__body {
    padding-top: 14px;
  }

  #tlw-collection-{{ section.id }} .tlw-card__title {
    margin: 0 0 4px;
  }

  #tlw-collection-{{ section.id }} .tlw-card__price {
    margin: 0;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__empty {
    padding-block: 64px;
    color: var(--tlw-outline);
  }

  #tlw-collection-{{ section.id }} .tlw-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--tlw-outline-variant);
  }

  #tlw-collection-{{ section.id }} .tlw-pagination__count {
    color: var(--tlw-outline);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__cta {
    max-width: 640px;
    margin: 96px auto 0;
    padding-top: 64px;
    border-top: 1px solid rgba(178, 141, 76, 0.4);
    text-align: center;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__cta h2 {
    margin: 0 0 16px;
    color: var(--tlw-primary);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__cta p {
    margin: 0 0 32px;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-collection-{{ section.id }} .tlw-collection__cta-btn {
    display: inline-block;
    border: 1px solid var(--tlw-accent);
    border-radius: 999px;
    padding: 16px 40px;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-collection-{{ section.id }} .tlw-collection__cta-btn:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }
</style>

{% schema %}
{
  "name": "TLW Collection",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show collection name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "info": "Uses the hardcoded copy for known collections, or the description written in Shopify admin for any other collection",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show Home / Collection breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many pieces are in the collection",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Pieces per page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "hover_second_image",
      "label": "Show the second photo on hover",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when a collection is empty",
      "default": "New pieces are on their way. Check back soon."
    },
    {
      "type": "header",
      "content": "Bottom CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show the 'Not sure which wig?' CTA below the grid",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_page_url",
      "label": "Contact page link",
      "info": "Both the Enquire and Contact us buttons link here. The original site opened a live chat modal for Enquire, which hasn't been built \u2014 this links to your Contact page instead.",
      "default": "/pages/contact"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Button label \u2014 most collections",
      "default": "Contact us"
    },
    {
      "type": "text",
      "id": "enquire_label",
      "label": "Button label \u2014 Bundles & Accessories",
      "default": "Enquire"
    }
  ],
  "presets": [{ "name": "TLW Collection" }]
}
{% endschema %}
