{% comment %}
  THELACEDWÁY custom wigs
  Home of Amare Studio

  The enquiry form expands in place rather than sending the visitor to another
  page, matching the live site.

  It uses Shopify's own contact form, so submissions arrive at the store email
  set under Settings > Notifications. No app, no monthly cost, nothing to
  maintain. Every field is a block, so Destinee can add or remove questions
  herself without touching code.
{% endcomment %}

<section class="tlw-custom" id="tlw-custom-{{ section.id }}">
  <div class="tlw-custom__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tlw-custom__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="tlw-custom__title">
      {{ section.settings.heading_before }}
      {%- if section.settings.heading_accent != blank -%}
        <em class="tlw-accent-word">{{ section.settings.heading_accent }}</em>
      {%- endif -%}
      {{ section.settings.heading_after }}
    </h2>

    {%- if section.settings.body != blank -%}
      <p class="tlw-custom__text">{{ section.settings.body }}</p>
    {%- endif -%}

    <button
      type="button"
      class="tlw-custom__toggle"
      data-custom-toggle
      aria-expanded="false"
      aria-controls="tlw-custom-panel-{{ section.id }}"
      data-open-label="{{ section.settings.open_label | escape }}"
      data-close-label="{{ section.settings.close_label | escape }}"
    >
      {{ section.settings.open_label }}
    </button>
  </div>

  <div class="tlw-custom__panel" id="tlw-custom-panel-{{ section.id }}" data-custom-panel>
    <div class="tlw-custom__clip">
      <div class="tlw-custom__form" data-custom-form>

        {%- if section.settings.form_intro != blank -%}
          <p class="tlw-custom__intro">{{ section.settings.form_intro }}</p>
        {%- endif -%}

        {%- form 'contact', class: 'tlw-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="tlw-form__success">{{ section.settings.success_text }}</p>
          {%- endif -%}

          {%- if form.errors -%}
            <p class="tlw-form__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[Enquiry type]" value="{{ section.settings.enquiry_label }}">

          {%- assign step_labels = section.settings.step_labels | split: ',' -%}
          {%- assign step_count = step_labels.size -%}

          <div class="tlw-wizard" data-wizard data-steps="{{ step_count }}">

            <div class="tlw-wizard__bar">
              <p class="tlw-wizard__counter">
                {{ section.settings.step_word }} <span data-step-now>1</span>
                {{ section.settings.of_word }} {{ step_count }}
              </p>
              <div class="tlw-wizard__segments">
                {%- for label in step_labels -%}
                  <span class="tlw-wizard__seg{% if forloop.first %} is-on{% endif %}" data-step-seg></span>
                {%- endfor -%}
              </div>
            </div>

            {%- for label in step_labels -%}
              {%- assign step_no = forloop.index -%}
              <fieldset
                class="tlw-step{% if forloop.first %} is-current{% endif %}"
                data-step="{{ step_no }}"
                {% unless forloop.first %}hidden{% endunless %}
              >
                <legend class="tlw-step__label">{{ label | strip }}</legend>

                <div class="tlw-form__grid">
                  {%- for block in section.blocks -%}
                    {%- if block.settings.step != step_no -%}{%- continue -%}{%- endif -%}
                    {%- assign fid = 'f-' | append: section.id | append: '-' | append: block.id -%}
                    {%- assign fname = block.settings.label | escape -%}

                    {%- case block.type -%}

                      {%- when 'field' -%}
                        <div class="tlw-field{% if block.settings.full_width %} is-wide{% endif %}" {{ block.shopify_attributes }}>
                          <label class="tlw-field__label" for="{{ fid }}">
                            {{ block.settings.label }}{% if block.settings.required %}<span class="tlw-field__req">*</span>{% endif %}
                          </label>
                          <input
                            class="tlw-input"
                            id="{{ fid }}"
                            type="{{ block.settings.kind }}"
                            name="contact[{{ fname }}]"
                            placeholder="{{ block.settings.placeholder }}"
                            {% if block.settings.required %}data-required{% endif %}
                          >
                        </div>

                      {%- when 'phone' -%}
                        {%- assign codes = block.settings.codes | newline_to_br | strip_newlines | split: '<br />' -%}
                        <div class="tlw-field{% if block.settings.full_width %} is-wide{% endif %}" {{ block.shopify_attributes }}>
                          <label class="tlw-field__label" for="{{ fid }}">
                            {{ block.settings.label }}{% if block.settings.required %}<span class="tlw-field__req">*</span>{% endif %}
                          </label>
                          <div class="tlw-phone">
                            <select
                              class="tlw-input tlw-select tlw-phone__code"
                              name="contact[{{ fname }} country code]"
                              data-phone-code
                              aria-label="Country code"
                            >
                              {%- for row in codes -%}
                                {%- assign bits = row | strip | split: '|' -%}
                                {%- if bits.size >= 2 -%}
                                  <option
                                    value="{{ bits[1] | strip | escape }}"
                                    data-hint="{{ bits[2] | default: '' | strip | escape }}"
                                    {% if forloop.first %}selected{% endif %}
                                  >{{ bits[0] | strip }} {{ bits[1] | strip }}</option>
                                {%- endif -%}
                              {%- endfor -%}
                            </select>
                            <input
                              class="tlw-input tlw-phone__number"
                              id="{{ fid }}"
                              type="tel"
                              name="contact[{{ fname }}]"
                              placeholder="{{ block.settings.placeholder }}"
                              data-phone-number
                              {% if block.settings.required %}data-required{% endif %}
                            >
                          </div>
                        </div>

                      {%- when 'choice' -%}
                        <div class="tlw-field{% if block.settings.full_width %} is-wide{% endif %}" {{ block.shopify_attributes }}>
                          <label class="tlw-field__label" for="{{ fid }}">
                            {{ block.settings.label }}{% if block.settings.required %}<span class="tlw-field__req">*</span>{% endif %}
                          </label>
                          <select
                            class="tlw-input tlw-select"
                            id="{{ fid }}"
                            name="contact[{{ fname }}]"
                            {% if block.settings.required %}data-required{% endif %}
                          >
                            <option value="">{{ block.settings.placeholder | default: 'Please choose' }}</option>
                            {%- assign opts = block.settings.options | split: ',' -%}
                            {%- for opt in opts -%}
                              {%- assign clean = opt | strip -%}
                              <option value="{{ clean | escape }}">{{ clean }}</option>
                            {%- endfor -%}
                          </select>
                        </div>

                      {%- when 'message' -%}
                        <div class="tlw-field is-wide" {{ block.shopify_attributes }}>
                          <label class="tlw-field__label" for="{{ fid }}">
                            {{ block.settings.label }}{% if block.settings.required %}<span class="tlw-field__req">*</span>{% endif %}
                          </label>
                          <textarea
                            class="tlw-input tlw-textarea"
                            id="{{ fid }}"
                            name="contact[body]"
                            rows="5"
                            placeholder="{{ block.settings.placeholder }}"
                            {% if block.settings.required %}data-required{% endif %}
                          ></textarea>
                        </div>

                      {%- when 'agree' -%}
                        <div class="tlw-field is-wide tlw-agree" {{ block.shopify_attributes }}>
                          <label class="tlw-agree__row">
                            <input
                              type="checkbox"
                              id="{{ fid }}"
                              name="contact[{{ fname }}]"
                              value="Yes"
                              {% if block.settings.required %}data-required{% endif %}
                            >
                            <span>{{ block.settings.label }}{% if block.settings.required %}<span class="tlw-field__req">*</span>{% endif %}</span>
                          </label>
                        </div>

                    {%- endcase -%}
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}

            <div class="tlw-wizard__foot">
              <button type="button" class="tlw-wizard__back" data-wizard-back hidden>
                {{ section.settings.back_label }}
              </button>

              <button type="button" class="tlw-wizard__next" data-wizard-next>
                {{ section.settings.next_label }}
              </button>

              <button type="submit" class="tlw-form__submit" data-wizard-submit hidden>
                {{ section.settings.submit_label }}
              </button>
            </div>

            <p class="tlw-wizard__warn" data-wizard-warn hidden>{{ section.settings.incomplete_text }}</p>
          </div>

        {%- endform -%}

      </div>
    </div>
  </div>
</section>

<style>
  #tlw-custom-{{ section.id }} {
    padding: 96px var(--tlw-margin) 72px;
    background: var(--tlw-secondary-light);
    color: var(--tlw-primary);
  }

  @media (min-width: 900px) {
    #tlw-custom-{{ section.id }} { padding-top: 120px; }
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 48rem;
    margin-inline: auto;
    text-align: center;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__eyebrow {
    margin: 0 0 8px;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__title {
    margin: 0;
    font-family: var(--tlw-font-display);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-custom__title {
      font-size: 64px;
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }
  }

  #tlw-custom-{{ section.id }} .tlw-custom__text {
    max-width: 36rem;
    margin: 24px 0 0;
    font-size: 16px;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__toggle {
    flex-shrink: 0;
    margin-top: 40px;
    padding: 16px 40px;
    border: 1px solid var(--tlw-accent);
    border-radius: var(--tlw-radius);
    background: transparent;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__toggle:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  /* The panel unfolds by animating its row height from nothing to auto. */
  #tlw-custom-{{ section.id }} .tlw-custom__panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 700ms ease-in-out, opacity 700ms ease-in-out;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__clip { overflow: hidden; }

  #tlw-custom-{{ section.id }} .tlw-custom__form {
    max-width: 48rem;
    margin-inline: auto;
    padding-top: 56px;
    text-align: left;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__intro {
    margin: 0 0 32px;
    font-size: 16px;
    color: var(--tlw-on-surface-variant);
  }

  /* The card the wizard sits in */
  #tlw-custom-{{ section.id }} .tlw-wizard {
    padding: 40px 32px;
    border-radius: {{ section.settings.card_radius }}px;
    background: var(--tlw-surface-lowest);
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-wizard { padding: 56px 56px 48px; }
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__counter {
    margin: 0 0 16px;
    font-family: var(--tlw-font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__segments {
    display: flex;
    gap: 12px;
    margin-bottom: 44px;
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__seg {
    flex: 1;
    height: 2px;
    background: var(--tlw-outline-variant);
    transition: background-color 400ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__seg.is-on {
    background: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-step {
    margin: 0;
    padding: 0;
    border: 0;
  }

  #tlw-custom-{{ section.id }} .tlw-step[hidden] { display: none; }

  #tlw-custom-{{ section.id }} .tlw-step__label {
    padding: 0;
    margin-bottom: 28px;
    font-family: var(--tlw-font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-agree__row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-agree__row input {
    margin-top: 4px;
    width: 18px;
    height: 18px;
    accent-color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__foot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--tlw-outline-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__back,
  #tlw-custom-{{ section.id }} .tlw-wizard__next {
    padding: 16px 40px;
    border-radius: var(--tlw-radius);
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__back {
    margin-right: auto;
    border: 1px solid var(--tlw-outline-variant);
    background: transparent;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__back:hover {
    border-color: var(--tlw-primary);
    color: var(--tlw-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__next {
    border: 1px solid var(--tlw-accent);
    background: transparent;
    color: var(--tlw-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__next:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__back[hidden],
  #tlw-custom-{{ section.id }} .tlw-wizard__next[hidden],
  #tlw-custom-{{ section.id }} .tlw-form__submit[hidden] { display: none; }

  #tlw-custom-{{ section.id }} .tlw-form__submit { margin-top: 0; }

  #tlw-custom-{{ section.id }} .tlw-wizard__warn {
    margin: 16px 0 0;
    text-align: right;
    font-size: 13px;
    color: #a33;
  }

  #tlw-custom-{{ section.id }} .tlw-wizard__warn[hidden] { display: none; }

  #tlw-custom-{{ section.id }} .tlw-input.is-missing {
    border-color: #a33;
  }

  #tlw-custom-{{ section.id }} .tlw-form__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

