{% comment %}
  THELACEDWÁY custom wigs
  Home of Amare Studio

  A 6-step accordion built on Shopify's plain native contact form — no app,
  nothing stored in Shopify admin. Each step opens one at a time (CSS
  class-toggle, not JS-measured height, so it behaves correctly even nested
  inside the collapsed homepage-teaser panel). Steps:
    1. Your Details — Full Name, Email Address, Contact Number
    2. Lace & Length — lace size, length
    3. Hair Type & Colour — hair type, colour
    4. Fit & Parting — cap/head size, parting preference
    5. Styling & Extras — styling/customisation notes, anything else
    6. Timing — when the wig is needed by
  Name/Email/Phone/Message reuse Shopify's native contact[name],
  contact[email], contact[phone] and contact[body] fields; everything else is
  a named contact[Custom Label] field that Shopify forwards into the
  notification email as "Custom Label: value".

  WHERE ENQUIRIES GO: Shopify's contact form emails every submission to the
  store's Sender email address (Shopify admin > Settings, look for "Sender
  email"). The emails come from mailer@shopify.com, so check spam the first
  time. Nothing is stored in Shopify admin, so there is no list of enquiries
  to look at later. The hidden field below tags each one "Custom Wig Enquiry"
  so it is easy to tell apart from any other contact form on the site.

  Two modes, picked by the "Show the form open by default" setting:
  - Off (default): the homepage teaser. The form expands in place when
    clicked.
  - On: for a dedicated page (e.g. /custom-wig-enquiry). No toggle button,
    the form is open on load, and the heading renders as an <h1>.

  After a successful send, only the thank-you message and its button are
  shown. The fields are hidden until the page is loaded again.
{% endcomment %}

{%- liquid
  assign heading_tag = 'h2'
  if section.settings.start_open
    assign heading_tag = 'h1'
  endif
  assign form_id = 'CustomWigForm-' | append: section.id
-%}

<section class="tlw-custom" id="tlw-custom-{{ section.id }}">
  <div class="tlw-custom__head{% unless section.settings.start_open %} tlw-custom__head--center{% endunless %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tlw-custom__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <{{ heading_tag }} class="tlw-custom__title">
      {{ section.settings.heading_before }}
      {% if section.settings.heading_accent != blank -%}
        <em class="tlw-accent-word">{{ section.settings.heading_accent }}</em>
      {%- endif %}
      {%- if section.settings.heading_after != blank -%}
        <br class="tlw-custom__break">
        {{ section.settings.heading_after }}
      {%- endif %}
    </{{ heading_tag }}>

    <div class="tlw-custom__rule"></div>

    {%- if section.settings.body != blank -%}
      <p class="tlw-custom__text">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- assign extra_lines = section.settings.extra_paragraphs | newline_to_br | strip_newlines | split: '<br />' -%}
    {%- for line in extra_lines -%}
      {%- assign clean_line = line | strip -%}
      {%- if clean_line != blank -%}
        <p class="tlw-custom__text">{{ clean_line }}</p>
      {%- endif -%}
    {%- endfor -%}

    {%- unless section.settings.start_open -%}
      <button
        type="button"
        class="tlw-custom__toggle"
        data-custom-toggle
        aria-expanded="false"
        aria-controls="tlw-custom-panel-{{ section.id }}"
        data-open-label="{{ section.settings.open_label | escape }}"
        data-close-label="{{ section.settings.close_label | escape }}"
      >
        {{ section.settings.open_label }}
      </button>
    {%- endunless -%}
  </div>

  <div
    class="tlw-custom__panel{% if section.settings.start_open %} is-open{% endif %}"
    id="tlw-custom-panel-{{ section.id }}"
    data-custom-panel
  >
    <div class="tlw-custom__form-wrap">
      <div class="tlw-custom__card{% unless section.settings.start_open %} tlw-custom__card--center{% endunless %}">

        {%- form 'contact', id: form_id, class: 'tlw-custom__form' -%}

          {%- if form.posted_successfully? -%}

            {%- comment -%} Sent: show only the thank-you and its button. {%- endcomment -%}
            <p class="tlw-form__success">{{ section.settings.success_text }}</p>
            {%- if section.settings.success_button_label != blank and section.settings.success_button_link != blank -%}
              <a href="{{ section.settings.success_button_link }}" class="tlw-custom__success-btn">
                {{ section.settings.success_button_label }}
              </a>
            {%- endif -%}

          {%- else -%}

            {%- if section.settings.form_eyebrow != blank -%}
              <p class="tlw-custom__form-eyebrow">{{ section.settings.form_eyebrow }}</p>
            {%- endif -%}

            {%- if form.errors -%}
              <p class="tlw-form__error">{{ form.errors | default_errors }}</p>
            {%- endif -%}

            <input type="hidden" name="contact[enquiry_type]" value="Custom Wig Enquiry">

            <div class="tlw-custom__steps">

              {%- comment -%} Step 1 — Your Details {%- endcomment -%}
              <div class="tlw-custom__step is-open" data-step>
                <button type="button" class="tlw-custom__step-header" data-step-toggle aria-expanded="true" aria-controls="{{ form_id }}-step-1">
                  <span class="tlw-custom__step-number">1</span>
                  <span class="tlw-custom__step-title">Your Details</span>
                  <svg class="tlw-custom__step-chevron" viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <div class="tlw-custom__step-panel" id="{{ form_id }}-step-1" data-step-panel>
                  <div class="tlw-custom__step-body">
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-name">Full Name</label>
                      <input type="text" id="{{ form_id }}-name" name="contact[name]" value="{{ form.name }}" placeholder="Your full name" autocomplete="name" required>
                    </div>
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-email">Email Address</label>
                      <input type="email" id="{{ form_id }}-email" name="contact[email]" value="{{ form.email }}" placeholder="you@email.com" autocomplete="email" required>
                    </div>
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-phone">Contact Number</label>
                      <input type="tel" id="{{ form_id }}-phone" name="contact[phone]" value="{{ form.phone }}" placeholder="Your phone number" autocomplete="tel" required>
                    </div>
                    <button type="button" class="tlw-custom__step-next" data-step-next>Continue</button>
                  </div>
                </div>
              </div>

              {%- comment -%} Step 2 — Lace & Length {%- endcomment -%}
              <div class="tlw-custom__step" data-step>
                <button type="button" class="tlw-custom__step-header" data-step-toggle aria-expanded="false" aria-controls="{{ form_id }}-step-2">
                  <span class="tlw-custom__step-number">2</span>
                  <span class="tlw-custom__step-title">Lace &amp; Length</span>
                  <svg class="tlw-custom__step-chevron" viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <div class="tlw-custom__step-panel" id="{{ form_id }}-step-2" data-step-panel>
                  <div class="tlw-custom__step-body">
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-lace">What lace size would you prefer?</label>
                      <p class="tlw-custom__hint">e.g. 5x5, 6x6, 7x7, 9x6 or 13x6. If you're unsure, please state this.</p>
                      <input type="text" id="{{ form_id }}-lace" name="contact[Lace Size]" placeholder="e.g. 6x6, or 'not sure'" required>
                    </div>
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-length">What length would you like?</label>
                      <input type="text" id="{{ form_id }}-length" name="contact[Length]" placeholder="e.g. 18 inches" required>
                    </div>
                    <button type="button" class="tlw-custom__step-next" data-step-next>Continue</button>
                  </div>
                </div>
              </div>

              {%- comment -%} Step 3 — Hair Type & Colour {%- endcomment -%}
              <div class="tlw-custom__step" data-step>
                <button type="button" class="tlw-custom__step-header" data-step-toggle aria-expanded="false" aria-controls="{{ form_id }}-step-3">
                  <span class="tlw-custom__step-number">3</span>
                  <span class="tlw-custom__step-title">Hair Type &amp; Colour</span>
                  <svg class="tlw-custom__step-chevron" viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <div class="tlw-custom__step-panel" id="{{ form_id }}-step-3" data-step-panel>
                  <div class="tlw-custom__step-body">
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-hair-type">What hair type would you prefer?</label>
                      <p class="tlw-custom__hint">Virgin Hair, Raw Hair or please state if you would like a recommendation.</p>
                      <input type="text" id="{{ form_id }}-hair-type" name="contact[Hair Type]" placeholder="e.g. Virgin Hair" required>
                    </div>
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-colour">What colour would you like?</label>
                      <p class="tlw-custom__hint">Please describe your preferred colour as clearly as possible.</p>
                      <input type="text" id="{{ form_id }}-colour" name="contact[Colour]" placeholder="e.g. Natural black, rich burgundy..." required>
                    </div>
                    <button type="button" class="tlw-custom__step-next" data-step-next>Continue</button>
                  </div>
                </div>
              </div>

              {%- comment -%} Step 4 — Fit & Parting {%- endcomment -%}
              <div class="tlw-custom__step" data-step>
                <button type="button" class="tlw-custom__step-header" data-step-toggle aria-expanded="false" aria-controls="{{ form_id }}-step-4">
                  <span class="tlw-custom__step-number">4</span>
                  <span class="tlw-custom__step-title">Fit &amp; Parting</span>
                  <svg class="tlw-custom__step-chevron" viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <div class="tlw-custom__step-panel" id="{{ form_id }}-step-4" data-step-panel>
                  <div class="tlw-custom__step-body">
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-cap-size">What is your cap/head size?</label>
                      <p class="tlw-custom__hint">Please state Small, Medium, Large or Unsure.</p>
                      <input type="text" id="{{ form_id }}-cap-size" name="contact[Cap/Head Size]" placeholder="e.g. Medium" required>
                    </div>
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-parting">What parting would you prefer?</label>
                      <p class="tlw-custom__hint">Middle, Left Side, Right Side or No Preference.</p>
                      <input type="text" id="{{ form_id }}-parting" name="contact[Parting Preference]" placeholder="e.g. Middle" required>
                    </div>
                    <button type="button" class="tlw-custom__step-next" data-step-next>Continue</button>
                  </div>
                </div>
              </div>

              {%- comment -%} Step 5 — Styling & Extras {%- endcomment -%}
              <div class="tlw-custom__step" data-step>
                <button type="button" class="tlw-custom__step-header" data-step-toggle aria-expanded="false" aria-controls="{{ form_id }}-step-5">
                  <span class="tlw-custom__step-number">5</span>
                  <span class="tlw-custom__step-title">Styling &amp; Extras</span>
                  <svg class="tlw-custom__step-chevron" viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <div class="tlw-custom__step-panel" id="{{ form_id }}-step-5" data-step-panel>
                  <div class="tlw-custom__step-body">
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-styling">Please describe how you would like your wig styled/customised.</label>
                      <p class="tlw-custom__hint">Please include as much detail as possible, e.g. layers, curls, straight, fringe, etc.</p>
                      <textarea id="{{ form_id }}-styling" name="contact[Styling & Customisation]" rows="4" placeholder="Describe the look you have in mind" required></textarea>
                    </div>
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-extra">Is there anything else you would like to add or request?</label>
                      <textarea id="{{ form_id }}-extra" name="contact[body]" rows="3" placeholder="Optional">{{ form.body }}</textarea>
                    </div>
                    <button type="button" class="tlw-custom__step-next" data-step-next>Continue</button>
                  </div>
                </div>
              </div>

              {%- comment -%} Step 6 — Timing {%- endcomment -%}
              <div class="tlw-custom__step" data-step>
                <button type="button" class="tlw-custom__step-header" data-step-toggle aria-expanded="false" aria-controls="{{ form_id }}-step-6">
                  <span class="tlw-custom__step-number">6</span>
                  <span class="tlw-custom__step-title">Timing</span>
                  <svg class="tlw-custom__step-chevron" viewBox="0 0 12 8" width="14" height="10" aria-hidden="true">
                    <path d="M1 1l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <div class="tlw-custom__step-panel" id="{{ form_id }}-step-6" data-step-panel>
                  <div class="tlw-custom__step-body">
                    <div class="tlw-custom__field">
                      <label for="{{ form_id }}-needed-by">When would you ideally need your wig by?</label>
                      <p class="tlw-custom__hint">Please include the date, particularly if it is required for an event or special occasion.</p>
                      <input type="text" id="{{ form_id }}-needed-by" name="contact[Needed By]" placeholder="e.g. 15th March, or for a wedding on 2nd June" required>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <button type="submit" class="tlw-custom__submit">{{ section.settings.submit_label }}</button>

          {%- endif -%}

        {%- endform -%}
      </div>
    </div>
  </div>

</section>

<style>
  #tlw-custom-{{ section.id }} {
    padding-block: 72px;
    background: var(--tlw-surface-lowest);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head {
    max-width: 640px;
    margin: 0;
    padding-inline: var(--tlw-margin);
    text-align: left;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head--center {
    margin-inline: auto;
    text-align: center;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head--center .tlw-custom__rule {
    margin-inline: auto;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__break {
    display: block;
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-custom__break {
      display: none;
    }
  }

  /* On mobile, everything centers regardless of homepage vs standalone-page
     mode \u2014 the left-aligned layout is a desktop-only choice. */
  @media (max-width: 767px) {
    #tlw-custom-{{ section.id }} .tlw-custom__head {
      margin-inline: auto;
      text-align: center;
    }

    #tlw-custom-{{ section.id }} .tlw-custom__rule {
      margin-inline: auto;
    }
  }

  #tlw-custom-{{ section.id }} .tlw-custom__rule {
    margin: 24px 0 0;
    height: 1px;
    width: 80px;
    background: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__eyebrow {
    font-family: var(--tlw-font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-accent);
    margin: 0 0 16px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__title {
    font-family: var(--tlw-font-display);
    font-size: 32px;
    font-weight: 300;
    color: var(--tlw-primary);
    margin: 0;
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-custom__title {
      font-size: 44px;
    }
  }

  #tlw-custom-{{ section.id }} .tlw-custom__text {
    margin: 20px 0 0;
    color: var(--tlw-on-surface-variant);
    line-height: 1.6;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__toggle {
    margin-top: 32px;
    display: inline-block;
    border: 1px solid var(--tlw-accent);
    border-radius: 0;
    padding: 14px 36px;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    background: transparent;
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__toggle:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 500ms cubic-bezier(0.4, 0, 0.2, 1), opacity 400ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel > .tlw-custom__form-wrap {
    overflow: hidden;
    min-height: 0;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__card {
    max-width: 640px;
    margin: 48px 0 0;
    margin-inline: var(--tlw-margin);
    padding: 32px;
    border: 1px solid var(--tlw-outline-variant);
    border-radius: 28px;
    background: var(--tlw-surface-lowest);
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-custom__card {
      padding: 48px;
    }

    #tlw-custom-{{ section.id }} .tlw-custom__card--center {
      margin-inline: auto;
    }
  }

  /* The gold "Details" label now sits inside the form, so it can be hidden
     with the fields after a successful send. */
  #tlw-custom-{{ section.id }} .tlw-custom__form-eyebrow {
    grid-column: 1 / -1;
    margin: 0 0 12px;
    font-family: var(--tlw-font-body);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__steps {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 4px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step {
    border-top: 1px solid var(--tlw-outline-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step:last-child {
    border-bottom: 1px solid var(--tlw-outline-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-header {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 4px;
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-number {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border: 1px solid var(--tlw-accent);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-title {
    flex: 1;
    font-family: var(--tlw-font-body);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tlw-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-chevron {
    flex: 0 0 auto;
    color: var(--tlw-primary);
    transition: transform 300ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step.is-open .tlw-custom__step-chevron {
    transform: rotate(180deg);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 450ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step.is-open .tlw-custom__step-panel {
    max-height: 800px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 4px 4px 24px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__hint {
    margin: -4px 0 0;
    font-family: var(--tlw-font-body);
    font-size: 12.5px;
    color: var(--tlw-outline);
    line-height: 1.5;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-next {
    align-self: flex-start;
    margin-top: 4px;
    padding: 10px 22px;
    border: 1px solid var(--tlw-primary);
    border-radius: 0;
    background: transparent;
    font-family: var(--tlw-font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__step-next:hover {
    background: var(--tlw-primary);
    color: var(--tlw-on-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field--wide {
    grid-column: 1 / -1;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field label {
    font-family: var(--tlw-font-body);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field input,
  #tlw-custom-{{ section.id }} .tlw-custom__field textarea {
    border: 1px solid var(--tlw-outline-variant);
    background: var(--tlw-surface-container-low);
    padding: 14px 16px;
    font-family: var(--tlw-font-body);
    font-size: 15px;
    color: var(--tlw-primary);
    resize: vertical;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field input::placeholder,
  #tlw-custom-{{ section.id }} .tlw-custom__field textarea::placeholder {
    color: var(--tlw-outline);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field input:focus,
  #tlw-custom-{{ section.id }} .tlw-custom__field textarea:focus {
    outline: none;
    border-color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__submit {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding: 16px 40px;
    border: 1px solid var(--tlw-accent);
    border-radius: 0;
    background: transparent;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__submit:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-form__success,
  #tlw-custom-{{ section.id }} .tlw-form__error {
    grid-column: 1 / -1;
    padding: 16px;
    border: 1px solid var(--tlw-outline-variant);
    font-size: 15px;
  }

  #tlw-custom-{{ section.id }} .tlw-form__error {
    border-color: #a33;
    color: #a33;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__success-btn {
    grid-column: 1 / -1;
    display: inline-block;
    width: fit-content;
    margin: 12px auto 0;
    padding: 14px 32px;
    border: 1px solid var(--tlw-accent);
    border-radius: 0;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__success-btn:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  @media (max-width: 480px) {
    #tlw-custom-{{ section.id }} .tlw-custom__form {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-custom-{{ section.id }}');
    if (!root) return;

    var toggle = root.querySelector('[data-custom-toggle]');
    var panel = root.querySelector('[data-custom-panel]');
    var form = root.querySelector('.tlw-custom__form');
    if (!panel) return;

    if (toggle) {
      function open() {
        panel.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = toggle.dataset.closeLabel;
        window.setTimeout(function () {
          if (!form) return;
          var y = form.getBoundingClientRect().top + window.scrollY - 120;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }, 520);
      }

      function shut() {
        panel.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.textContent = toggle.dataset.openLabel;
      }

      toggle.addEventListener('click', function () {
        if (panel.classList.contains('is-open')) shut(); else open();
      });

      /* After a submission Shopify reloads the page, so reopen the panel
         and show the visitor their confirmation rather than a closed form.
         In start-open mode the panel never closes, so nothing to do. */
      if (root.querySelector('.tlw-form__success') || root.querySelector('.tlw-form__error')) {
        panel.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = toggle.dataset.closeLabel;
      }
    }

    /* Multi-step accordion */
    var steps = Array.prototype.slice.call(root.querySelectorAll('[data-step]'));

    function openStep(step) {
      step.classList.add('is-open');
      var header = step.querySelector('[data-step-toggle]');
      if (header) header.setAttribute('aria-expanded', 'true');
    }

    function closeStep(step) {
      step.classList.remove('is-open');
      var header = step.querySelector('[data-step-toggle]');
      if (header) header.setAttribute('aria-expanded', 'false');
    }

    steps.forEach(function (step, i) {
      var header = step.querySelector('[data-step-toggle]');
      var next = step.querySelector('[data-step-next]');

      if (header) {
        header.addEventListener('click', function () {
          if (step.classList.contains('is-open')) closeStep(step); else openStep(step);
        });
      }

      if (next) {
        next.addEventListener('click', function () {
          closeStep(step);
          var nextStep = steps[i + 1];
          if (nextStep) {
            openStep(nextStep);
            window.setTimeout(function () {
              var y = nextStep.getBoundingClientRect().top + window.scrollY - 140;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }, 80);
          }
        });
      }
    });

    if (form) {
      form.addEventListener('submit', function (e) {
        var badStep = null;
        steps.forEach(function (step) {
          if (!badStep && step.querySelector(':invalid')) badStep = step;
        });
        if (badStep && !badStep.classList.contains('is-open')) {
          e.preventDefault();
          openStep(badStep);
          window.setTimeout(function () {
            var invalidField = badStep.querySelector(':invalid');
            if (invalidField) {
              var y = badStep.getBoundingClientRect().top + window.scrollY - 140;
              window.scrollTo({ top: y, behavior: 'smooth' });
              invalidField.focus();
            }
          }, 420);
        }
      });
    }
  })();
</script>

