    margin: 0 0 28px;
    padding: 16px 20px;
    border: 1px solid var(--tlw-accent);
    font-size: 15px;
  }

  #tlw-custom-{{ section.id }} .tlw-form__error {
    border-color: #a33;
    color: #a33;
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-custom-{{ section.id }}');
    if (!root) return;

    var toggle = root.querySelector('[data-custom-toggle]');
    var panel = root.querySelector('[data-custom-panel]');
    var form = root.querySelector('[data-custom-form]');
    if (!toggle || !panel) return;

    function open(scroll) {
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.textContent = toggle.dataset.closeLabel;

      if (scroll === false) return;
      window.setTimeout(function () {
        var y = form.getBoundingClientRect().top + window.scrollY - 120;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }, 720);
    }

    function shut() {
      panel.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = toggle.dataset.openLabel;
    }

    toggle.addEventListener('click', function () {
      if (panel.classList.contains('is-open')) shut(); else open();
    });

    /* --- the step by step form --- */
    var wizard = root.querySelector('[data-wizard]');
    if (wizard) {
      var steps = wizard.querySelectorAll('[data-step]');
      var segs = wizard.querySelectorAll('[data-step-seg]');
      var nowEl = wizard.querySelector('[data-step-now]');
      var backBtn = wizard.querySelector('[data-wizard-back]');
      var nextBtn = wizard.querySelector('[data-wizard-next]');
      var sendBtn = wizard.querySelector('[data-wizard-submit]');
      var warn = wizard.querySelector('[data-wizard-warn]');
      var at = 0;

      function show(i) {
        at = Math.max(0, Math.min(steps.length - 1, i));

        steps.forEach(function (s, n) { s.hidden = n !== at; });
        segs.forEach(function (s, n) { s.classList.toggle('is-on', n <= at); });

        if (nowEl) nowEl.textContent = at + 1;
        if (backBtn) backBtn.hidden = at === 0;
        if (nextBtn) nextBtn.hidden = at === steps.length - 1;
        if (sendBtn) sendBtn.hidden = at !== steps.length - 1;
        if (warn) warn.hidden = true;

        var y = wizard.getBoundingClientRect().top + window.scrollY - 120;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }

      /* Only checks the step you are on, so an empty later step does not
         block you from moving forward. */
      function stepOk() {
        var fields = steps[at].querySelectorAll('[data-required]');
        var ok = true;

        fields.forEach(function (f) {
          var filled = f.type === 'checkbox' ? f.checked : f.value.trim() !== '';
          f.classList.toggle('is-missing', !filled);
          if (!filled) ok = false;
        });

        return ok;
      }

      if (nextBtn) nextBtn.addEventListener('click', function () {
        if (!stepOk()) {
          if (warn) warn.hidden = false;
          return;
        }
        show(at + 1);
      });

      if (backBtn) backBtn.addEventListener('click', function () { show(at - 1); });

      if (sendBtn) sendBtn.addEventListener('click', function (e) {
        if (!stepOk()) {
          e.preventDefault();
          if (warn) warn.hidden = false;
        }
      });

      /* Each country carries its own example number, the way the live site does */
      wizard.querySelectorAll('[data-phone-code]').forEach(function (sel) {
        var input = sel.parentElement.querySelector('[data-phone-number]');
        function hint() {
          var opt = sel.options[sel.selectedIndex];
          var h = opt && opt.dataset.hint;
          if (input && h) input.placeholder = h;
        }
        sel.addEventListener('change', hint);
        hint();
      });

      wizard.addEventListener('input', function (e) {
        if (e.target.classList) e.target.classList.remove('is-missing');
      });
    }

    /* After a submission Shopify reloads the page, so reopen the panel and
       show the visitor their confirmation rather than a closed form. */
    if (root.querySelector('.tlw-form__success') || root.querySelector('.tlw-form__error')) {
      open(false);
    }
  })();
</script>

