{% comment %}
  THELACEDWÁY custom wigs
  Home of Amare Studio

  Replaces the earlier multi-step wizard with Shopify's plain native contact
  form (Name, Email, Phone, Message) — no custom fields, no JS steps, no app.
  Submissions arrive as an email at whatever address is set under
  Settings > Notifications > Contact form, tagged "Custom Wig Enquiry" in the
  hidden field below so they're easy to tell apart from any other contact
  form on the site.

  Two modes, picked by the "Show the form open by default" setting:
  - Off (default): the homepage teaser. The form expands in place when
    clicked.
  - On: for a dedicated page (e.g. /custom-wig-enquiry). No toggle button,
    the form is open on load, and the heading renders as an <h1>.
{% endcomment %}

{%- liquid
  assign heading_tag = 'h2'
  if section.settings.start_open
    assign heading_tag = 'h1'
  endif
  assign form_id = 'CustomWigForm-' | append: section.id
-%}

<section class="tlw-custom" id="tlw-custom-{{ section.id }}">
  <div class="tlw-custom__head{% unless section.settings.start_open %} tlw-custom__head--center{% endunless %}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tlw-custom__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <{{ heading_tag }} class="tlw-custom__title">
      {{ section.settings.heading_before }}
      {% if section.settings.heading_accent != blank -%}
        <em class="tlw-accent-word">{{ section.settings.heading_accent }}</em>
      {%- endif %}
      {{ section.settings.heading_after }}
    </{{ heading_tag }}>

    <div class="tlw-custom__rule"></div>

    {%- if section.settings.body != blank -%}
      <p class="tlw-custom__text">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- assign extra_lines = section.settings.extra_paragraphs | newline_to_br | strip_newlines | split: '<br />' -%}
    {%- for line in extra_lines -%}
      {%- assign clean_line = line | strip -%}
      {%- if clean_line != blank -%}
        <p class="tlw-custom__text">{{ clean_line }}</p>
      {%- endif -%}
    {%- endfor -%}

    {%- unless section.settings.start_open -%}
      <button
        type="button"
        class="tlw-custom__toggle"
        data-custom-toggle
        aria-expanded="false"
        aria-controls="tlw-custom-panel-{{ section.id }}"
        data-open-label="{{ section.settings.open_label | escape }}"
        data-close-label="{{ section.settings.close_label | escape }}"
      >
        {{ section.settings.open_label }}
      </button>
    {%- endunless -%}
  </div>

  <div
    class="tlw-custom__panel{% if section.settings.start_open %} is-open{% endif %}"
    id="tlw-custom-panel-{{ section.id }}"
    data-custom-panel
  >
    <div class="tlw-custom__form-wrap">
      <div class="tlw-custom__card{% unless section.settings.start_open %} tlw-custom__card--center{% endunless %}">
        {%- if section.settings.form_eyebrow != blank -%}
          <p class="tlw-custom__form-eyebrow">{{ section.settings.form_eyebrow }}</p>
        {%- endif -%}

        {%- form 'contact', id: form_id, class: 'tlw-custom__form' -%}

          {%- if form.posted_successfully? -%}
            <p class="tlw-form__success">{{ section.settings.success_text }}</p>
            {%- if section.settings.success_button_label != blank and section.settings.success_button_link != blank -%}
              <a href="{{ section.settings.success_button_link }}" class="tlw-custom__success-btn">
                {{ section.settings.success_button_label }}
              </a>
            {%- endif -%}
          {%- endif -%}

          {%- if form.errors -%}
            <p class="tlw-form__error">{{ form.errors | default_errors }}</p>
          {%- endif -%}

          <input type="hidden" name="contact[enquiry_type]" value="Custom Wig Enquiry">

          <div class="tlw-custom__field">
            <label for="{{ form_id }}-name">Full name</label>
            <input
              type="text"
              id="{{ form_id }}-name"
              name="contact[name]"
              value="{{ form.name }}"
              placeholder="Your full name"
              autocomplete="name"
              required
            >
          </div>

          <div class="tlw-custom__field">
            <label for="{{ form_id }}-email">Email address</label>
            <input
              type="email"
              id="{{ form_id }}-email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="you@email.com"
              autocomplete="email"
              required
            >
          </div>

          {%- if section.settings.show_phone -%}
            <div class="tlw-custom__field">
              <label for="{{ form_id }}-phone">Contact number</label>
              <input
                type="tel"
                id="{{ form_id }}-phone"
                name="contact[phone]"
                value="{{ form.phone }}"
                placeholder="Optional"
                autocomplete="tel"
              >
            </div>
          {%- endif -%}

          <div class="tlw-custom__field tlw-custom__field--wide">
            <label for="{{ form_id }}-body">{{ section.settings.message_label }}</label>
            <textarea
              id="{{ form_id }}-body"
              name="contact[body]"
              rows="5"
              placeholder="Describe the look you have in mind"
              required
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="tlw-custom__submit">{{ section.settings.submit_label }}</button>

        {%- endform -%}
      </div>
    </div>
  </div>

</section>

<style>
  #tlw-custom-{{ section.id }} {
    padding-block: 72px;
    background: var(--tlw-surface-lowest);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head {
    max-width: 640px;
    margin: 0;
    padding-inline: var(--tlw-margin);
    text-align: left;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head--center {
    margin-inline: auto;
    text-align: center;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__head--center .tlw-custom__rule {
    margin-inline: auto;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__rule {
    margin: 24px 0 0;
    height: 1px;
    width: 80px;
    background: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__eyebrow {
    font-family: var(--tlw-font-body);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-accent);
    margin: 0 0 16px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__title {
    font-family: var(--tlw-font-display);
    font-size: 32px;
    font-weight: 300;
    color: var(--tlw-primary);
    margin: 0;
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-custom__title {
      font-size: 44px;
    }
  }

  #tlw-custom-{{ section.id }} .tlw-custom__text {
    margin: 20px 0 0;
    color: var(--tlw-on-surface-variant);
    line-height: 1.6;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__toggle {
    margin-top: 32px;
    display: inline-block;
    border: 1px solid var(--tlw-accent);
    border-radius: 0;
    padding: 14px 36px;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    background: transparent;
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__toggle:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 500ms cubic-bezier(0.4, 0, 0.2, 1), opacity 400ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__panel > .tlw-custom__form-wrap {
    overflow: hidden;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__card {
    max-width: 640px;
    margin: 48px 0 0;
    margin-inline: var(--tlw-margin);
    padding: 32px;
    border: 1px solid var(--tlw-outline-variant);
    border-radius: 28px;
    background: var(--tlw-surface-lowest);
  }

  @media (min-width: 768px) {
    #tlw-custom-{{ section.id }} .tlw-custom__card {
      padding: 48px;
    }

    #tlw-custom-{{ section.id }} .tlw-custom__card--center {
      margin-inline: auto;
    }
  }

  #tlw-custom-{{ section.id }} .tlw-custom__form-eyebrow {
    margin: 0 0 32px;
    font-family: var(--tlw-font-body);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field--wide {
    grid-column: 1 / -1;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field label {
    font-family: var(--tlw-font-body);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tlw-on-surface-variant);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field input,
  #tlw-custom-{{ section.id }} .tlw-custom__field textarea {
    border: 1px solid var(--tlw-outline-variant);
    background: var(--tlw-surface-container-low);
    padding: 14px 16px;
    font-family: var(--tlw-font-body);
    font-size: 15px;
    color: var(--tlw-primary);
    resize: vertical;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field input::placeholder,
  #tlw-custom-{{ section.id }} .tlw-custom__field textarea::placeholder {
    color: var(--tlw-outline);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__field input:focus,
  #tlw-custom-{{ section.id }} .tlw-custom__field textarea:focus {
    outline: none;
    border-color: var(--tlw-accent);
  }

  #tlw-custom-{{ section.id }} .tlw-custom__submit {
    grid-column: 1 / -1;
    margin-top: 8px;
    padding: 16px 40px;
    border: 1px solid var(--tlw-accent);
    border-radius: 0;
    background: transparent;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__submit:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  #tlw-custom-{{ section.id }} .tlw-form__success,
  #tlw-custom-{{ section.id }} .tlw-form__error {
    grid-column: 1 / -1;
    padding: 16px;
    border: 1px solid var(--tlw-outline-variant);
    font-size: 15px;
  }

  #tlw-custom-{{ section.id }} .tlw-form__error {
    border-color: #a33;
    color: #a33;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__success-btn {
    grid-column: 1 / -1;
    display: inline-block;
    width: fit-content;
    margin: -8px auto 0;
    padding: 14px 32px;
    border: 1px solid var(--tlw-accent);
    border-radius: 0;
    font-family: var(--tlw-font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tlw-primary);
    transition: background-color 250ms ease, color 250ms ease;
  }

  #tlw-custom-{{ section.id }} .tlw-custom__success-btn:hover {
    background: var(--tlw-accent);
    color: var(--tlw-on-primary);
  }

  @media (max-width: 480px) {
    #tlw-custom-{{ section.id }} .tlw-custom__form {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('tlw-custom-{{ section.id }}');
    if (!root) return;

    var toggle = root.querySelector('[data-custom-toggle]');
    var panel = root.querySelector('[data-custom-panel]');
    var form = root.querySelector('.tlw-custom__form');
    if (!panel) return;

    if (toggle) {
      function open() {
        panel.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = toggle.dataset.closeLabel;
        window.setTimeout(function () {
          if (!form) return;
          var y = form.getBoundingClientRect().top + window.scrollY - 120;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }, 520);
      }

      function shut() {
        panel.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.textContent = toggle.dataset.openLabel;
      }

      toggle.addEventListener('click', function () {
        if (panel.classList.contains('is-open')) shut(); else open();
      });

      /* After a submission Shopify reloads the page, so reopen the panel
         and show the visitor their confirmation rather than a closed form.
         In start-open mode the panel never closes, so nothing to do. */
      if (root.querySelector('.tlw-form__success') || root.querySelector('.tlw-form__error')) {
        panel.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.textContent = toggle.dataset.closeLabel;
      }
    }
  })();
</script>

{% schema %}
{
  "name": "TLW Custom Wigs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading"
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading, first part",
      "default": "Create your"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, gold italic words",
      "default": "custom wig"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading, last part"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Paragraph",
      "default": "Can't find exactly what you're looking for? Our Custom Wig service allows you to create a unit tailored to your individual preferences."
    },
    {
      "type": "textarea",
      "id": "extra_paragraphs",
      "label": "Extra paragraphs",
      "info": "Optional. One per line, each becomes its own paragraph after the one above."
    },
    {
      "type": "header",
      "content": "Standalone page"
    },
    {
      "type": "checkbox",
      "id": "start_open",
      "label": "Show the form open by default",
      "info": "Turn on when this section is the whole page (e.g. /custom-wig-enquiry) rather than a homepage teaser. Hides the toggle button and uses an H1 for the heading.",
      "default": false
    },
    {
      "type": "text",
      "id": "success_button_label",
      "label": "Button after a successful submission",
      "info": "Optional. Leave blank for none.",
      "default": "Back to home"
    },
    {
      "type": "text",
      "id": "success_button_link",
      "label": "Where that button goes",
      "default": "/"
    },
    {
      "type": "header",
      "content": "Teaser button"
    },
    {
      "type": "text",
      "id": "open_label",
      "label": "Button text, closed",
      "default": "Start your enquiry"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Button text, open",
      "default": "Close enquiry"
    },
    {
      "type": "header",
      "content": "The form"
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Small gold label above the form",
      "default": "Details"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Include a phone number field",
      "default": true
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message field label",
      "default": "Tell us what you have in mind"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button text",
      "default": "Send enquiry"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Message after a successful submission",
      "default": "Thank you — we've received your enquiry and will be in touch soon."
    }
  ],
  "presets": [
    {
      "name": "TLW Custom Wigs"
    },
    {
      "name": "TLW Custom Wigs — Standalone Page",
      "settings": {
        "heading_before": "Create Your Custom Wig",
        "heading_accent": "",
        "body": "Can't find exactly what you're looking for?",
        "extra_paragraphs": "Our Custom Wig service allows you to create a unit tailored to your individual preferences. Whether you have a specific colour, length, lace size or style in mind, complete the form below and tell us your vision.\nOnce your enquiry has been reviewed, we'll be in touch with a personalised quote.",
        "start_open": true,
        "success_button_label": "Back to home",
        "success_button_link": "/"
      }
    }
  ]
}
{% endschema %}
