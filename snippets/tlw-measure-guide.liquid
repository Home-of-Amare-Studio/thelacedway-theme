{% comment %}
  THELACEDWÁY cap size guide: "How to measure your cap size" link that opens a slide-in panel.
  Home of Amare Studio

  Param: id (any unique string)

  All wording, the size table and the photo are edited in the theme editor:
  Theme settings -> THELACEDWÁY guides -> Measure your cap size pop-up.
{% endcomment %}

{%- liquid
  assign m_title = settings.tlw_measure_title | default: 'How to measure your cap size'
  assign m_table_title = settings.tlw_measure_table_title | default: 'Cap size guide'
  assign m_caption = settings.tlw_measure_image_caption | default: 'Wrap the tape around your natural hairline, not too tight and not too loose.'
  assign m_intro = settings.tlw_measure_intro
  if m_intro == blank
    assign m_intro = '<p>Use a soft measuring tape and wrap it around your head from hairline to nape, following your natural hairline. Measure in inches for the most accurate fit.</p>'
  endif
  assign m_image = settings.tlw_measure_image
  assign m_video = settings.tlw_measure_video | strip
-%}

{%- assign m_steps = settings.tlw_measure_steps -%}
{%- if m_steps == blank -%}
  {%- capture m_steps -%}
Start at the front hairline in the centre of your forehead.
Wrap the tape behind each ear, keeping it level.
Bring the tape around the nape of your neck.
Return to the starting point at the front hairline.
  {%- endcapture -%}
{%- endif -%}

{%- assign m_table = settings.tlw_measure_table -%}
{%- if m_table == blank -%}
  {%- capture m_table -%}
Small | 20.5" — 21.5"
Medium | 21.5" — 22.5"
Large | 22.5" — 23.5"
  {%- endcapture -%}
{%- endif -%}

{%- assign step_lines = m_steps | newline_to_br | split: '<br />' -%}
{%- assign table_lines = m_table | newline_to_br | split: '<br />' -%}

{%- capture guide_trigger -%}
  <button type="button" class="tlw-guide-link" data-tlw-guide-open="{{ id }}" aria-haspopup="dialog">How to measure your cap size</button>
{%- endcapture -%}

{%- capture guide_body -%}
  <h3 class="tlw-guide__h3">{{ m_table_title | escape }}</h3>
  <div class="tlw-guide__table-wrap">
    <table class="tlw-guide__table">
      <thead>
        <tr><th>Size</th><th>Measurement</th></tr>
      </thead>
      <tbody>
        {%- for line in table_lines -%}
          {%- assign row = line | strip -%}
          {%- if row == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign cells = row | split: '|' -%}
          {%- assign cell_size = cells[0] | strip -%}
          {%- assign cell_measure = cells[1] | strip -%}
          <tr><td>{{ cell_size | escape }}</td><td>{{ cell_measure | escape }}</td></tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  <div class="tlw-guide__rich">{{ m_intro }}</div>

  <div class="tlw-guide__cards">
    {%- assign step_number = 0 -%}
    {%- for line in step_lines -%}
      {%- assign step_text = line | strip -%}
      {%- if step_text == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- assign step_number = step_number | plus: 1 -%}
      <div class="tlw-guide__card tlw-guide__card--step">
        <span class="tlw-guide__eyebrow">Step {{ step_number }}</span>
        <p>{{ step_text | escape }}</p>
      </div>
    {%- endfor -%}
  </div>

  {%- if m_video contains 'https://' or m_image != blank -%}
    <figure class="tlw-guide__figure">
      {%- if m_video contains 'https://' -%}
        <video class="tlw-guide__img" controls playsinline preload="metadata" src="{{ m_video | escape }}"{% if m_image != blank %} poster="{{ m_image | image_url: width: 900 }}"{% endif %}></video>
      {%- else -%}
        {{ m_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'tlw-guide__img', alt: 'Measuring head circumference with a soft tape around the hairline' }}
      {%- endif -%}
      {%- if m_caption != blank -%}
        <figcaption class="tlw-guide__caption">{{ m_caption | escape }}</figcaption>
      {%- endif -%}
    </figure>
  {%- endif -%}
{%- endcapture -%}

{%- render 'tlw-guide-shell', id: id, title: m_title, trigger: guide_trigger, body: guide_body -%}
